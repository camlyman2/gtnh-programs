3},{13,43},{12,63},{14,43},{10,63},{7,11},{8,10}},wr=0,w={}},hidden={{x=38,y=3,f="HiddenItems",item=80},{x=10,y=1,f="HiddenItems",item=82}}}return {id=37,const="REDS_HOUSE_1F",w=4,h=4,ts=1,border=10,conns={},warps={{2,7,255,1},{3,7,255,1},{7,1,38,1}},signs={{x=3,y=1,t={k="text",p={"There's a movie on TV. Four boys are walking on railroad tracks.","I better go too."},s=1}}},objs={{x=5,y=4,s=51,m="STAY",d="LEFT",t={k="text",p={"MOM: Right. All boys leave home some day. It said so on TV.","PROF.OAK, next door, is looking for you."},s=1}}},wild=nil,hidden={}}return {id=38,const="REDS_HOUSE_2F",w=4,h=4,ts=4,border=10,conns={},warps={{7,1,37,3}},signs={},objs={},wild=nil,hidden={{x=0,y=1,f="OpenRedsPC"},{x=3,y=5,f="PrintRedSNESText"}}}return {id=39,const="BLUES_HOUSE",w=4,h=4,ts=8,border=10,conns={},warps={{2,7,255,2},{3,7,255,2}},signs={},objs={{x=2,y=3,s=17,m="STAY",d="RIGHT",t={k="text",p={"Hi RED! BLUE is out at Grandpa's lab."},s=1},story=1},{x=6,y=4,s=17,m="WALK",d="UP_DOWN",t={k="text",p={"POKÃ©MON are living things! If they get tired, give them a rest!"}},hide=1},{x=3,y=3,s=65,m="STAY",d="NONE",t={k="text",p={"It's a big map! This is useful!"}},story=1}},wild=nil,hidden={{x=0,y=1,f="PrintBookcaseText"},{x=1,y=1,f="PrintBookcaseText"},{x=7,y=1,f="PrintBookcaseText"}}}return {id=4,const="LAVENDER_TOWN",w=10,h=9,ts=0,border=44,conns={{"north",21,0},{"south",23,0},{"west",19,0}},warps={{3,5,141,1},{14,5,142,1},{7,9,149,1},{15,13,150,1},{3,13,151,1},{7,13,229,1}},signs={{x=11,y=9,t={k="text",p={"LAVENDER TOWN The Noble Purple Town"}}},{x=9,y=3,t={k="text",p={"New SILPH SCOPE!","Make the Invisible Plain to See!","SILPH CO."}}},{x=16,y=13,t={k="none"}},{x=4,y=5,t={k="none"}},{x=5,y=9,t={k="text",p={"LAVENDER VOLUNTEER POKÃ©MON HOUSE"}}},{x=17,y=7,t={k="text",p={"May the Souls of POKÃ©MON Rest Easy POKÃ©MON TOWER"}}}},objs={{x=15,y=9,s=8,m="WALK",d="ANY_DIR",t={k="text",p={"Do you believe in GHOSTs?"},s=1}},{x=9,y=10,s=7,m="STAY",d="NONE",t={k="text",p={"This town is known as the grave site of POKÃ©MON.","Memorial services are held in POKÃ©MON TOWER."}}},{x=8,y=7,s=12,m="WALK",d="LEFT_RIGHT",t={k="text",p={"GHOSTs appeared in POKÃ©MON TOWER.","I think they're the spirits of POKÃ©MON that the ROCKETs killed."}}}},wild=nil,hidden={}}return {id=40,const="OAKS_LAB",w=5,h=6,ts=5,border=3,conns={},warps={{4,11,255,3},{5,11,255,3}},signs={},objs={{x=4,y=3,s=2,m="STAY",d="NONE",opp={25,1},t={k="text",p={"BLUE: Yo RED! Gramps isn't around!"},s=1},story=1},{x=6,y=3,s=61,m="STAY",d="NONE",story=1},{x=7,y=3,s=61,m="STAY",d="NONE",story=1},{x=8,y=3,s=61,m="STAY",d="NONE",story=1},{x=5,y=2,s=3,m="STAY",d="DOWN",t={k="text",p={"OAK: Now, RED, which POKÃ©MON do you want?"},s=1},hide=1},{x=2,y=1,s=65,m="STAY",d="NONE",t={k="text",p={"It's encyclopedia- like, but the pages are blank!"},s=1},story=1},{x=3,y=1,s=65,m="STAY",d="NONE",t={k="text",p={"It's encyclopedia- like, but the pages are blank!"},s=1},story=1},{x=5,y=10,s=3,m="STAY",d="UP",t={k="text",p={"?"}},hide=1},{x=1,y=9,s=13,m="WALK",d="UP_DOWN",t={k="text",p={"PROF.OAK is the authority on POKÃ©MON!","Many POKÃ©MON trainers hold him in high regard!"},s=1}},{x=2,y=10,s=32,m="STAY",d="NONE",t={k="text",p={"I study POKÃ©MON as PROF.OAK's AIDE."},s=1}},{x=8,y=10,s=32,m="STAY",d="NONE",t={k="text",p={"I study POKÃ©MON as PROF.OAK's AIDE."},s=1}}},wild=nil,hidden={{x=4,y=0,f="DisplayOakLabLeftPoster"},{x=5,y=0,f="DisplayOakLabRightPoster"},{x=0,y=1,f="DisplayOakLabEmailText"},{x=1,y=1,f="DisplayOakLabEmailText"}}}return {id=41,const="VIRIDIAN_POKECENTER",w=7,h=4,ts=6,border=0,conns={},warps={{3,7,255,1},{4,7,255,1}},signs={},objs={{x=3,y=1,s=41,m="STAY",d="DOWN",t={k="nurse"}},{x=10,y=5,s=16,m="WALK",d="UP_DOWN",t={k="text",p={"You can use that PC in the corner.","The receptionist told me. So kind!"}}},{x=4,y=3,s=7,m="STAY",d="NONE",t={k="text",p={"There's a POKÃ©MON CENTER in every town ahead.","They don't charge any money either!"}}},{x=11,y=2,s=42,m="STAY",d="DOWN",t={k="cable"}}},wild=nil,hidden={{x=0,y=4,f="PrintBenchGuyText"},{x=13,y=3,f="OpenPokemonCenterPC"}}}return {id=42,const="VIRIDIAN_MART",w=4,h=4,ts=2,border=0,conns={},warps={{3,7,255,2},{4,7,255,2}},signs={},objs={{x=0,y=5,s=38,m="STAY",d="RIGHT",t={k="mart",items={4,11,15,12}}},{x=5,y=5,s=4,m="WALK",d="UP_DOWN",t={k="text",p={"This shop sells many ANTIDOTEs."}}},{x=3,y=3,s=7,m="STAY",d="NONE",t={k="text",p={"No! POTIONs are all sold out."}}}},wild=nil,hidden={}}return {id=43,const="VIRIDIAN_SCHOOL_HOUSE",w=4,h=4,ts=8,border=10,conns={},warps={{2,7,255,3},{3,7,255,3}},signs={},objs={{x=3,y=5,s=29,m="STAY",d="UP",t={k="text",p={"Whew! I'm trying to memorize all my notes."}}},{x=4,y=1,s=6,m="STAY",d="DOWN",t={k="text",p={"Okay!","Be sure to read the blackboard carefully!"}}}},wild=nil,hidden={{x=3,y=4,f="PrintNotebookText"},{x=3,y=0,f="PrintBlackboardLinkCableText"}}}return {id=44,const="VIRIDIAN_NICKNAME_HOUSE",w=4,h=4,ts=8,border=10,conns={},warps={{2,7,255,4},{3,7,255,4}},signs={},objs={{x=5,y=3,s=52,m="STAY",d="NONE",t={k="text",p={"Coming up with nicknames is fun, but hard.","Simple names are the easiest to remember."}}},{x=1,y=4,s=8,m="WALK",d="UP_DOWN",t={k="text",p={"My Daddy loves POKÃ©MON too."}}},{x=5,y=5,s=9,m="WALK",d="LEFT_RIGHT",t={k="text",p={"SPEARY: Tetweet!"},s=1}},{x=4,y=0,s=66,m="STAY",d="NONE",t={k="text",p={"SPEAROW Name: SPEARY"}}}},wild=nil,hidden={}}return {id=45,const="VIRIDIAN_GYM",w=10,h=9,ts=7,border=3,conns={},warps={{16,17,255,5},{17,17,255,5}},signs={},objs={{x=2,y=1,s=23,m="STAY",d="DOWN",opp={29,3},t={k="text",p={"Fwahahaha! This is my hideout!","I planned to resurrect TEAM ROCKET here!","But, you have caught me again! So be it! This time, I'm not holding back!","Once more, you shall face GIOVANNI, the greatest trainer!"},s=1},story=1},{x=12,y=7,s=7,m="STAY",d="DOWN",opp={31,9},t={k="trainer",range=4,b={"Heh! You must be running out of steam by now!"},e={"I ran out of gas!"},a={"You need power to keep up with our GYM LEADER!"}}},{x=11,y=11,s=14,m="STAY",d="UP",opp={24,6},t={k="trainer",range=4,b={"Rrrroar! I'm working myself into a rage!"},e={"Wargh!"},a={"I'm still not worthy!"}}},{x=10,y=7,s=33,m="STAY",d="DOWN",opp={22,3},t={k="trainer",range=4,b={"POKÃ©MON and I, we make wonderful music together!"},e={"You are in perfect harmony!"},a={"Do you know the identity of our GYM LEADER?"}}},{x=3,y=7,s=14,m="STAY",d="LEFT",opp={24,7},t={k="trainer",range=2,b={"Karate is the ultimate form of martial arts!"},e={"Atcho!"},a={"If my POKÃ©MON were as good at Karate as I..."}}},{x=13,y=5,s=7,m="STAY",d="RIGHT",opp={31,10},t={k="trainer",range=3,b={"The truly talented win with style!"},e={"I lost my grip!"},a={"The LEADER will scold me!"}}},{x=10,y=1,s=14,m="STAY",d="DOWN",opp={24,8},t={k="trainer",range=4,b={"I'm the KARATE KING! Your fate rests with me!"},e={"Ayah!"},a={"POKÃ©MON LEAGUE? You? Don't get cocky!"}}},{x=2,y=16,s=33,m="STAY",d="RIGHT",opp={22,4},t={k="trainer",range=3,b={"Your POKÃ©MON will cower at the crack of my whip!"},e={"Yowch! Whiplash!"},a={"Wait! I was just careless!"}}},{x=6,y=5,s=7,m="STAY",d="DOWN",opp={31,1},t={k="trainer",range=4,b={"VIRIDIAN GYM was closed for a long time, but now our LEADER is back!"},e={"I was beaten?"},a={"You can go onto POKÃ©MON LEAGUE only by defeating our GYM LEADER!"}}},{x=16,y=15,s=36,m="STAY",d="DOWN",t={k="text",p={"Yo! Champ in making!","Even I don't know VIRIDIAN LEADER's identity!","This will be the toughest of all the GYM LEADERs!","I heard that the trainers here like ground-type POKÃ©MON!"},s=1}},{x=16,y=9,s=61,m="STAY",d="NONE",item=53,story=1}},wild=nil,hidden={{x=15,y=15,f="GymStatues"},{x=18,y=15,f="GymStatues"}}}return {id=46,const="DIGLETTS_CAVE_ROUTE_2",w=4,h=4,ts=17,border=125,conns={},warps={{2,7,255,1},{3,7,255,1},{4,4,197,1}},signs={},objs={{x=3,y=3,s=39,m="STAY",d="NONE",t={k="text",p={"I went to ROCK TUNNEL, but it's dark and scary.","If a POKÃ©MON's FLASH could light it up..."}}}},wild=nil,hidden={}}return {id=47,const="VIRIDIAN_FOREST_NORTH_GATE",w=5,h=4,ts=9,border=10,conns={},warps={{4,0,255,2},{5,0,255,2},{4,7,51,1},{5,7,51,1}},signs={},objs={{x=3,y=2,s=12,m="STAY",d="NONE",t={k="text",p={"Many POKÃ©MON live only in forests and caves.","You need to look everywhere to get different kinds!"}}},{x=2,y=5,s=37,m="STAY",d="NONE",t={k="text",p={"Have you noticed the bushes on the roadside?","They can be cut down by a special POKÃ©MON move."}}}},wild=nil,hidden={}}return {id=48,const="ROUTE_2_TRADE_HOUSE",w=4,h=4,ts=8,border=10,conns={},warps={{2,7,255,3},{3,7,255,3}},signs={},objs={{x=2,y=4,s=32,m="STAY",d="RIGHT",t={k="text",p={"A fainted POKÃ©MON can't fight. But, it can still use moves like CUT!"}}},{x=4,y=1,s=55,m="STAY",d="DOWN",t={k="trade",nick="MARCEL"}}},wild=nil,hidden={}}return {id=49,const="ROUTE_2_GATE",w=5,h=4,ts=12,border=10,conns={},warps={{4,0,255,4},{5,0,255,4},{4,7,255,5},{5,7,255,5}},signs={},objs={{x=1,y=4,s=32,m="STAY",d="LEFT",t={k="text",p={"The HM FLASH lights even the darkest dungeons."},s=1}},{x=5,y=4,s=4,m="WALK",d="LEFT_RIGHT",t={k="text",p={"Once a POKÃ©MON learns FLASH, you can get through ROCK TUNNEL."}}}},wild=nil,hidden={}}return {id=5,const="VERMILION_CITY",w=20,h=18,ts=0,border=67,conns={{"north",17,5},{"east",22,4}},warps={{11,3,89,1},{9,13,90,1},{23,13,91,1},{12,19,92,1},{23,19,93,1},{18,31,94,1},{19,31,94,1},{15,13,196,1},{7,3,163,1}},signs={{x=27,y=3,t={k="text",p={"VERMILION CITY The Port of Exquisite Sunsets"}}},{x=37,y=13,t={k="text",p={"NOTICE!","ROUTE 12 may be blocked off by a sleeping POKÃ©MON.","Detour through ROCK TUNNEL to LAVENDER TOWN.","VERMILION POLICE"}}},{x=24,y=13,t={k="none"}},{x=12,y=3,t={k="none"}},{x=7,y=13,t={k="text",p={"POKÃ©MON FAN CLUB All POKÃ©MON fans welcome!"}}},{x=7,y=19,t={k="text",p={"VERMILION CITY POKÃ©MON GYM LEADER: LT.SURGE","The Lightning American!"}}},{x=29,y=15,t={k="text",p={"VERMILION HARBOR"}}}},objs={{x=19,y=7,s=15,m="WALK",d="LEFT_RIGHT",t={k="text",p={"We're careful about pollution!","We've heard GRIMER multiplies in toxic sludge!"}}},{x=14,y=6,s=11,m="STAY",d="NONE",t={k="text",p={"Did you see S.S. ANNE moored in the harbor?"},s=1}},{x=19,y=30,s=19,m="STAY",d="UP",t={k="text",p={"Welcome to S.S. ANNE!"},s=1}},{x=30,y=7,s=11,m="STAY",d="NONE",t={k="text",p={"I'm putting up a building on this plot of land.","My POKÃ©MON is tamping the land."}}},{x=29,y=9,s=5,m="WALK",d="UP_DOWN",t={k="text",p={"MACHOP: Guoh! Gogogoh!"}}},{x=25,y=27,s=19,m="WALK",d="LEFT_RIGHT",t={k="text",p={"S.S.ANNE is a famous luxury cruise ship.","We visit VERMILION once a year."}}}},wild=nil,hidden={{x=14,y=11,f="HiddenItems",item=81}}}return {id=50,const="VIRIDIAN_FOREST_SOUTH_GATE",w=5,h=4,ts=9,border=10,conns={},warps={{4,0,51,4},{5,0,51,5},{4,7,255,6},{5,7,255,6}},signs={},objs={{x=8,y=4,s=13,m="STAY",d="LEFT",t={k="text",p={"Are you going to VIRIDIAN FOREST? Be careful, it's a natural maze!"}}},{x=2,y=4,s=8,m="WALK",d="UP_DOWN",t={k="text",p={"RATTATA may be small, but its bite is wicked! Did you get one?"}}}},wild=nil,hidden={}}return {id=51,const="VIRIDIAN_FOREST",w=17,h=24,ts=3,border=3,conns={},warps={{1,0,47,3},{2,0,47,4},{15,47,50,2},{16,47,50,2},{17,47,50,2},{18,47,50,2}},signs={{x=24,y=40,t={k="text",p={"TRAINER TIPS","If you want to avoid battles, stay away from grassy areas!"}}},{x=16,y=32,t={k="text",p={"For poison, use ANTIDOTE! Get it at POKÃ©MON MARTs!"}}},{x=26,y=17,t={k="text",p={"TRAINER TIPS","Contact PROF.OAK via PC to get your POKÃ©DEX evaluated!"}}},{x=4,y=24,t={k="text",p={"TRAINER TIPS","No stealing of POKÃ©MON from other trainers! Catch only wild POKÃ©MON!"}}},{x=18,y=45,t={k="text",p={"TRAINER TIPS","Weaken POKÃ©MON before attempting capture!","When healthy, they may escape!"}}},{x=2,y=1,t={k="text",p={"LEAVING VIRIDIAN FOREST PEWTER CITY AHEAD"}}}},objs={{x=16,y=43,s=4,m="STAY",d="NONE",t={k="text",p={"I came here with some friends!","They're out for POKÃ©MON fights!"}}},{x=30,y=33,s=4,m="STAY",d="LEFT",opp={2,1},t={k="trainer",range=4,b={"Hey! You have POKÃ©MON! Come on! Let's battle'em!"},e={"No! CATERPIE can't cut it!"},a={"Ssh! You'll scare the bugs away!"}}},{x=30,y=19,s=4,m="STAY",d="LEFT",opp={2,2},t={k="trainer",range=4,b={"Yo! You can't jam out if you're a POKÃ©MON trainer!"},e={"Huh? I ran out of POKÃ©MON!"},a={"Darn! I'm going to catch some stronger ones!"}}},{x=2,y=18,s=4,m="STAY",d="LEFT",opp={2,3},t={k="trainer",range=1,b={"Hey, wait up! What's the hurry?"},e={"I give! You're good at this!"},a={"Sometimes, you can find stuff on the ground!","I'm looking for the stuff I dropped!"}}},{x=25,y=11,s=61,m="STAY",d="NONE",item=11,story=1},{x=12,y=29,s=61,m="STAY",d="NONE",item=20,story=1},{x=1,y=31,s=61,m="STAY",d="NONE",item=4,story=1},{x=27,y=40,s=4,m="STAY",d="NONE",t={k="text",p={"I ran out of POKÃ© BALLs to catch POKÃ©MON with!","You should carry extras!"}}}},wild={gr=8,g={{4,13},{5,14},{3,13},{5,13},{4,14},{6,14},{4,11},{3,10},{3,25},{5,25}},wr=0,w={}},hidden={{x=1,y=18,f="HiddenItems",item=20},{x=16,y=42,f="HiddenItems",item=11}}}return {id=52,const="MUSEUM_1F",w=10,h=4,ts=10,border=10,conns={},warps={{10,7,255,1},{11,7,255,1},{16,7,255,2},{17,7,255,2},{7,7,53,1}},signs={},objs={{x=12,y=4,s=32,m="STAY",d="LEFT",t={k="text",p={"Come again!"},s=1}},{x=1,y=4,s=11,m="STAY",d="NONE",t={k="text",p={"That is one magnificent fossil!"},s=1}},{x=15,y=2,s=32,m="STAY",d="DOWN",t={k="text",p={"Ssh! I think that this chunk of AMBER contains POKÃ©MON DNA!","It would be great if POKÃ©MON could be resurrected from it!","But, my colleagues just ignore me!","So I have a favor to ask!","Take this to a POKÃ©MON LAB and get it examined!"},s=1}},{x=17,y=4,s=32,m="STAY",d="NONE",t={k="text",p={"We are proud of 2 fossils of very rare, prehistoric POKÃ©MON!"},s=1}},{x=16,y=2,s=69,m="STAY",d="NONE",t={k="text",p={"The AMBER is clear and gold!"},s=1},story=1}},wild=nil,hidden={{x=2,y=3,f="AerodactylFossil"},{x=2,y=6,f="KabutopsFossil"}}}return {id=53,const="MUSEUM_2F",w=7,h=4,ts=10,border=10,conns={},warps={{7,7,52,5}},signs={{x=11,y=2,t={k="text",p={"SPACE SHUTTLE COLUMBIA"}}},{x=2,y=5,t={k="text",p={"Meteorite that fell on MT.MOON. (MOON STONE?)"}}}},objs={{x=1,y=7,s=4,m="WALK",d="LEFT_RIGHT",t={k="text",p={"MOON STONE?","What's so special about it?"}}},{x=0,y=5,s=37,m="STAY",d="DOWN",t={k="text",p={"July 20, 1969!","The 1st lunar landing!","I bought a color TV to watch it!"}}},{x=7,y=5,s=32,m="STAY",d="DOWN",t={k="text",p={"We have a space exhibit now."}}},{x=11,y=5,s=29,m="STAY",d="NONE",t={k="text",p={"I want a PIKACHU! It's so cute!","I asked my Daddy to catch me one!"}}},{x=12,y=5,s=14,m="STAY",d="DOWN",t={k="text",p={"Yeah, a PIKACHU soon, I promise!"}}}},wild=nil,hidden={}}return {id=54,const="PEWTER_GYM",w=5,h=7,ts=7,border=3,conns={},warps={{4,13,255,3},{5,13,255,3}},signs={},objs={{x=4,y=1,s=12,m="STAY",d="DOWN",opp={34,1},t={k="text",p={"I'm BROCK! I'm PEWTER's GYM LEADER!","I believe in rock hard defense and determination!","That's why my POKÃ©MON are all the rock-type!","Do you still want to challenge me? Fine then! Show me your best!"},s=1}},{x=3,y=6,s=7,m="STAY",d="RIGHT",opp={5,1},t={k="trainer",range=5,b={"Stop right there, kid!","You're still light years from facing BROCK!"},e={"Darn!","Light years isn't time! It measures distance!"},a={"You're pretty hot, but not as hot as BROCK!"}}},{x=7,y=10,s=36,m="STAY",d="DOWN",t={k="text",p={"Hiya! I can tell you have what it takes to become a POKÃ©MON champ!","I'm no trainer, but I can tell you how to win!","Let me take you to the top!"},s=1}}},wild=nil,hidden={{x=3,y=10,f="GymStatues"},{x=6,y=10,f="GymStatues"}}}return {id=55,const="PEWTER_NIDORAN_HOUSE",w=4,h=4,ts=8,border=10,conns={},warps={{2,7,255,4},{3,7,255,4}},signs={},objs={{x=4,y=5,s=5,m="STAY",d="LEFT",t={k="text",p={"NIDORAN: Bowbow!"}}},{x=3,y=5,s=53,m="STAY",d="RIGHT",t={k="text",p={"NIDORAN sit!"}}},{x=1,y=2,s=10,m="STAY",d="NONE",t={k="text",p={"Our POKÃ©MON's an outsider, so it's hard to handle.","An outsider is a POKÃ©MON that you get in a trade.","It grows fast, but it may ignore an unskilled trainer in battle!","If only we had some BADGEs..."}}}},wild=nil,hidden={}}return {id=56,const="PEWTER_MART",w=4,h=4,ts=2,border=0,conns={},warps={{3,7,255,5},{4,7,255,5}},signs={},objs={{x=0,y=5,s=38,m="STAY",d="RIGHT",t={k="mart",items={4,20,29,11,12,14,15}}},{x=3,y=3,s=4,m="WALK",d="UP_DOWN",t={k="text",p={"A shady, old man got me to buy this really weird fish POKÃ©MON!","It's totally weak and it cost Â¥500!"},s=1}},{x=5,y=5,s=12,m="STAY",d="NONE",t={k="text",p={"Good things can happen if you raise POKÃ©MON diligently, even the weak ones!"},s=1}}},wild=nil,hidden={}}return {id=57,const="PEWTER_SPEECH_HOUSE",w=4,h=4,ts=8,border=10,conns={},warps={{2,7,255,6},{3,7,255,6}},signs={},objs={{x=2,y=3,s=11,m="STAY",d="RIGHT",t={k="text",p={"POKÃ©MON learn new techniques as they grow!","But, some moves must be taught by the trainer!"}}},{x=4,y=5,s=4,m="STAY",d="NONE",t={k="text",p={"POKÃ©MON become easier to catch when they are hurt or asleep!","But, it's not a sure thing!"}}}},wild=nil,hidden={}}return {id=58,const="PEWTER_POKECENTER",w=7,h=4,ts=6,border=0,conns={},warps={{3,7,255,7},{4,7,255,7}},signs={},objs={{x=3,y=1,s=41,m="STAY",d="DOWN",t={k="nurse"}},{x=11,y=7,s=16,m="STAY",d="LEFT",t={k="text",p={"What!?","TEAM ROCKET is at MT.MOON? Huh? I'm on the phone!","Scram!"}}},{x=1,y=3,s=56,m="STAY",d="DOWN",t={k="text",p={"JIGGLYPUFF: Puu pupuu!"},s=1}},{x=11,y=2,s=42,m="STAY",d="DOWN",t={k="cable"}}},wild=nil,hidden={{x=0,y=4,f="PrintBenchGuyText"},{x=13,y=3,f="OpenPokemonCenterPC"}}}return {id=59,const="MT_MOON_1F",w=20,h=18,ts=17,border=3,conns={},warps={{14,35,255,2},{15,35,255,2},{5,5,60,1},{17,11,60,3},{25,15,60,4}},signs={{x=15,y=23,t={k="text",p={"Beware! ZUBAT is a blood sucker!"}}}},objs={{x=5,y=6,s=14,m="STAY",d="DOWN",opp={9,1},t={k="trainer",range=2,b={"WHOA! You shocked me! Oh, you're just a kid!"},e={"Wow! Shocked again!"},a={"Kids like you shouldn't be here!"}}},{x=12,y=16,s=4,m="STAY",d="RIGHT",opp={1,3},t={k="trainer",range=3,b={"Did you come to explore too?"},e={"Losing stinks!"},a={"I came down here to show off to girls."}}},{x=30,y=4,s=6,m="STAY",d="DOWN",opp={3,5},t={k="trainer",range=3,b={"Wow! It's way bigger in here than I thought!"},e={"Oh! I lost it!"},a={"How do you get out of here?"}}},{x=24,y=31,s=12,m="STAY",d="UP",opp={8,1},t={k="trainer",range=3,b={"What! Don't sneak up on me!"},e={"My POKÃ©MON won't do!"},a={"I have to find stronger POKÃ©MON."}}},{x=16,y=23,s=6,m="STAY",d="DOWN",opp={3,6},t={k="trainer",range=3,b={"What? I'm waiting for my friends to find me here."},e={"I lost?"},a={"I heard there are some very rare fossils here."}}},{x=7,y=22,s=4,m="STAY",d="DOWN",opp={2,7},t={k="trainer",range=3,b={"Suspicious men are in the cave. What about you?"},e={"You got me!"},a={"I saw them! I'm sure they're from TEAM ROCKET!"}}},{x=30,y=27,s=4,m="STAY",d="RIGHT",opp={2,8},t={k="trainer",range=3,b={"Go through this cave to get to CERULEAN CITY!"},e={"I lost."},a={"ZUBAT is tough! But, it can be useful if you catch one."}}},{x=2,y=20,s=61,m="STAY",d="NONE",item=20,story=1},{x=2,y=2,s=61,m="STAY",d="NONE",item=10,story=1},{x=35,y=31,s=61,m="STAY",d="NONE",item=40,story=1},{x=36,y=23,s=61,m="STAY",d="NONE",item=29,story=1},{x=20,y=33,s=61,m="STAY",d="NONE",item=20,story=1},{x=5,y=32,s=61,m="STAY",d="NONE",item=118,story=1}},wild={gr=10,g={{8,41},{7,41},{9,41},{8,74},{6,41},{10,41},{10,74},{8,46},{11,41},{8,35}},wr=0,w={}},hidden={}}return {id=6,const="CELADON_CITY",w=25,h=18,ts=0,border=15,conns={{"west",27,4},{"east",18,4}},warps={{8,13,122,1},{10,13,122,3},{24,9,128,1},{24,3,128,3},{25,3,128,3},{41,9,133,1},{12,27,134,1},{28,19,135,1},{39,19,136,1},{33,19,137,1},{31,27,138,1},{35,27,139,1},{43,27,140,1}},signs={{x=27,y=15,t={k="text",p={"TRAINER TIPS","X ACCURACY boosts the accuracy of techniques!","DIRE HIT jacks up the likelihood of critical hits!","Get your items at CELADON DEPT. STORE!"}}},{x=19,y=15,t={k="text",p={"CELADON CITY The City of Rainbow Dreams"}}},{x=42,y=9,t={k="none"}},{x=13,y=29,t={k="text",p={"CELADON CITY POKÃ©MON GYM LEADER: ERIKA","The Nature Loving Princess!"}}},{x=21,y=9,t={k="text",p={"CELADON MANSION"}}},{x=12,y=13,t={k="text",p={"Find what you need at CELADON DEPT. STORE!"}}},{x=39,y=21,t={k="text",p={"TRAINER TIPS","GUARD SPEC. protects POKÃ©MON against SPECIAL attacks such as fire and water!","Get your items at CELADON DEPT. STORE!"}}},{x=33,y=21,t={k="text",p={"Coins exchanged for prizes! PRIZE EXCHANGE"}}},{x=27,y=21,t={k="text",p={"ROCKET GAME CORNER The playground for grown-ups!"}}}},objs={{x=8,y=17,s=8,m="WALK",d="ANY_DIR",t={k="text",p={"I got my KOFFING in CINNABAR!","It's nice, but it breathes poison when it's angry!"}}},{x=11,y=28,s=37,m="STAY",d="UP",t={k="text",p={"Heheh! This GYM is great! It's full of women!"}}},{x=14,y=19,s=13,m="WALK",d="UP_DOWN",t={k="text",p={"The GAME CORNER is bad for our city's image!"}}},{x=25,y=22,s=37,m="STAY",d="DOWN",t={k="text",p={"Moan! I blew it all at the slots!","I knew I should have cashed in my coins for prizes!"}}},{x=22,y=16,s=37,m="STAY",d="DOWN",t={k="text",p={"Hello, there!","I've seen you, but I never had a chance to talk!","Here's a gift for dropping by!"},s=1}},{x=32,y=12,s=47,m="STAY",d="LEFT",t={k="text",p={"This is my trusted pal, POLIWRATH!","It evolved from POLIWHIRL when I used WATER STONE!"}}},{x=30,y=12,s=5,m="STAY",d="RIGHT",t={k="text",p={"POLIWRATH: Ribi ribit!"}}},{x=32,y=29,s=24,m="WALK",d="LEFT_RIGHT",t={k="text",p={"What are you staring at?"}}},{x=42,y=14,s=24,m="WALK",d="LEFT_RIGHT",t={k="text",p={"Keep out of TEAM ROCKET's way!"}}}},wild=nil,hidden={{x=48,y=15,f="HiddenItems",item=79}}}return {id=60,const="MT_MOON_B1F",w=14,h=14,ts=17,border=3,conns={},warps={{5,5,59,3},{17,11,61,1},{25,9,59,4},{25,15,59,5},{21,17,61,2},{13,27,61,3},{23,3,61,4},{27,3,255,3}},signs={},objs={},wild={gr=10,g={{8,41},{7,41},{7,74},{8,74},{9,41},{10,46},{10,41},{11,41},{9,35},{9,74}},wr=0,w={}},hidden={}}return {id=61,const="MT_MOON_B2F",w=20,h=18,ts=17,border=3,conns={},warps={{25,9,60,2},{21,17,60,5},{15,27,60,6},{5,7,60,7}},signs={},objs={{x=12,y=8,s=12,m="STAY",d="RIGHT",opp={8,2},t={k="text",p={"We'll each take one! No being greedy!"},s=1}},{x=11,y=16,s=24,m="STAY",d="DOWN",opp={30,1},t={k="trainer",range=4,b={"TEAM ROCKET will find the fossils, revive and sell them for cash!"},e={"Urgh! Now I'm mad!"},a={"You made me mad! TEAM ROCKET will blacklist you!"}}},{x=15,y=22,s=24,m="STAY",d="DOWN",opp={30,2},t={k="trainer",range=4,b={"We, TEAM ROCKET, are POKÃ©MON gangsters!"},e={"I blew it!"},a={"Darn it all! My associates won't stand for this!"}}},{x=29,y=11,s=24,m="STAY",d="UP",opp={30,3},t={k="trainer",range=4,b={"We're pulling a big job here! Get lost, kid!"},e={"So, you are good."},a={"If you find a fossil, give it to me and scram!"}}},{x=29,y=17,s=24,m="STAY",d="LEFT",opp={30,4},t={k="trainer",range=4,b={"Little kids should leave grown-ups alone!"},e={"I'm steamed!"},a={"POKÃ©MON lived here long before people came."}}},{x=12,y=6,s=62,m="STAY",d="NONE",t={k="text",p={"You want the DOME FOSSIL?"},s=1},story=1},{x=13,y=6,s=62,m="STAY",d="NONE",t={k="text",p={"You want the HELIX FOSSIL?"},s=1},story=1},{x=25,y=21,s=61,m="STAY",d="NONE",item=35,story=1},{x=29,y=5,s=61,m="STAY",d="NONE",item=107,story=1}},wild={gr=10,g={{9,41},{9,74},{10,41},{10,74},{11,41},{10,46},{12,46},{10,35},{12,41},{12,35}},wr=0,w={}},hidden={{x=18,y=12,f="HiddenItems",item=10},{x=33,y=9,f="HiddenItems",item=80}}}return {id=62,const="CERULEAN_TRASHED_HOUSE",w=4,h=4,ts=8,border=10,conns={},warps={{2,7,255,1},{3,7,255,1},{3,0,255,8}},signs={{x=3,y=0,t={k="text",p={"TEAM ROCKET left a way out!"}}}},objs={{x=2,y=1,s=39,m="STAY",d="DOWN",t={k="text",p={"Those miserable ROCKETs!","Look what they did here!","They stole a TM for teaching POKÃ©MON how to DIG holes!","That cost me a bundle, it did!"},s=1}},{x=5,y=6,s=13,m="WALK",d="LEFT_RIGHT",t={k="text",p={"TEAM ROCKET must be trying to DIG their way into no good!"}}}},wild=nil,hidden={}}return {id=63,const="CERULEAN_TRADE_HOUSE",w=4,h=4,ts=8,border=10,conns={},warps={{2,7,255,2},{3,7,255,2}},signs={},objs={{x=5,y=4,s=40,m="STAY",d="LEFT",t={k="text",p={"My husband likes trading POKÃ©MON.","If you are a collector, would you please trade with him?"}}},{x=1,y=2,s=11,m="STAY",d="NONE",t={k="trade",nick="LOLA"}}},wild=nil,hidden={}}return {id=64,const="CERULEAN_POKECENTER",w=7,h=4,ts=6,border=0,conns={},warps={{3,7,255,3},{4,7,255,3}},signs={},objs={{x=3,y=1,s=41,m="STAY",d="DOWN",t={k="nurse"}},{x=10,y=5,s=12,m="WALK",d="ANY_DIR",t={k="text",p={"That BILL!","I heard that he'll do whatever it takes to get rare POKÃ©MON!"}}},{x=4,y=3,s=16,m="STAY",d="DOWN",t={k="text",p={"Have you heard about BILL?","Everyone calls him a POKÃ©MANIAC!","I think people are just jealous of BILL, though.","Who wouldn't want to boast about their POKÃ©MON?"}}},{x=11,y=2,s=42,m="STAY",d="DOWN",t={k="cable"}}},wild=nil,hidden={{x=0,y=4,f="PrintBenchGuyText"},{x=13,y=3,f="OpenPokemonCenterPC"}}}return {id=65,const="CERULEAN_GYM",w=5,h=7,ts=7,border=3,conns={},warps={{4,13,255,4},{5,13,255,4}},signs={},objs={{x=4,y=2,s=29,m="STAY",d="DOWN",opp={35,1},t={k="text",p={"Hi, you're a new face!","Trainers who want to turn pro have to have a policy about POKÃ©MON!","What is your approach when you catch POKÃ©MON?","My policy is an all-out offensive with water-type POKÃ©MON!"},s=1}},{x=2,y=3,s=6,m="STAY",d="RIGHT",opp={6,1},t={k="trainer",range=3,b={"I'm more than good enough for you!","MISTY can wait!"},e={"You overwhelmed me!"},a={"You have to face other trainers to find out how good you really are."}}},{x=8,y=7,s=34,m="STAY",d="LEFT",opp={15,1},t={k="trainer",range=3,b={"Splash!","I'm first up! Let's do it!"},e={"That can't be!"},a={"MISTY is going to keep improving!","She won't lose to someone like you!"}}},{x=7,y=10,s=36,m="STAY",d="DOWN",t={k="text",p={"Yo! Champ in making!","Here's my advice!","The LEADER, MISTY, is a pro who uses water POKÃ©MON!","You can drain all their water with plant POKÃ©MON!","Or, zap them with electricity!"},s=1}}},wild=nil,hidden={{x=3,y=11,f="GymStatues"},{x=6,y=11,f="GymStatues"}}}return {id=66,const="BIKE_SHOP",w=4,h=4,ts=21,border=14,conns={},warps={{2,7,255,5},{3,7,255,5}},signs={},objs={{x=6,y=2,s=21,m="STAY",d="NONE",t={k="text",p={"How do you like your new BICYCLE?","You can take it on CYCLING ROAD and in caves!"},s=1}},{x=5,y=6,s=28,m="WALK",d="UP_DOWN",t={k="text",p={"A plain city BIKE is good enough for me!","You can't put a shopping basket on an MTB!"},s=1}},{x=1,y=3,s=4,m="STAY",d="UP",t={k="text",p={"These BIKEs are cool, but they're way expensive!"},s=1}}},wild=nil,hidden={{x=1,y=0,f="PrintNewBikeText"},{x=2,y=1,f="PrintNewBikeText"},{x=1,y=2,f="PrintNewBikeText"},{x=3,y=2,f="PrintNewBikeText"},{x=0,y=4,f="PrintNewBikeText"},{x=1,y=5,f="PrintNewBikeText"}}}return {id=67,const="CERULEAN_MART",w=4,h=4,ts=2,border=0,conns={},warps={{3,7,255,6},{4,7,255,6}},signs={},objs={{x=0,y=5,s=38,m="STAY",d="RIGHT",t={k="mart",items={4,20,30,11,12,14,15}}},{x=3,y=4,s=7,m="WALK",d="UP_DOWN",t={k="text",p={"Use REPEL to keep bugs and weak POKÃ©MON away.","Put your strongest POKÃ©MON at the top of the list for best results!"}}},{x=6,y=2,s=6,m="WALK",d="LEFT_RIGHT",t={k="text",p={"Have you seen any RARE CANDY?","It's supposed to make POKÃ©MON go up one level!"}}}},wild=nil,hidden={}}return {id=68,const="MT_MOON_POKECENTER",w=7,h=4,ts=6,border=0,conns={},warps={{3,7,255,1},{4,7,255,1}},signs={},objs={{x=3,y=1,s=41,m="STAY",d="DOWN",t={k="nurse"}},{x=4,y=3,s=4,m="STAY",d="UP",t={k="text",p={"I've 6 POKÃ© BALLs set in my belt.","At most, you can carry 6 POKÃ©MON."}}},{x=7,y=3,s=16,m="STAY",d="UP",t={k="text",p={"TEAM ROCKET attacks CERULEAN citizens...","TEAM ROCKET is always in the news!"}}},{x=10,y=6,s=10,m="WALK",d="LEFT_RIGHT",t={k="text",p={"MAN: Hello, there! Have I got a deal just for you!","I'll let you have a swell MAGIKARP for just Â¥500! What do you say?"},s=1}},{x=7,y=2,s=66,m="STAY",d="NONE",t={k="text",p={},s=1}},{x=11,y=2,s=42,m="STAY",d="DOWN",t={k="cable"}}},wild=nil,hidden={{x=0,y=4,f="PrintBenchGuyText"},{x=13,y=3,f="OpenPokemonCenterPC"}}}return {id=7,const="FUCHSIA_CITY",w=20,h=18,ts=0,border=15,conns={{"south",30,5},{"west",29,4},{"east",26,4}},warps={{5,13,152,1},{11,27,153,1},{19,27,154,1},{27,27,155,1},{18,3,156,1},{5,27,157,1},{22,13,158,1},{31,27,164,2},{31,24,164,1}},signs={{x=15,y=23,t={k="text",p={"FUCHSIA CITY Behold! It's Passion Pink!"}}},{x=25,y=15,t={k="text",p={"FUCHSIA CITY Behold! It's Passion Pink!"}}},{x=17,y=5,t={k="text",p={"SAFARI GAME POKÃ©MON-U-CATCH!"}}},{x=6,y=13,t={k="none"}},{x=20,y=27,t={k="none"}},{x=27,y=29,t={k="text",p={"SAFARI ZONE WARDEN's HOME"}}},{x=21,y=15,t={k="text",p={"POKÃ©MON PARADISE SAFARI ZONE"}}},{x=5,y=29,t={k="text",p={"FUCHSIA CITY POKÃ©MON GYM LEADER: KOGA","The Poisonous Ninja Master"}}},{x=33,y=7,t={k="text",p={"Name: CHANSEY","Catching one is all up to chance."},s=1}},{x=27,y=7,t={k="text",p={"Name: VOLTORB","The very image of a POKÃ© BALL."},s=1}},{x=13,y=7,t={k="text",p={"Name: KANGASKHAN","A maternal POKÃ©MON that raises its young in a pouch on its belly."},s=1}},{x=31,y=13,t={k="text",p={"Name: SLOWPOKE","Friendly and very slow moving."},s=1}},{x=13,y=15,t={k="text",p={"Name: LAPRAS","A.K.A. the king of the seas."},s=1}},{x=7,y=7,t={k="text",p={"Name: OMANYTE","A POKÃ©MON that was resurrected from a fossil."},s=1}}},objs={{x=10,y=12,s=4,m="WALK",d="LEFT_RIGHT",t={k="text",p={"Did you try the SAFARI GAME? Some POKÃ©MON can only be caught there."}}},{x=28,y=17,s=11,m="WALK",d="LEFT_RIGHT",t={k="text",p={"SAFARI ZONE has a zoo in front of the entrance.","Out back is the SAFARI GAME for catching POKÃ©MON."}}},{x=30,y=14,s=47,m="STAY",d="DOWN",t={k="text",p={"ERIK: Where's SARA? I said I'd meet her here."}}},{x=24,y=8,s=4,m="STAY",d="UP",t={k="text",p={"That item ball in there is really a POKÃ©MON."}}},{x=31,y=5,s=56,m="WALK",d="ANY_DIR",t={k="text",p={"!"}}},{x=25,y=6,s=61,m="STAY",d="NONE",t={k="text",p={"!"}}},{x=12,y=6,s=5,m="WALK",d="LEFT_RIGHT",t={k="text",p={"!"}}},{x=30,y=12,s=5,m="WALK",d="LEFT_RIGHT",t={k="text",p={"!"}}},{x=8,y=17,s=60,m="WALK",d="ANY_DIR",t={k="text",p={"!"}}},{x=6,y=5,s=62,m="STAY",d="NONE",t={k="text",p={"!"}}}},wild=nil,hidden={}}return {id=70,const="ROUTE_5_GATE",w=4,h=3,ts=12,border=10,conns={},warps={{3,5,255,3},{4,5,255,3},{3,0,255,2},{4,0,255,1}},signs={},objs={{x=1,y=3,s=49,m="STAY",d="RIGHT",t={k="text",p={"I'm on guard duty. Gee, I'm thirsty, though!","Oh wait there, the road's closed."},s=1}}},wild=nil,hidden={}}return {id=71,const="UNDERGROUND_PATH_ROUTE_5",w=4,h=4,ts=12,border=10,conns={},warps={{3,7,255,4},{4,7,255,4},{4,4,119,1}},signs={},objs={{x=2,y=3,s=8,m="STAY",d="NONE",t={k="trade",nick="SPOT"}}},wild=nil,hidden={}}return {id=72,const="DAYCARE",w=4,h=4,ts=8,border=10,conns={},warps={{2,7,255,5},{3,7,255,5}},signs={},objs={{x=2,y=3,s=16,m="STAY",d="RIGHT",t={k="text",p={"I run a DAYCARE. Would you like me to raise one of your POKÃ©MON?"},s=1}}},wild=nil,hidden={}}return {id=73,const="ROUTE_6_GATE",w=4,h=3,ts=12,border=10,conns={},warps={{3,5,255,3},{4,5,255,3},{3,0,255,2},{4,0,255,2}},signs={},objs={{x=6,y=2,s=49,m="STAY",d="LEFT",t={k="text",p={"I'm on guard duty. Gee, I'm thirsty, though!","Oh wait there, the road's closed."},s=1}}},wild=nil,hidden={}}return {id=74,const="UNDERGROUND_PATH_ROUTE_6",w=4,h=4,ts=12,border=10,conns={},warps={{3,7,255,4},{4,7,255,4},{4,4,119,2}},signs={},objs={{x=2,y=3,s=13,m="STAY",d="NONE",t={k="text",p={"People often lose things in that UNDERGROUND PATH."}}}},wild=nil,hidden={}}return {id=76,const="ROUTE_7_GATE",w=3,h=4,ts=12,border=10,conns={},warps={{0,3,255,4},{0,4,255,4},{5,3,255,1},{5,4,255,2}},signs={},objs={{x=3,y=1,s=49,m="STAY",d="DOWN",t={k="text",p={"I'm on guard duty. Gee, I'm thirsty, though!","Oh wait there, the road's closed."},s=1}}},wild=nil,hidden={}}return {id=77,const="UNDERGROUND_PATH_ROUTE_7",w=4,h=4,ts=12,border=10,conns={},warps={{3,7,255,6},{4,7,255,6},{4,4,121,1}},signs={},objs={{x=3,y=2,s=13,m="STAY",d="NONE",t={k="text",p={"I want to shop at the dept. store in CELADON but...","There are so many rough looking people there."}}},{x=2,y=4,s=10,m="STAY",d="NONE",t={k="text",p={"You're here to shop in CELADON?","Just step outside and head west!"}}}},wild=nil,hidden={}}return {id=79,const="ROUTE_8_GATE",w=3,h=4,ts=12,border=10,conns={},warps={{0,3,255,1},{0,4,255,2},{5,3,255,3},{5,4,255,4}},signs={},objs={{x=2,y=1,s=49,m="STAY",d="DOWN",t={k="text",p={"I'm on guard duty. Gee, I'm thirsty, though!","Oh wait there, the road's closed."},s=1}}},wild=nil,hidden={}}return {id=8,const="CINNABAR_ISLAND",w=10,h=9,ts=0,border=67,conns={{"north",32,0},{"east",31,0}},warps={{6,3,165,2},{18,3,166,1},{6,9,167,1},{11,11,171,1},{15,11,172,1}},signs={{x=9,y=5,t={k="text",p={"CINNABAR ISLAND The Fiery Town of Burning Desire"}}},{x=16,y=11,t={k="none"}},{x=12,y=11,t={k="none"}},{x=9,y=11,t={k="text",p={"POKÃ©MON LAB"}}},{x=13,y=3,t={k="text",p={"CINNABAR ISLAND POKÃ©MON GYM LEADER: BLAINE","The Hot-Headed Quiz Master!"}}}},objs={{x=12,y=5,s=13,m="WALK",d="LEFT_RIGHT",t={k="text",p={"CINNABAR GYM's BLAINE is an odd man who has lived here for decades."}}},{x=14,y=6,s=11,m="STAY",d="NONE",t={k="text",p={"Scientists conduct experiments in the burned out building."}}}},wild=nil,hidden={}}return {id=80,const="UNDERGROUND_PATH_ROUTE_8",w=4,h=4,ts=12,border=10,conns={},warps={{3,7,255,5},{4,7,255,5},{4,4,121,2}},signs={},objs={{x=3,y=4,s=13,m="STAY",d="NONE",t={k="text",p={"The dept. store in CELADON has a great selection!"}}}},wild=nil,hidden={}}return {id=81,const="ROCK_TUNNEL_POKECENTER",w=7,h=4,ts=6,border=0,conns={},warps={{3,7,255,1},{4,7,255,1}},signs={},objs={{x=3,y=1,s=41,m="STAY",d="DOWN",t={k="nurse"}},{x=7,y=3,s=16,m="WALK",d="LEFT_RIGHT",t={k="text",p={"The element types of POKÃ©MON make them stronger than some types and weaker than others!"}}},{x=2,y=5,s=47,m="STAY",d="NONE",t={k="text",p={"I sold a useless NUGGET for Â¥5000!"}}},{x=11,y=2,s=42,m="STAY",d="DOWN",t={k="cable"}}},wild=nil,hidden={{x=0,y=4,f="PrintBenchGuyText"},{x=13,y=3,f="OpenPokemonCenterPC"}}}return {id=82,const="ROCK_TUNNEL_1F",w=20,h=18,ts=17,border=3,conns={},warps={{15,3,255,2},{15,0,255,2},{15,33,255,3},{15,35,255,3},{37,3,232,1},{5,3,232,2},{17,11,232,3},{37,17,232,4}},signs={{x=11,y=29,t={k="text",p={"ROCK TUNNEL CERULEAN CITY - LAVENDER TOWN"}}}},objs={{x=7,y=5,s=14,m="STAY",d="DOWN",opp={9,12},t={k="trainer",range=4,b={"This tunnel goes a long way, kid!"},e={"Doh! You win!"},a={"Watch for ONIX! It can put the squeeze on you!"}}},{x=5,y=16,s=14,m="STAY",d="DOWN",opp={9,13},t={k="trainer",range=4,b={"Hmm. Maybe I'm lost in here..."},e={"Ease up! What am I doing? Which way is out?"},a={"That sleeping POKÃ©MON on ROUTE 12 forced me to take this detour."}}},{x=17,y=15,s=14,m="STAY",d="LEFT",opp={9,14},t={k="trainer",range=3,b={"Outsiders like you need to show me some respect!"},e={"I give!"},a={"You're talented enough to hike!"}}},{x=23,y=8,s=12,m="STAY",d="LEFT",opp={7,7},t={k="trainer",range=3,b={"POKÃ©MON fight! Ready, go!"},e={"Game over!"},a={"Oh well, I'll get a ZUBAT as I go!"}}},{x=37,y=21,s=6,m="STAY",d="LEFT",opp={6,17},t={k="trainer",range=4,b={"Eek! Don't try anything funny in the dark!"},e={"It was too dark!"},a={"I saw a MACHOP in this tunnel!"}}},{x=22,y=24,s=6,m="STAY",d="DOWN",opp={6,18},t={k="trainer",range=4,b={"I came this far for POKÃ©MON!"},e={"I'm out of POKÃ©MON!"},a={"You looked cute and harmless!"}}},{x=32,y=24,s=6,m="STAY",d="RIGHT",opp={6,19}}},wild={gr=15,g={{16,41},{17,41},{17,74},{15,66},{16,74},{18,41},{15,41},{17,66},{13,95},{15,95}},wr=0,w={}},hidden={}}return {id=83,const="POWER_PLANT",w=20,h=18,ts=22,border=46,conns={},warps={{4,35,255,4},{5,35,255,4},{0,11,255,4}},signs={},objs={{x=9,y=20,s=61,m="STAY",d="NONE",mon={100,40},story=1},{x=32,y=18,s=61,m="STAY",d="NONE",mon={100,40},story=1},{x=21,y=25,s=61,m="STAY",d="NONE",mon={100,40},story=1},{x=25,y=18,s=61,m="STAY",d="NONE",mon={101,43},story=1},{x=23,y=34,s=61,m="STAY",d="NONE",mon={100,40},story=1},{x=26,y=28,s=61,m="STAY",d="NONE",mon={100,40},story=1},{x=21,y=14,s=61,m="STAY",d="NONE",mon={101,43},story=1},{x=37,y=32,s=61,m="STAY",d="NONE",mon={100,40},story=1},{x=4,y=9,s=9,m="STAY",d="UP",mon={145,50},story=1},{x=7,y=25,s=61,m="STAY",d="NONE",item=38,story=1},{x=28,y=3,s=61,m="STAY",d="NONE",item=35,story=1},{x=34,y=3,s=61,m="STAY",d="NONE",item=40,story=1},{x=26,y=32,s=61,m="STAY",d="NONE",item=131,story=1},{x=20,y=32,s=61,m="STAY",d="NONE",item=139,story=1}},wild={gr=10,g={{21,100},{21,81},{20,25},{24,25},{23,81},{23,100},{32,82},{35,82},{33,125},{36,125}},wr=0,w={}},hidden={{x=17,y=16,f="HiddenItems",item=83},{x=12,y=1,f="HiddenItems",item=79}}}return {id=84,const="ROUTE_11_GATE_1F",w=4,h=5,ts=12,border=10,conns={},warps={{0,4,255,1},{0,5,255,2},{7,4,255,3},{7,5,255,4},{6,8,86,1}},signs={},objs={{x=4,y=1,s=49,m="STAY",d="NONE",t={k="text",p={"When you catch lots of POKÃ©MON, isn't it hard to think up names?","In LAVENDER TOWN, there's a man who rates POKÃ©MON nicknames.","He'll help you rename them too!"}}}},wild=nil,hidden={}}return {id=85,const="DIGLETTS_CAVE_ROUTE_11",w=4,h=4,ts=17,border=125,conns={},warps={{2,7,255,5},{3,7,255,5},{4,4,197,2}},signs={},objs={{x=2,y=3,s=11,m="STAY",d="NONE",t={k="text",p={"What a surprise! DIGLETTs dug this long tunnel!","It goes right to VIRIDIAN CITY!"}}}},wild=nil,hidden={}}return {id=86,const="ROUTE_11_GATE_2F",w=4,h=4,ts=12,border=10,conns={},warps={{7,7,84,5}},signs={{x=1,y=2,t={k="text",p={"Looked into the binoculars.","A big POKÃ©MON is asleep on a road!"},s=1}},{x=6,y=2,t={k="text",p={"Looked into the binoculars.","The only way to get from CERULEAN CITY to LAVENDER is by way of the ROCK TUNNEL."},s=1}}},objs={{x=4,y=2,s=4,m="WALK",d="LEFT_RIGHT"},{x=2,y=6,s=32,m="STAY",d="NONE",t={k="text",p={"There are items on the ground that can't be seen.","ITEMFINDER will detect an item close to you.","It can't pinpoint it, so you have to look yourself!"},s=1}}},wild=nil,hidden={}}return {id=87,const="ROUTE_12_GATE_1F",w=5,h=4,ts=12,border=10,conns={},warps={{4,0,255,1},{5,0,255,2},{4,7,255,3},{5,7,255,3},{8,6,195,1}},signs={},objs={{x=1,y=3,s=49,m="STAY",d="NONE",t={k="text",p={"There's a lookout spot upstairs."}}}},wild=nil,hidden={}}return {id=88,const="BILLS_HOUSE",w=4,h=4,ts=16,border=13,conns={},warps={{2,7,255,1},{3,7,255,1}},signs={},objs={{x=6,y=5,s=5,m="STAY",d="NONE",t={k="text",p={"Hiya! I'm a POKÃ©MON... ...No I'm not!","Call me BILL! I'm a true blue POKÃ©MANIAC! Hey! What's with that skeptical look?","I'm not joshing you, I screwed up an experiment and got combined with a POKÃ©MON!","So, how about it? Help me out here!"},s=1},story=1},{x=4,y=4,s=12,m="STAY",d="NONE",t={k="text",p={"BILL: Yeehah! Thanks, bud! I owe you one!","So, did you come to see my POKÃ©MON collection? You didn't? That's a bummer.","I've got to thank you... Oh here, maybe this'll do."},s=1},hide=1},{x=6,y=5,s=12,m="STAY",d="NONE",t={k="text",p={"BILL: Look, bud, just check out some of my rare POKÃ©MON on my PC!"},s=1},hide=1}},wild=nil,hidden={{x=1,y=4,f="BillsHousePC"}}}return {id=89,const="VERMILION_POKECENTER",w=7,h=4,ts=6,border=0,conns={},warps={{3,7,255,1},{4,7,255,1}},signs={},objs={{x=3,y=1,s=41,m="STAY",d="DOWN",t={k="nurse"}},{x=10,y=5,s=39,m="STAY",d="NONE",t={k="text",p={"Even if they are the same level, POKÃ©MON can have very different abilities.","A POKÃ©MON raised by a trainer is stronger than one in the wild."}}},{x=5,y=4,s=19,m="STAY",d="NONE",t={k="text",p={"My POKÃ©MON was poisoned! It fainted while we were walking!"}}},{x=11,y=2,s=42,m="STAY",d="DOWN",t={k="cable"}}},wild=nil,hidden={{x=13,y=3,f="OpenPokemonCenterPC"},{x=0,y=4,f="PrintBenchGuyText"}}}return {id=9,const="INDIGO_PLATEAU",w=10,h=9,ts=23,border=14,conns={{"south",34,0}},warps={{9,5,174,1},{10,5,174,1}},signs={},objs={},wild=nil,hidden={{x=11,y=13,f="PrintIndigoPlateauHQText"}}}return {id=90,const="POKEMON_FAN_CLUB",w=4,h=4,ts=16,border=13,conns={},warps={{2,7,255,2},{3,7,255,2}},signs={{x=1,y=0,t={k="text",p={"Let's all listen politely to other trainers!"}}},{x=6,y=0,t={k="text",p={"If someone brags, brag right back!"}}}},objs={{x=6,y=3,s=47,m="STAY",d="LEFT",t={k="text",p={"Won't you admire my PIKACHU's adorable tail?"},s=1}},{x=1,y=3,s=13,m="STAY",d="RIGHT",t={k="text",p={"I just love my SEEL!","It squeals when I hug it!"},s=1}},{x=6,y=4,s=56,m="STAY",d="LEFT",t={k="text",p={"PIKACHU: Chu! Pikachu!"},s=1}},{x=1,y=4,s=60,m="STAY",d="RIGHT",t={k="text",p={"SEEL: Kyuoo!"},s=1}},{x=3,y=1,s=16,m="STAY",d="DOWN",t={k="text",p={"I chair the POKÃ©MON Fan Club!","I have collected over 100 POKÃ©MON!","I'm very fussy when it comes to POKÃ©MON!","So...","Did you come visit to hear about my POKÃ©MON?"},s=1}},{x=5,y=1,s=42,m="STAY",d="DOWN",t={k="text",p={"Our Chairman is very vocal about POKÃ©MON."}}}},wild=nil,hidden={}}return {id=91,const="VERMILION_MART",w=4,h=4,ts=2,border=0,conns={},warps={{3,7,255,3},{4,7,255,3}},signs={},objs={{x=0,y=5,s=38,m="STAY",d="RIGHT",t={k="mart",items={4,19,13,14,15,30}}},{x=5,y=6,s=7,m="STAY",d="NONE",t={k="text",p={"There are evil people who will use POKÃ©MON for criminal acts.","TEAM ROCKET traffics in rare POKÃ©MON.","They also abandon POKÃ©MON that they consider not to be popular or useful."}}},{x=3,y=3,s=6,m="WALK",d="LEFT_RIGHT",t={k="text",p={"I think POKÃ©MON can be good or evil. It depends on the trainer."}}}},wild=nil,hidden={}}return {id=92,const="VERMILION_GYM",w=5,h=9,ts=7,border=3,conns={},warps={{4,17,255,4},{5,17,255,4}},signs={},objs={{x=5,y=1,s=33,m="STAY",d="DOWN",opp={36,1},t={k="text",p={"Hey, kid! What do you think you're doing here?","You won't live long in combat! That's for sure!","I tell you kid, electric POKÃ©MON saved me during the war!","They zapped my enemies into paralysis!","The same as I'll do to you!"},s=1}},{x=9,y=6,s=16,m="STAY",d="LEFT",opp={41,3},t={k="trainer",range=3,b={"When I was in the Army, LT.SURGE was my strict CO!"},e={"Stop! You're very good!"},a={"The door won't open?","LT.SURGE always was cautious!"}}},{x=3,y=8,s=12,m="STAY",d="LEFT",opp={20,1},t={k="trainer",range=2,b={"I'm a lightweight, but I'm good with electricity!"},e={"Fried!"},a={"OK, I'll talk!","LT.SURGE said he hid door switches inside something!"}}},{x=0,y=10,s=19,m="STAY",d="RIGHT",opp={4,8},t={k="trainer",range=3,b={"This is no place for kids!"},e={"Wow! Surprised me!"},a={"LT.SURGE set up double locks! Here's a hint!","When you open the 1st lock, the 2nd lock is right next to it!"}}},{x=4,y=14,s=36,m="STAY",d="DOWN",t={k="text",p={"Yo! Champ in making!","LT.SURGE has a nickname. People refer to him as the Lightning American!","He's an expert on electric POKÃ©MON!","Birds and water POKÃ©MON are at risk! Beware of paralysis too!","LT.SURGE is very cautious!","You'll have to break a code to get to him!"},s=1}}},wild=nil,hidden={{x=3,y=14,f="GymStatues"},{x=6,y=14,f="GymStatues"},{x=6,y=1,f="PrintTrashText"},{x=1,y=7,f="GymTrashScript"},{x=1,y=9,f="GymTrashScript"},{x=1,y=11,f="GymTrashScript"},{x=3,y=7,f="GymTrashScript"},{x=3,y=9,f="GymTrashScript"},{x=3,y=11,f="GymTrashScript"},{x=5,y=7,f="GymTrashScript"},{x=5,y=9,f="GymTrashScript"},{x=5,y=11,f="GymTrashScript"},{x=7,y=7,f="GymTrashScript"},{x=7,y=9,f="GymTrashScript"},{x=7,y=11,f="GymTrashScript"},{x=9,y=7,f="GymTrashScript"},{x=9,y=9,f="GymTrashScript"},{x=9,y=11,f="GymTrashScript"}}}return {id=93,const="VERMILION_PIDGEY_HOUSE",w=4,h=4,ts=8,border=10,conns={},warps={{2,7,255,5},{3,7,255,5}},signs={},objs={{x=5,y=3,s=4,m="STAY",d="LEFT",t={k="text",p={"I'm getting my PIDGEY to fly a letter to SAFFRON in the north!"}}},{x=3,y=5,s=9,m="WALK",d="LEFT_RIGHT",t={k="text",p={"PIDGEY: Kurukkoo!"}}},{x=4,y=3,s=64,m="STAY",d="NONE",t={k="text",p={"Dear PIPPI, I hope to see you soon.","I heard SAFFRON has problems with TEAM ROCKET.","VERMILION appears to be safe."}}}},wild=nil,hidden={}}return {id=94,const="VERMILION_DOCK",w=14,h=6,ts=14,border=15,conns={},warps={{14,0,255,6},{14,2,95,2}},signs={},objs={},wild=nil,hidden={}}return {id=95,const="SS_ANNE_1F",w=20,h=9,ts=13,border=12,conns={},warps={{26,0,94,2},{27,0,94,2},{31,8,102,1},{23,8,102,2},{19,8,102,3},{15,8,102,4},{11,8,102,5},{7,8,102,6},{2,6,96,7},{37,15,98,6},{3,16,100,1}},signs={},objs={{x=12,y=6,s=26,m="WALK",d="LEFT_RIGHT",t={k="text",p={"Bonjour! I am le waiter on this ship!","I will be happy to serve you any- thing you please!","Ah! Le strong silent type!"}}},{x=27,y=5,s=19,m="STAY",d="NONE",t={k="text",p={"The passengers are restless!","You might be challenged by the more bored ones!"}}}},wild=nil,hidden={}}return {id=96,const="SS_ANNE_2F",w=20,h=9,ts=13,border=12,conns={},warps={{9,11,103,1},{13,11,103,3},{17,11,103,5},{21,11,103,7},{25,11,103,9},{29,11,103,11},{2,4,95,9},{2,12,97,2},{36,4,101,1}},signs={},objs={{x=3,y=7,s=26,m="WALK",d="UP_DOWN",t={k="text",p={"This ship, she is a luxury liner for trainers!","At every port, we hold parties with invited trainers!"}}},{x=36,y=4,s=2,m="STAY",d="DOWN",opp={25,1},t={k="text",p={"BLUE: Bonjour! RED!","Imagine seeing you here!","RED, were you really invited?","So how's your POKÃ©DEX coming?","I already caught 40 kinds, pal!","Different kinds are everywhere!","Crawl around in grassy areas!"},s=1},hide=1}},wild=nil,hidden={}}return {id=97,const="SS_ANNE_3F",w=10,h=3,ts=13,border=12,conns={},warps={{0,3,99,1},{19,3,96,8}},signs={},objs={{x=9,y=3,s=19,m="WALK",d="LEFT_RIGHT",t={k="text",p={"Our CAPTAIN is a sword master!","He even teaches CUT to POKÃ©MON!"}}}},wild=nil,hidden={}}return {id=98,const="SS_ANNE_B1F",w=15,h=4,ts=13,border=12,conns={},warps={{23,3,104,9},{19,3,104,7},{15,3,104,5},{11,3,104,3},{7,3,104,1},{27,5,95,10}},signs={},objs={},wild=nil,hidden={}}return {id=99,const="SS_ANNE_BOW",w=10,h=7,ts=13,border=35,conns={},warps={{13,6,97,1},{13,7,97,1}},signs={},objs={{x=5,y=2,s=12,m="STAY",d="UP",t={k="text",p={"The party's over. The ship will be departing soon."}}},{x=4,y=9,s=19,m="STAY",d="NONE",t={k="text",p={"Scrubbing decks is hard work!"}}},{x=7,y=11,s=7,m="STAY",d="NONE",t={k="text",p={"Urf. I feel ill.","I stepped out to get some air."}}},{x=4,y=4,s=19,m="STAY",d="DOWN",opp={4,1},t={k="trainer",range=3,b={"Hey matey!","Let's do a little jig!"},e={"You're impressive!"},a={"How many kinds of POKÃ©MON do you think there are?"}}},{x=10,y=8,s=19,m="STAY",d="UP",opp={4,2},t={k="trainer",range=3,b={"Ahoy there! Are you seasick?"},e={"I was just careless!"},a={"My Pa said there are 100 kinds of POKÃ©MON. I think there are more."}}}},wild=nil,hidden={}}88␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ø␀␀␀␀␀␀␀␀␀␀␀ú—À␀␀␀␀␀␀␀␀␀␀.ª•p␀␀␀␀␀␀␀␀␀␀êúeX␀␀␀␀␀␀␀␀␀«™\␀␀␀␀␀␀␀␀␀¬£fV␀␀␀␀␀␀␀␀␀¬£™—␀␀␀␀␀␀␀␀␀«¦g␀␀␀␀␀␀␀␀␀ªğ

},{x=5,y=39,s=47,m="STAY",d="UP",opp={14,4},t={k="trainer",range=4,b={"Be patient! Fishing is a waiting game!"},e={"That one got away!"},a={"With a better ROD, I could catch better POKÃ©MON!"}}},{x=11,y=92,s=7,m="STAY",d="LEFT",opp={5,9},t={k="trainer",range=4,b={"Have you found a MOON STONE?"},e={"Oww!"},a={"I could have made my POKÃ©MON evolve with MOON STONE!"}}},{x=14,y=76,s=12,m="STAY",d="UP",opp={20,2},t={k="trainer",range=4,b={"Electricity is my specialty!"},e={"Unplugged!"},a={"Water conducts electricity, so you should zap sea POKÃ©MON!"}}},{x=12,y=40,s=47,m="STAY",d="LEFT",opp={14,5},t={k="trainer",range=4,b={"The FISHING FOOL vs. POKÃ©MON KID!"},e={"Too much!"},a={"You beat me at POKÃ©MON, but I'm good at fishing!"}}},{x=9,y=52,s=47,m="STAY",d="RIGHT",opp={14,6},t={k="trainer",range=4,b={"I'd rather be working!"},e={"It's not easy..."},a={"It's all right. Losing doesn't bug me any more."}}},{x=6,y=87,s=47,m="STAY",d="DOWN",opp={14,11},t={k="trainer",range=1,b={"You never know what you could catch!"},e={"Lost it!"},a={"I catch MAGIKARP all the time, but they're so weak!"}}},{x=14,y=35,s=61,m="STAY",d="NONE",item=122,story=1},{x=5,y=89,s=61,m="STAY",d="NONE",item=37,story=1}},wild={gr=15,g={{24,43},{25,16},{23,16},{24,48},{22,43},{26,48},{26,43},{27,16},{28,44},{30,44}},wr=0,w={}},hidden={{x=2,y=63,f="HiddenItems",item=18}}}return {id=230,const="CERULEAN_BADGE_HOUSE",w=4,h=4,ts=13,border=12,conns={},warps={{2,0,255,10},{2,7,255,9},{3,7,255,9}},signs={},objs={{x=5,y=3,s=10,m="STAY",d="RIGHT",t={k="text",p={"POKÃ©MON BADGEs are owned only by skilled trainers.","I see you have at least one.","Those BADGEs have amazing secrets!"},s=1}}},wild=nil,hidden={}}return {id=232,const="ROCK_TUNNEL_B1F",w=20,h=18,ts=17,border=3,conns={},warps={{33,25,82,5},{27,3,82,6},{23,11,82,7},{3,3,82,8}},signs={},objs={{x=11,y=13,s=6,m="STAY",d="DOWN",opp={6,9},t={k="trainer",range=4,b={"Hikers leave twigs as trail markers."},e={"Ohhh! I did my best!"},a={"I want to go home!"}}},{x=6,y=10,s=14,m="STAY",d="DOWN",opp={9,9},t={k="trainer",range=3,b={"Hahaha! Can you beat my power?"},e={"Oops! Out-muscled!"},a={"I go for power because I hate thinking!"}}},{x=3,y=5,s=12,m="STAY",d="DOWN",opp={7,3},t={k="trainer",range=3,b={"You have a POKÃ©DEX? I want one too!"},e={"Shoot! I'm so jealous!"},a={"When you finish your POKÃ©DEX, can I have it?"}}},{x=20,y=21,s=12,m="STAY",d="RIGHT",opp={7,4},t={k="trainer",range=4,b={"Do you know about costume players?"},e={"Well, that's that."},a={"Costume players dress up as POKÃ©MON for fun."}}},{x=30,y=10,s=14,m="STAY",d="DOWN",opp={9,10},t={k="trainer",range=3,b={"My POKÃ©MON techniques will leave you crying!"},e={"I give! You're a better technician!"},a={"In mountains, you'll often find rock-type POKÃ©MON."}}},{x=14,y=28,s=6,m="STAY",d="RIGHT",opp={6,10},t={k="trainer",range=4,b={"I don't often come here, but I will fight you."},e={"Oh! I lost!"},a={"I like tiny POKÃ©MON, big ones are too scary!"}}},{x=33,y=5,s=14,m="STAY",d="RIGHT",opp={9,11},t={k="trainer",range=3,b={"Hit me with your best shot!"},e={"Fired away!"},a={"I'll raise my POKÃ©MON to beat yours, kid!"}}},{x=26,y=30,s=12,m="STAY",d="DOWN",opp={7,5},t={k="trainer",range=3,b={"I draw POKÃ©MON when I'm home."},e={"Whew! I'm exhausted!"},a={"I'm an artist, not a fighter."}}}},wild={gr=15,g={{16,41},{17,41},{17,74},{15,66},{16,74},{18,41},{17,66},{17,95},{13,95},{18,74}},wr=0,w={}},hidden={}}return {id=233,const="SILPH_CO_9F",w=13,h=9,ts=22,border=46,conns={},warps={{14,0,234,1},{16,0,213,1},{18,0,236,1},{9,3,208,8},{17,15,210,5}},signs={},objs={{x=3,y=14,s=41,m="STAY",d="DOWN",t={k="text",p={"You look tired! You should take a quick nap!"},s=1}},{x=2,y=4,s=24,m="STAY",d="UP",opp={30,37},t={k="trainer",range=4,b={"Your POKÃ©MON seem to adore you, kid!"},e={"Ghaaah!"},a={"If I had started as a trainer at your age..."}},story=1},{x=21,y=13,s=32,m="STAY",d="DOWN",opp={28,10},t={k="trainer",range=2,b={"Your POKÃ©MON have weak points! I can nail them!"},e={"You hammered me!"},a={"Exploiting weak spots does work! Think about element types!"}},story=1},{x=13,y=16,s=24,m="STAY",d="UP",opp={30,38},t={k="trainer",range=4,b={"I am one of the 4 ROCKET BROTHERS!"},e={"Warg! Brothers, I lost!"},a={"My brothers will avenge me!"}},story=1}},wild=nil,hidden={{x=2,y=15,f="HiddenItems",item=17}}}return {id=234,const="SILPH_CO_10F",w=8,h=9,ts=22,border=46,conns={},warps={{8,0,233,1},{10,0,235,1},{12,0,236,1},{9,11,209,4},{13,15,209,6},{13,7,209,7}},signs={},objs={{x=1,y=9,s=24,m="STAY",d="RIGHT",opp={30,39},t={k="trainer",range=3,b={"Welcome to the 10F! So good of you to join me!"},e={"I'm stunned!"},a={"Nice try, but the boardroom is up one more floor!"}},story=1},{x=10,y=2,s=32,m="STAY",d="LEFT",opp={28,11},t={k="trainer",range=4,b={"Enough of your silly games!"},e={"No continues left!"},a={"Are you satisfied with beating me? Then go on home!"}},story=1},{x=9,y=15,s=27,m="WALK",d="ANY_DIR",t={k="text",p={"Waaaaa! I'm scared!"},s=1},story=1},{x=2,y=12,s=61,m="STAY",d="NONE",item=132,story=1},{x=4,y=14,s=61,m="STAY",d="NONE",item=40,story=1},{x=5,y=11,s=61,m="STAY",d="NONE",item=38,story=1}},wild=nil,hidden={}}return {id=235,const="SILPH_CO_11F",w=9,h=9,ts=16,border=13,conns={},warps={{9,0,234,2},{13,0,236,1},{5,5,255,10},{3,2,212,4}},signs={},objs={{x=7,y=5,s=43,m="STAY",d="DOWN",t={k="text",p={"PRESIDENT: Thank you for saving SILPH!","I will never forget you saved us in our moment of peril!","I have to thank you in some way!","Because I am rich, I can give you anything!","Here, maybe this will do!"},s=1}},{x=10,y=5,s=15,m="STAY",d="DOWN",t={k="text",p={"SECRETARY: Thank you for rescuing all of us!","We admire your courage."}}},{x=6,y=9,s=23,m="STAY",d="DOWN",opp={29,2},t={k="text",p={"Ah RED! So we meet again!","The PRESIDENT and I are discussing a vital business proposition.","Keep your nose out of grown-up matters...","Or, experience a world of pain!"}},story=1},{x=3,y=16,s=24,m="STAY",d="UP",opp={30,41},t={k="trainer",range=4,b={"Stop right there! Don't you move!"},e={"Don't... Please!"},a={"So, you want to see my BOSS?"}},story=1},{x=15,y=9,s=24,m="STAY",d="UP",opp={30,40},t={k="trainer",range=3,b={"Halt! Do you have an appointment with my BOSS?"},e={"Gaah! Demolished!"},a={"Watch your step, my BOSS likes his POKÃ©MON tough!"}},story=1}},wild=nil,hidden={{x=10,y=12,f="OpenPokemonCenterPC"}}}return {id=236,const="SILPH_CO_ELEVATOR",w=2,h=2,ts=18,border=15,conns={},warps={{1,3,237,1},{2,3,237,1}},signs={{x=3,y=0,t={k="none"}}},objs={},wild=nil,hidden={}}return {id=239,const="TRADE_CENTER",w=5,h=4,ts=21,border=14,conns={},warps={},signs={},objs={{x=2,y=2,s=1,m="STAY",d="ANY_DIR",t={k="text",p={"!"}}}},wild=nil,hidden={{x=5,y=4,f="CableClubRightGameboy"},{x=4,y=4,f="CableClubLeftGameboy"}}}return {id=24,const="ROUTE_13",w=30,h=9,ts=0,border=67,conns={{"north",23,20},{"west",25,0}},warps={},signs={{x=15,y=13,t={k="text",p={"TRAINER TIPS","Look to the left of that post!"}}},{x=33,y=5,t={k="text",p={"TRAINER TIPS","Use SELECT to switch items in the ITEM window!"}}},{x=31,y=11,t={k="text",p={"ROUTE 13 North to SILENCE BRIDGE"}}}},objs={{x=49,y=10,s=7,m="STAY",d="RIGHT",opp={23,1},t={k="trainer",range=2,b={"My bird POKÃ©MON want to scrap!"},e={"My bird combo lost?"},a={"My POKÃ©MON look happy even though they lost."}}},{x=48,y=10,s=6,m="STAY",d="DOWN",opp={6,12},t={k="trainer",range=2,b={"I'm told I'm good for a kid!"},e={"Ohh! I lost!"},a={"I want to become a good trainer. I'll train hard."}}},{x=27,y=9,s=6,m="STAY",d="DOWN",opp={6,13},t={k="trainer",range=2,b={"Wow! Your BADGEs are too cool!"},e={"Not enough!"},a={"You got those BADGEs from GYM LEADERs. I know!"}}},{x=23,y=10,s=6,m="STAY",d="LEFT",opp={6,14},t={k="trainer",range=2,b={"My cute POKÃ©MON wish to make your acquaintance."},e={"Wow! You totally won!"},a={"You have to make POKÃ©MON fight to toughen them up!"}}},{x=50,y=5,s=6,m="STAY",d="DOWN",opp={6,15},t={k="trainer",range=4,b={"I found CARBOS in a cave once."},e={"Just messed up!"},a={"CARBOS boosted the SPEED of my POKÃ©MON."}}},{x=12,y=4,s=7,m="STAY",d="RIGHT",opp={23,2},t={k="trainer",range=2,b={"The wind's blowing my way!"},e={"The wind turned!"},a={"I'm beat. I guess I'll FLY home."}}},{x=33,y=6,s=15,m="STAY",d="DOWN",opp={18,4},t={k="trainer",range=4,b={"Sure, I'll play with you!"},e={"Oh! You little brute!"},a={"I wonder which is stronger, male or female POKÃ©MON?"}}},{x=32,y=6,s=15,m="STAY",d="DOWN",opp={18,5},t={k="trainer",range=2,b={"Do you want to POKÃ©MON with me?"},e={"It's over already?"},a={"I don't know anything about POKÃ©MON. I just like cool ones!"}}},{x=10,y=7,s=18,m="STAY",d="UP",opp={10,1},t={k="trainer",range=2,b={"What're you lookin' at?"},e={"Dang! Stripped gears!"},a={"Get lost!"}}},{x=7,y=13,s=7,m="STAY",d="UP",opp={23,3},t={k="trainer",range=4,b={"I always go with bird POKÃ©MON!"},e={"Out of power!"},a={"I wish I could fly like PIDGEY and PIDGEOTTO..."}}}},wild={gr=20,g={{24,43},{25,16},{27,16},{24,48},{22,43},{26,48},{26,43},{25,132},{28,44},{30,44}},wr=0,w={}},hidden={{x=1,y=14,f="HiddenItems",item=79},{x=16,y=13,f="HiddenItems",item=39}}}return {id=240,const="COLOSSEUM",w=5,h=4,ts=21,border=14,conns={},warps={},signs={},objs={{x=2,y=2,s=1,m="STAY",d="ANY_DIR",t={k="text",p={"!"}}}},wild=nil,hidden={{x=5,y=4,f="CableClubRightGameboy"},{x=4,y=4,f="CableClubLeftGameboy"}}}return {id=245,const="LORELEIS_ROOM",w=5,h=6,ts=7,border=3,conns={},warps={{4,11,174,3},{5,11,174,3},{4,0,246,1},{5,0,246,2}},signs={},objs={{x=5,y=2,s=59,m="STAY",d="DOWN",opp={44,1},t={k="trainer",range=0,b={"Welcome to POKÃ©MON LEAGUE!","I am LORELEI of the ELITE FOUR!","No one can best me when it comes to icy POKÃ©MON!","Freezing moves are powerful!","Your POKÃ©MON will be at my mercy when they are frozen solid!","Hahaha! Are you ready?"},e={"How dare you!"},a={"You're better than I thought! Go on ahead!","You only got a taste of POKÃ©MON LEAGUE power!"}}}},wild=nil,hidden={}}return {id=246,const="BRUNOS_ROOM",w=5,h=6,ts=7,border=3,conns={},warps={{4,11,245,3},{5,11,245,4},{4,0,247,1},{5,0,247,2}},signs={},objs={{x=5,y=2,s=58,m="STAY",d="DOWN",opp={33,1},t={k="trainer",range=0,b={"I am BRUNO of the ELITE FOUR!","Through rigorous training, people and POKÃ©MON can become stronger!","I've weight trained with my POKÃ©MON!","RED!","We will grind you down with our superior power!","Hoo hah!"},e={"Why? How could I lose?"},a={"My job is done! Go face your next challenge!"}}}},wild=nil,hidden={}}return {id=247,const="AGATHAS_ROOM",w=5,h=6,ts=15,border=0,conns={},warps={{4,11,246,3},{5,11,246,4},{4,0,113,1},{5,0,113,1}},signs={},objs={{x=5,y=2,s=57,m="STAY",d="DOWN",opp={46,1},t={k="trainer",range=0,b={"I am AGATHA of the ELITE FOUR!","OAK's taken a lot of interest in you, child!","That old duff was once tough and handsome! That was decades ago!","Now he just wants to fiddle with his POKÃ©DEX! He's wrong! POKÃ©MON are for fighting!","RED! I'll show you how a real trainer fights!"},e={"Oh ho! You're something special, child!"},a={"You win! I see what the old duff sees in you now!","I have nothing else to say! Run along now, child!"}}}},wild=nil,hidden={}}return {id=25,const="ROUTE_14",w=10,h=27,ts=0,border=67,conns={{"west",26,18},{"east",24,0}},warps={},signs={{x=17,y=13,t={k="text",p={"ROUTE 14 West to FUCHSIA CITY"}}}},objs={{x=4,y=4,s=7,m="STAY",d="DOWN",opp={23,14},t={k="trainer",range=2,b={"You need to use TMs to teach good moves to POKÃ©MON!"},e={"Not good enough!"},a={"You have some HMs right? POKÃ©MON can't ever forget those moves."}}},{x=15,y=6,s=7,m="STAY",d="DOWN",opp={23,15},t={k="trainer",range=2,b={"My bird POKÃ©MON should be ready for battle."},e={"Not ready yet!"},a={"They need to learn better moves."}}},{x=12,y=11,s=7,m="STAY",d="DOWN",opp={23,16},t={k="trainer",range=4,b={"TMs are on sale in CELADON! But, only a few people have HMs!"},e={"Aww, bummer!"},a={"Teach POKÃ©MON moves of the same element type for more power."}}},{x=14,y=15,s=7,m="STAY",d="UP",opp={23,17},t={k="trainer",range=3,b={"Have you taught your bird POKÃ©MON how to FLY?"},e={"Shot down in flames!"},a={"Bird POKÃ©MON are my true love!"}}},{x=15,y=31,s=7,m="STAY",d="LEFT",opp={23,4},t={k="trainer",range=3,b={"Have you heard of the legendary POKÃ©MON?"},e={"Why? Why'd I lose?"},a={"The 3 legendary POKÃ©MON are all birds of prey."}}},{x=6,y=49,s=7,m="STAY",d="UP",opp={23,5},t={k="trainer",range=4,b={"I'm not into it, but OK! Let's go!"},e={"I knew it!"},a={"Winning, losing, it doesn't matter in the long run!"}}},{x=5,y=39,s=18,m="STAY",d="DOWN",opp={10,13},t={k="trainer",range=4,b={"C'mon, c'mon. Let's go, let's go, let's go!"},e={"Arrg! Lost! Get lost!"},a={"What, what, what? What do you want?"}}},{x=4,y=30,s=18,m="STAY",d="RIGHT",opp={10,14},t={k="trainer",range=4,b={"Perfect! I need to burn some time!"},e={"What? You!?"},a={"Raising POKÃ©MON is a drag, man."}}},{x=15,y=30,s=18,m="STAY",d="LEFT",opp={10,15},t={k="trainer",range=3,b={"We ride out here because there's more room!"},e={"Wipe out!"},a={"It's cool you made your POKÃ©MON so strong!","Might is right! And you know it!"}}},{x=4,y=31,s=18,m="STAY",d="RIGHT",opp={10,2},t={k="trainer",range=4,b={"POKÃ©MON fight? Cool! Rumble!"},e={"Blown away!"},a={"You know who'd win, you and me one on one!"}}}},wild={gr=15,g={{24,43},{26,16},{23,132},{24,48},{22,43},{26,48},{26,43},{30,44},{28,17},{30,17}},wr=0,w={}},hidden={}}return {id=26,const="ROUTE_15",w=30,h=9,ts=0,border=67,conns={{"west",7,-4},{"east",25,-18}},warps={{7,8,184,1},{7,9,184,2},{14,8,184,3},{14,9,184,4}},signs={{x=39,y=9,t={k="text",p={"ROUTE 15 West to FUCHSIA CITY"}}}},objs={{x=41,y=11,s=6,m="STAY",d="DOWN",opp={6,20},t={k="trainer",range=2,b={"Let me try out the POKÃ©MON I just got in a trade!"},e={"Not good enough!"},a={"You can't change the nickname of any POKÃ©MON you get in a trade.","Only the Original Trainer can."}}},{x=53,y=10,s=6,m="STAY",d="LEFT",opp={6,21},t={k="trainer",range=3,b={"You look gentle, so I think I can beat you!"},e={"No, wrong!"},a={"I'm afraid of BIKERs, they look so ugly and mean!"}}},{x=31,y=13,s=7,m="STAY",d="UP",opp={23,6},t={k="trainer",range=3,b={"When I whistle, I can summon bird POKÃ©MON!"},e={"Ow! That's tragic!"},a={"Maybe I'm not cut out for battles."}}},{x=35,y=13,s=7,m="STAY",d="UP",opp={23,7},t={k="trainer",range=3,b={"Hmm? My birds are shivering! You're good, aren't you?"},e={"Just as I thought!"},a={"Did you know moves like EARTHQUAKE don't have any effect on birds?"}}},{x=53,y=11,s=15,m="STAY",d="DOWN",opp={18,9},t={k="trainer",range=2,b={"Oh, you're a little cutie!"},e={"You looked so cute too!"},a={"I forgive you! I can take it!"}}},{x=41,y=10,s=15,m="STAY",d="RIGHT",opp={18,10},t={k="trainer",range=3,b={"I raise POKÃ©MON because I live alone!"},e={"I didn't ask for this!"},a={"I just like going home to be with my POKÃ©MON!"}}},{x=48,y=10,s=18,m="STAY",d="DOWN",opp={10,3},t={k="trainer",range=3,b={"Hey kid! C'mon! I just got these!"},e={"Why not?"},a={"You only live once, so I live as an outlaw! TEAM ROCKET RULES!"}}},{x=46,y=10,s=18,m="STAY",d="DOWN",opp={10,4},t={k="trainer",range=3,b={"Fork over all your cash when you lose to me, kid!"},e={"That can't be true!"},a={"I was just joking about the money!"}}},{x=37,y=5,s=6,m="STAY",d="RIGHT",opp={6,22},t={k="trainer",range=3,b={"What's cool? Trading POKÃ©MON!"},e={"I said trade!"},a={"I trade POKÃ©MON with my friends!"}}},{x=18,y=13,s=6,m="STAY",d="UP",opp={6,23}},{x=18,y=5,s=61,m="STAY",d="NONE",item=126,story=1}},wild={gr=15,g={{24,43},{26,132},{23,16},{26,48},{22,43},{28,48},{26,43},{30,44},{28,17},{30,17}},wr=0,w={}},hidden={}}return {id=27,const="ROUTE_16",w=20,h=9,ts=0,border=15,conns={{"south",28,0},{"east",6,-4}},warps={{17,10,186,1},{17,11,186,2},{24,10,186,3},{24,11,186,4},{17,4,186,5},{17,5,186,6},{24,4,186,7},{24,5,186,8},{7,5,188,1}},signs={{x=27,y=11,t={k="text",p={"Enjoy the slope! CYCLING ROAD"}}},{x=5,y=17,t={k="text",p={"ROUTE 16 CELADON CITY - FUCHSIA CITY"}}}},objs={{x=17,y=12,s=18,m="STAY",d="LEFT",opp={10,5},t={k="trainer",range=3,b={"What do you want?"},e={"Don't you dare laugh!"},a={"We like just hanging here, what's it to you?"}}},{x=14,y=13,s=18,m="STAY",d="RIGHT",opp={16,1},t={k="trainer",range=2,b={"Nice BIKE! Hand it over!"},e={"Knock out!"},a={"Forget it, who needs your BIKE!"}}},{x=11,y=12,s=18,m="STAY",d="UP",opp={16,2},t={k="trainer",range=2,b={"Come out and play, little mouse!"},e={"You little rat!"},a={"I hate losing! Get away from me!"}}},{x=9,y=11,s=18,m="STAY",d="LEFT",opp={10,6},t={k="trainer",range=2,b={"Hey, you just bumped me!"},e={"Kaboom!"},a={"You can also get to FUCHSIA from VERMILION using a coastal road."}}},{x=6,y=10,s=18,m="STAY",d="RIGHT",opp={16,3},t={k="trainer",range=2,b={"I'm feeling hungry and mean!"},e={"Bad, bad, bad!"},a={"I like my POKÃ©MON ferocious! They tear up enemies!"}}},{x=3,y=12,s=18,m="STAY",d="RIGHT",opp={10,7},t={k="trainer",range=4,b={"Sure, I'll go!"},e={"Don't make me mad!"},a={"I like harassing people with my vicious POKÃ©MON!"}}},{x=26,y=10,s=67,m="STAY",d="DOWN",t={k="text",p={"A sleeping POKÃ©MON blocks the way!"}},story=1}},wild={gr=25,g={{20,21},{22,21},{18,19},{20,84},{20,19},{18,84},{22,84},{22,19},{23,20},{25,20}},wr=0,w={}},hidden={}}return {id=28,const="ROUTE_17",w=10,h=72,ts=0,border=67,conns={{"north",27,0},{"south",29,0}},warps={},signs={{x=9,y=51,t={k="text",p={"It's a notice!","Watch out for discarded items!"}}},{x=9,y=63,t={k="text",p={"TRAINER TIPS","All POKÃ©MON are unique.","Even POKÃ©MON of the same type and level grow at different rates."}}},{x=9,y=75,t={k="text",p={"TRAINER TIPS","Press the A or B Button to stay in place while on a slope."}}},{x=9,y=87,t={k="text",p={"ROUTE 17 CELADON CITY - FUCHSIA CITY"}}},{x=9,y=111,t={k="text",p={"It's a notice!","Don't throw the game, throw POKÃ© BALLs instead!"}}},{x=9,y=141,t={k="text",p={"CYCLING ROAD Slope ends here!"}}}},objs={{x=12,y=19,s=18,m="STAY",d="LEFT",opp={16,4},t={k="trainer",range=3,b={"There's no money in fighting kids!"},e={"Burned out!"},a={"Good stuff is lying around on CYCLING ROAD!"}}},{x=11,y=16,s=18,m="STAY",d="RIGHT",opp={16,5},t={k="trainer",range=4,b={"What do you want, kiddo?"},e={"Whoo!"},a={"I could belly- bump you outta here!"}}},{x=4,y=18,s=18,m="STAY",d="UP",opp={10,8},t={k="trainer",range=4,b={"You heading to FUCHSIA?"},e={"Crash and burn!"},a={"I love racing downhill!"}}},{x=7,y=32,s=18,m="STAY",d="LEFT",opp={10,9},t={k="trainer",range=4,b={"We're BIKERs! Highway stars!"},e={"Smoked!"},a={"Are you looking for adventure?"}}},{x=14,y=34,s=18,m="STAY",d="RIGHT",opp={10,10},t={k="trainer",range=3,b={"Let VOLTORB electrify you!"},e={"Grounded out!"},a={"I got my VOLTORB at the abandoned POWER PLANT."}}},{x=17,y=58,s=18,m="STAY",d="LEFT",opp={16,6},t={k="trainer",range=2,b={"My POKÃ©MON won't evolve! Why?"},e={"Why, you!"},a={"Maybe some POKÃ©MON need element STONEs to evolve."}}},{x=2,y=68,s=18,m="STAY",d="RIGHT",opp={16,7},t={k="trainer",range=4,b={"I need a little exercise!"},e={"Whew! Good workout!"},a={"I'm sure I lost weight there!"}}},{x=14,y=98,s=18,m="STAY",d="RIGHT",opp={16,8},t={k="trainer",range=2,b={"Be a rebel!"},e={"Aaaargh!"},a={"Be ready to fight for your beliefs!"}}},{x=5,y=98,s=18,m="STAY",d="LEFT",opp={10,11},t={k="trainer",range=3,b={"Nice BIKE! How's it handle?"},e={"Shoot!"},a={"The slope makes it hard to steer!"}}},{x=10,y=118,s=18,m="STAY",d="DOWN",opp={10,12},t={k="trainer",range=4,b={"Get lost kid! I'm bushed!"},e={"Are you satisfied?"},a={"I need to catch a few Zs!"}}}},wild={gr=25,g={{20,21},{22,21},{25,20},{24,84},{27,20},{26,84},{28,84},{29,20},{25,22},{27,22}},wr=0,w={}},hidden={{x=15,y=14,f="HiddenItems",item=40},{x=8,y=45,f="HiddenItems",item=16},{x=17,y=72,f="HiddenItems",item=79},{x=4,y=91,f="HiddenItems",item=54},{x=8,y=121,f="HiddenItems",item=83}}}return {id=29,const="ROUTE_18",w=25,h=9,ts=0,border=67,conns={{"north",28,0},{"east",7,-4}},warps={{33,8,190,1},{33,9,190,2},{40,8,190,3},{40,9,190,4}},signs={{x=43,y=7,t={k="text",p={"ROUTE 18 CELADON CITY - FUCHSIA CITY"}}},{x=33,y=5,t={k="text",p={"CYCLING ROAD No pedestrians permitted!"}}}},objs={{x=36,y=11,s=7,m="STAY",d="RIGHT",opp={23,8},t={k="trainer",range=3,b={"I always check every grassy area for new POKÃ©MON."},e={"Tch!"},a={"I wish I had a BIKE!"}}},{x=40,y=15,s=7,m="STAY",d="LEFT",opp={23,9},t={k="trainer",range=3,b={"Kurukkoo! How do you like my bird call?"},e={"I had to bug you!"},a={"I also collect sea POKÃ©MON on weekends!"}}},{x=42,y=13,s=7,m="STAY",d="LEFT",opp={23,10},t={k="trainer",range=4,b={"This is my turf! Get out of here!"},e={"Darn!"},a={"This is my fave POKÃ©MON hunting area!"}}}},wild={gr=25,g={{20,21},{22,21},{25,20},{24,84},{25,22},{26,84},{28,84},{29,20},{27,22},{29,22}},wr=0,w={}},hidden={}}return {id=3,const="CERULEAN_CITY",w=20,h=18,ts=0,border=15,conns={{"north",35,5},{"south",16,5},{"west",15,4},{"east",20,4}},warps={{27,11,62,1},{13,15,63,1},{19,17,64,1},{30,19,65,1},{13,25,66,1},{25,25,67,1},{4,11,228,1},{27,9,62,3},{9,11,230,2},{9,9,230,1}},signs={{x=23,y=19,t={k="text",p={"CERULEAN CITY A Mysterious, Blue Aura Surrounds It"}}},{x=17,y=29,t={k="text",p={"TRAINER TIPS","Pressing B Button during evolution cancels the whole process."}}},{x=26,y=25,t={k="none"}},{x=20,y=17,t={k="none"}},{x=11,y=25,t={k="text",p={"Grass and caves handled easily! BIKE SHOP"}}},{x=27,y=21,t={k="text",p={"CERULEAN CITY POKÃ©MON GYM LEADER: MISTY","The Tomboyish Mermaid!"}}}},objs={{x=20,y=2,s=2,m="STAY",d="DOWN",t={k="text",p={"BLUE: Yo! RED!","You're still struggling along back here?","I'm doing great! I caught a bunch of strong and smart POKÃ©MON!","Here, let me see what you caught, RED!"},s=1},hide=1},{x=30,y=8,s=24,m="STAY",d="NONE",opp={30,5},t={k="text",p={"Hey! Stay out! It's not your yard! Huh? Me?","I'm an innocent bystander! Don't you believe me?"},s=1},story=1},{x=31,y=20,s=7,m="STAY",d="DOWN",t={k="text",p={"You're a trainer too? Collecting, fighting, it's a tough life."}}},{x=15,y=18,s=12,m="WALK",d="UP_DOWN",t={k="text",p={"That bush in front of the shop is in the way.","There might be a way around."}}},{x=9,y=21,s=12,m="WALK",d="LEFT_RIGHT",t={k="text",p={"You're making an encyclopedia on POKÃ©MON? That sounds amusing."}}},{x=28,y=12,s=49,m="STAY",d="DOWN",t={k="text",p={"The people here were robbed.","It's obvious that TEAM ROCKET is behind this most heinous crime!","Even our POLICE force has trouble with the ROCKETs!"}},hide=1},{x=29,y=26,s=6,m="STAY",d="LEFT",t={k="text",p={"OK! SLOWBRO! Use SONICBOOM! Come on, SLOWBRO pay attention!"},s=1}},{x=28,y=26,s=5,m="STAY",d="DOWN",t={k="text",p={"SLOWBRO took a snooze..."},s=1}},{x=9,y=27,s=6,m="WALK",d="LEFT_RIGHT",t={k="text",p={"I want a bright red BICYCLE!","I'll keep it at home, so it won't get dirty!"}}},{x=4,y=12,s=12,m="STAY",d="DOWN",t={k="text",p={"This is CERULEAN CAVE! Horribly strong POKÃ©MON live in there!","The POKÃ©MON LEAGUE champion is the only person who is allowed in!"}},story=1},{x=27,y=12,s=49,m="STAY",d="DOWN",t={k="text",p={"The people here were robbed.","It's obvious that TEAM ROCKET is behind this most heinous crime!","Even our POLICE force has trouble with the ROCKETs!"}},story=1}},wild=nil,hidden={{x=15,y=8,f="HiddenItems",item=40}}}return {id=30,const="ROUTE_19",w=10,h=27,ts=0,border=67,conns={{"north",7,-5},{"west",31,18}},warps={},signs={{x=11,y=9,t={k="text",p={"SEA ROUTE 19 FUCHSIA CITY - SEAFOAM ISLANDS"}}}},objs={{x=8,y=7,s=7,m="STAY",d="LEFT",opp={15,2},t={k="trainer",range=4,b={"Have to warm up before my swim!"},e={"All warmed up!"},a={"Thanks, kid! I'm ready for a swim!"}}},{x=13,y=7,s=7,m="STAY",d="LEFT",opp={15,3},t={k="trainer",range=3,b={"Wait! You'll have a heart attack!"},e={"Ooh! That's chilly!"},a={"Watch out for TENTACOOL!"}}},{x=13,y=25,s=34,m="STAY",d="LEFT",opp={15,4},t={k="trainer",range=3,b={"I love swimming! What about you?"},e={"Belly flop!"},a={"I can beat POKÃ©MON at swimming!"}}},{x=4,y=27,s=34,m="STAY",d="RIGHT",opp={15,5},t={k="trainer",range=4,b={"What's beyond the horizon?"},e={"Glub!"},a={"I see a couple of islands!"}}},{x=16,y=31,s=34,m="STAY",d="UP",opp={15,6},t={k="trainer",range=4,b={"I tried diving for POKÃ©MON, but it was a no go!"},e={"Help!"},a={"You have to fish for sea POKÃ©MON!"}}},{x=9,y=11,s=34,m="STAY",d="DOWN",opp={15,7},t={k="trainer",range=4,b={"I look at the sea to forget!"},e={"Ooh! Traumatic!"},a={"I'm looking at the sea to forget!"}}},{x=8,y=43,s=34,m="STAY",d="LEFT",opp={18,12},t={k="trainer",range=3,b={"Oh, I just love your ride! Can I have it if I win?"},e={"Oh! I lost!"},a={"It's still a long way to go to SEAFOAM ISLANDS."}}},{x=11,y=43,s=34,m="STAY",d="RIGHT",opp={18,13},t={k="trainer",range=4,b={"Swimming's great! Sunburns aren't!"},e={"Shocker!"},a={"My boy friend wanted to swim to SEAFOAM ISLANDS."}}},{x=9,y=42,s=34,m="STAY",d="UP",opp={15,8},t={k="trainer",range=4,b={"These waters are treacherous!"},e={"Ooh! Dangerous!"},a={"I got a cramp! Glub, glub..."}}},{x=10,y=44,s=34,m="STAY",d="DOWN",opp={18,14},t={k="trainer",range=4,b={"I swam here, but I'm tired."},e={"I'm exhausted..."},a={"LAPRAS is so big, it must keep you dry on water."}}}},wild={gr=0,g={},wr=5,w={{5,72},{10,72},{15,72},{5,72},{10,72},{15,72},{20,72},{30,72},{35,72},{40,72}}},hidden={}}return {id=31,const="ROUTE_20",w=50,h=9,ts=0,border=67,conns={{"west",8,0},{"east",30,-18}},warps={{48,5,192,1},{58,9,192,3}},signs={{x=51,y=7,t={k="text",p={"SEAFOAM ISLANDS"}}},{x=57,y=11,t={k="text",p={"SEAFOAM ISLANDS"}}}},objs={{x=87,y=8,s=34,m="STAY",d="UP",opp={15,9},t={k="trainer",range=4,b={"The water is shallow here."},e={"Splash!"},a={"I wish I could ride my POKÃ©MON."}}},{x=68,y=11,s=34,m="STAY",d="UP",opp={18,15},t={k="trainer",range=4,b={"SEAFOAM is a quiet getaway!"},e={"Quit it!"},a={"There's a huge cavern underneath this island."}}},{x=45,y=10,s=34,m="STAY",d="DOWN",opp={18,6},t={k="trainer",range=2,b={"I love floating with the fishes!"},e={"Yowch!"},a={"Want to float with me?"}}},{x=55,y=14,s=34,m="STAY",d="RIGHT",opp={6,24},t={k="trainer",range=4,b={"Are you on vacation too?"},e={"No mercy at all!"},a={"SEAFOAM used to be one island!"}}},{x=38,y=13,s=34,m="STAY",d="DOWN",opp={15,10},t={k="trainer",range=3,b={"Check out my buff physique!"},e={"Wimpy!"},a={"I should've been buffing up my POKÃ©MON, not me!"}}},{x=87,y=13,s=34,m="STAY",d="UP",opp={15,11},t={k="trainer",range=4,b={"Why are you riding a POKÃ©MON? Can't you swim?"},e={"Ouch! Torpedoed!"},a={"Riding a POKÃ©MON sure looks fun!"}}},{x=34,y=9,s=7,m="STAY",d="UP",opp={23,11},t={k="trainer",range=2,b={"I rode my bird POKÃ©MON here!"},e={"Oh no!"},a={"My birds can't FLY me back!"}}},{x=25,y=7,s=34,m="STAY",d="UP",opp={18,7},t={k="trainer",range=4,b={"My boy friend gave me big pearls!"},e={"Don't touch my pearls!"},a={"Will my pearls grow bigger inside CLOYSTER?"}}},{x=24,y=12,s=34,m="STAY",d="DOWN",opp={6,16},t={k="trainer",range=3,b={"I swam here from CINNABAR ISLAND!"},e={"I'm so disappointed!"},a={"POKÃ©MON have taken over an abandoned mansion on CINNABAR!"}}},{x=15,y=8,s=34,m="STAY",d="UP",opp={18,8},t={k="trainer",range=4,b={"CINNABAR, in the west, has a LAB for POKÃ©MON."},e={"Wait!"},a={"CINNABAR is a volcanic island!"}}}},wild={gr=0,g={},wr=5,w={{5,72},{10,72},{15,72},{5,72},{10,72},{15,72},{20,72},{30,72},{35,72},{40,72}}},hidden={}}return {id=32,const="ROUTE_21",w=10,h=45,ts=0,border=67,conns={{"north",0,0},{"south",8,0}},warps={},signs={},objs={{x=4,y=24,s=47,m="STAY",d="LEFT",opp={14,7},t={k="trainer",range=0,b={"You want to know if the fish are biting?"},e={"Dang!"},a={"I can't catch anything good!"}}},{x=6,y=25,s=47,m="STAY",d="DOWN",opp={14,9},t={k="trainer",range=0,b={"I got a big haul! Wanna go for it?"},e={"Darn MAGIKARP!"},a={"I seem to only catch MAGIKARP!"}}},{x=10,y=31,s=34,m="STAY",d="UP",opp={15,12},t={k="trainer",range=4,b={"The sea cleanses my body and soul!"},e={"Ayah!"},a={"I like the mountains too!"}}},{x=12,y=30,s=34,m="STAY",d="RIGHT",opp={16,9},t={k="trainer",range=4,b={"What's wrong with me swimming?"},e={"Cheap shot!"},a={"I look like what? A studded inner tube? Get lost!"}}},{x=16,y=63,s=34,m="STAY",d="DOWN",opp={15,13},t={k="trainer",range=4,b={"I caught all my POKÃ©MON at sea!"},e={"Diver!! Down!!"},a={"Where'd you catch your POKÃ©MON?"}}},{x=5,y=71,s=34,m="STAY",d="RIGHT",opp={15,14},t={k="trainer",range=4,b={"Right now, I'm in a triathlon meet!"},e={"Pant... pant...pant..."},a={"I'm beat! But, I still have the bike race and marathon left!"}}},{x=15,y=71,s=34,m="STAY",d="LEFT",opp={15,15},t={k="trainer",range=3,b={"Ahh! Feel the sun and the wind!"},e={"Yow! I lost!"},a={"I'm sunburnt to a crisp!"}}},{x=14,y=56,s=47,m="STAY",d="LEFT",opp={14,8},t={k="trainer",range=0,b={"Hey, don't scare away the fish!"},e={"Sorry! I didn't mean it!"},a={"I was just angry that I couldn't catch anything."}}},{x=17,y=57,s=47,m="STAY",d="RIGHT",opp={14,10},t={k="trainer",range=0,b={"Keep me company 'til I get a hit!"},e={"That burned some time."},a={"Oh wait! I got a bite! Yeah!"}}}},wild={gr=25,g={{21,19},{23,16},{30,20},{23,19},{21,16},{30,17},{32,17},{28,114},{30,114},{32,114}},wr=5,w={{5,72},{10,72},{15,72},{5,72},{10,72},{15,72},{20,72},{30,72},{35,72},{40,72}}},hidden={}}return {id=33,const="ROUTE_22",w=20,h=9,ts=0,border=44,conns={{"north",34,0},{"east",1,-4}},warps={{8,5,193,1}},signs={{x=7,y=11,t={k="text",p={"POKÃ©MON LEAGUE Front Gate"}}}},objs={{x=25,y=5,s=2,m="STAY",d="NONE",t={k="text",p={"I heard POKÃ©MON LEAGUE has many tough trainers!","I have to figure out how to get past them!","You should quit dawdling and get a move on!"},s=1},hide=1},{x=25,y=5,s=2,m="STAY",d="NONE",t={k="text",p={"That loosened me up! I'm ready for POKÃ©MON LEAGUE!","RED, you need more practice!","But hey, you know that! I'm out of here. Smell ya!"},s=1},hide=1}},wild={gr=25,g={{3,19},{3,32},{4,19},{4,32},{2,19},{2,32},{3,21},{5,21},{3,29},{4,29}},wr=0,w={}},hidden={}}return {id=34,const="ROUTE_23",w=10,h=72,ts=23,border=15,conns={{"north",9,0},{"south",33,0}},warps={{7,139,193,3},{8,139,193,4},{4,31,108,1},{14,31,194,2}},signs={{x=3,y=33,t={k="tex
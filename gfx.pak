{{x=13,y=13,t={k="text",p={"OAK POKÃ©MON RESEARCH LAB"}}},{x=7,y=9,t={k="text",p={"PALLET TOWN Shades of your journey await!"}}},{x=3,y=5,t={k="text",p={"RED's house"}}},{x=11,y=5,t={k="text",p={"BLUE's house"}}}},objs={{x=8,y=5,s=3,m="STAY",d="NONE",t={k="text",p={"OAK: Hey! Wait! Don't go out!"},s=1},hide=1},{x=3,y=8,s=13,m="WALK",d="ANY_DIR",t={k="text",p={"I'm raising POKÃ©MON too!","When they get strong, they can protect me!"}}},{x=11,y=14,s=47,m="WALK",d="ANY_DIR",t={k="text",p={"Technology is incredible!","You can now store and recall items and POKÃ©MON as data via PC!"}}}},wild=nil,hidden={}}return {id=1,const="VIRIDIAN_CITY",w=20,h=18,ts=0,border=15,conns={{"north",13,5},{"south",12,5},{"west",33,4}},warps={{23,25,41,1},{29,19,42,1},{21,15,43,1},{21,9,44,1},{32,7,45,1}},signs={{x=17,y=17,t={k="text",p={"VIRIDIAN CITY The Eternally Green Paradise"}}},{x=19,y=1,t={k="text",p={"TRAINER TIPS","Catch POKÃ©MON and expand your collection!","The more you have, the easier it is to fight!"}}},{x=21,y=29,t={k="text",p={"TRAINER TIPS","The battle moves of POKÃ©MON are limited by their POWER POINTs, PP.","To replenish PP, rest your tired POKÃ©MON at a POKÃ©MON CENTER!"}}},{x=30,y=19,t={k="none"}},{x=24,y=25,t={k="none"}},{x=27,y=7,t={k="text",p={"VIRIDIAN CITY POKÃ©MON GYM"}}}},objs={{x=13,y=20,s=4,m="WALK",d="ANY_DIR",t={k="text",p={"Those POKÃ© BALLs at your waist! You have POKÃ©MON!","It's great that you can carry and use POKÃ©MON any time, anywhere!"}}},{x=30,y=8,s=11,m="STAY",d="NONE",t={k="text",p={"This POKÃ©MON GYM is always closed.","I wonder who the LEADER is?"},s=1}},{x=30,y=25,s=4,m="WALK",d="ANY_DIR",t={k="text",p={"You want to know about the 2 kinds of caterpillar POKÃ©MON?"},s=1}},{x=17,y=9,s=13,m="STAY",d="RIGHT",t={k="text",p={"Oh Grandpa! Don't be so mean! He hasn't had his coffee yet."},s=1}},{x=18,y=9,s=72,m="STAY",d="NONE",t={k="text",p={"You can't go through here!","This is private property!"},s=1},story=1},{x=6,y=23,s=47,m="STAY",d="DOWN",t={k="text",p={"Yawn! I must have dozed off in the sun.","I had this dream about a DROWZEE eating my dream. What's this? Where did this TM come from?","This is spooky! Here, you can have this TM."},s=1}},{x=17,y=5,s=11,m="WALK",d="LEFT_RIGHT",t={k="text",p={"Ahh, I've had my coffee now and I feel great!","Sure you can go through!","Are you in a hurry?"},s=1},hide=1}},wild=nil,hidden={{x=14,y=4,f="HiddenItems",item=20}}}return {id=10,const="SAFFRON_CITY",w=20,h=18,ts=0,border=15,conns={{"north",16,5},{"south",17,5},{"west",18,4},{"east",19,4}},warps={{7,5,175,1},{26,3,177,1},{34,3,178,1},{13,11,179,1},{25,11,180,1},{18,21,181,1},{9,29,182,1},{29,29,183,1}},signs={{x=17,y=5,t={k="text",p={"SAFFRON CITY Shining, Golden Land of Commerce"}}},{x=27,y=5,t={k="text",p={"FIGHTING DOJO"}}},{x=35,y=5,t={k="text",p={"SAFFRON CITY POKÃ©MON GYM LEADER: SABRINA","The Master of Psychic POKÃ©MON!"}}},{x=26,y=11,t={k="none"}},{x=39,y=19,t={k="text",p={"TRAINER TIPS","FULL HEAL cures all ailments like sleep and burns.","It costs a bit more, but it's more convenient."}}},{x=5,y=21,t={k="text",p={"TRAINER TIPS","New GREAT BALL offers improved capture rates.","Try it on those hard-to-catch POKÃ©MON."}}},{x=15,y=21,t={k="text",p={"SILPH CO. OFFICE BUILDING"}}},{x=10,y=29,t={k="none"}},{x=27,y=29,t={k="text",p={"MR.PSYCHIC's HOUSE"}}},{x=1,y=19,t={k="text",p={"SILPH's latest product!","Release to be determined..."}}}},objs={{x=7,y=6,s=24,m="STAY",d="NONE",t={k="text",p={"What do you want? Get lost!"}},story=1},{x=20,y=8,s=24,m="WALK",d="LEFT_RIGHT",t={k="text",p={"BOSS said he'll take this town!"}},story=1},{x=34,y=4,s=24,m="STAY",d="NONE",t={k="text",p={"Get out of the way!"}},story=1},{x=13,y=12,s=24,m="STAY",d="NONE",t={k="text",p={"SAFFRON belongs to TEAM ROCKET!"}},story=1},{x=11,y=25,s=24,m="WALK",d="LEFT_RIGHT",t={k="text",p={"Being evil makes me feel so alive!"}},story=1},{x=32,y=13,s=24,m="WALK",d="LEFT_RIGHT",t={k="text",p={"Ow! Watch where you're walking!"}},story=1},{x=18,y=30,s=24,m="WALK",d="LEFT_RIGHT",t={k="text",p={"With SILPH under control, we can exploit POKÃ©MON around the world!"}},story=1},{x=8,y=14,s=32,m="WALK",d="ANY_DIR",t={k="text",p={"You beat TEAM ROCKET all alone? That's amazing!"}},hide=1},{x=23,y=23,s=44,m="STAY",d="NONE",t={k="text",p={"Yeah! TEAM ROCKET is gone! It's safe to go out again!"}},hide=1},{x=17,y=30,s=27,m="WALK",d="LEFT_RIGHT",t={k="text",p={"People should be flocking back to SAFFRON now."}},hide=1},{x=30,y=12,s=16,m="STAY",d="DOWN",t={k="text",p={"I flew here on my PIDGEOT when I read about SILPH.","It's already over? I missed the media action."}},hide=1},{x=31,y=12,s=9,m="STAY",d="DOWN",t={k="text",p={"PIDGEOT: Bi bibii!"}},hide=1},{x=18,y=8,s=33,m="STAY",d="UP",t={k="text",p={"I saw ROCKET BOSS escaping SILPH's building."}},hide=1},{x=18,y=22,s=24,m="STAY",d="DOWN",t={k="text",p={"I'm a security guard.","Suspicious kids I don't allow in!"}},story=1},{x=19,y=22,s=24,m="STAY",d="DOWN",t={k="text",p={"... Snore...","Hah! He's taking a snooze!"}},hide=1}},wild=nil,hidden={}}return {id=100,const="SS_ANNE_KITCHEN",w=7,h=8,ts=13,border=12,conns={},warps={{6,0,95,11}},signs={},objs={{x=1,y=8,s=20,m="WALK",d="UP_DOWN",t={k="text",p={"You, mon petit! We're busy here! Out of the way!"}}},{x=5,y=8,s=20,m="WALK",d="UP_DOWN",t={k="text",p={"I saw an odd ball in the trash."}}},{x=9,y=7,s=20,m="WALK",d="UP_DOWN",t={k="text",p={"I'm so busy I'm getting dizzy!"}}},{x=13,y=6,s=20,m="STAY",d="NONE",t={k="text",p={"Hum-de-hum-de- ho...","I peel spuds every day! Hum-hum..."}}},{x=13,y=8,s=20,m="STAY",d="NONE",t={k="text",p={"Did you hear about SNORLAX?","All it does is eat and sleep!"}}},{x=13,y=10,s=20,m="STAY",d="NONE",t={k="text",p={"Snivel...Sniff...","I only get to peel onions... Snivel..."}}},{x=11,y=13,s=20,m="STAY",d="UP",t={k="text",p={"Er-hem! Indeed I am le CHEF!","Le main course is"},s=1}}},wild=nil,hidden={{x=13,y=5,f="PrintTrashText"},{x=13,y=7,f="PrintTrashText"},{x=13,y=9,f="HiddenItems",item=3}}}return {id=101,const="SS_ANNE_CAPTAINS_ROOM",w=3,h=4,ts=13,border=12,conns={},warps={{0,7,96,9}},signs={{x=4,y=1,t={k="text",p={"Yuck! Shouldn't have looked!"}}},{x=1,y=2,t={k="text",p={"How to Conquer Seasickness... The CAPTAIN's reading this!"}}}},objs={{x=4,y=2,s=46,m="STAY",d="UP",t={k="text",p={"CAPTAIN: Ooargh... I feel hideous... Urrp! Seasick...","RED rubbed the CAPTAIN's back!","Rub-rub... Rub-rub..."},s=1}}},wild=nil,hidden={}}return {id=102,const="SS_ANNE_1F_ROOMS",w=12,h=8,ts=13,border=12,conns={},warps={{0,0,95,3},{10,0,95,4},{20,0,95,5},{0,10,95,6},{10,10,95,7},{20,10,95,8}},signs={},objs={{x=2,y=3,s=16,m="STAY",d="LEFT",opp={41,1},t={k="trainer",range=2,b={"I travel alone on my journeys!","My POKÃ©MON are my only friends!"},e={"My, my friends..."},a={"You should be nice to friends!"}}},{x=11,y=4,s=16,m="STAY",d="UP",opp={41,2},t={k="trainer",range=3,b={"You pup! How dare you barge in!"},e={"Humph! You rude child!"},a={"I wish to be left alone! Get out!"}}},{x=11,y=14,s=4,m="STAY",d="UP",opp={1,8},t={k="trainer",range=2,b={"I love POKÃ©MON! Do you?"},e={"Wow! You're great!"},a={"Let me be your friend, OK?","Then we can trade POKÃ©MON!"}}},{x=13,y=11,s=6,m="STAY",d="LEFT",opp={3,11},t={k="trainer",range=2,b={"I collected these POKÃ©MON from all around the world!"},e={"Oh no! I went around the world for these!"},a={"You hurt my poor worldly POKÃ©MON!","I demand that you heal them at a POKÃ©MON CENTER!"}}},{x=22,y=3,s=13,m="WALK",d="UP_DOWN",t={k="text",p={"Waiter, I would like a cherry pie please!"}}},{x=0,y=14,s=10,m="STAY",d="NONE",t={k="text",p={"A cruise is so elegant yet cozy!"}}},{x=2,y=11,s=8,m="STAY",d="DOWN",t={k="text",p={"I always travel with WIGGLYTUFF!"}}},{x=3,y=11,s=56,m="STAY",d="DOWN",t={k="text",p={"WIGGLYTUFF: Puup pupuu!"}}},{x=10,y=13,s=13,m="STAY",d="RIGHT",t={k="text",p={"We are cruising around the world."}}},{x=12,y=15,s=61,m="STAY",d="NONE",item=114,story=1},{x=21,y=13,s=16,m="WALK",d="LEFT_RIGHT",t={k="text",p={"Ssh! I'm a GLOBAL POLICE agent!","I'm on the trail of TEAM ROCKET!"}}}},wild=nil,hidden={}}return {id=103,const="SS_ANNE_2F_ROOMS",w=12,h=8,ts=13,border=12,conns={},warps={{2,5,96,1},{3,5,96,1},{12,5,96,2},{13,5,96,2},{22,5,96,3},{23,5,96,3},{2,15,96,4},{3,15,96,4},{12,15,96,5},{13,15,96,5},{22,15,96,6},{23,15,96,6}},signs={},objs={{x=10,y=2,s=16,m="STAY",d="RIGHT",opp={41,3},t={k="trainer",range=2,b={"Competing against the young keeps me youthful."},e={"Good fight! Ah, I feel young again!"},a={"15 years ago, I would have won!"}}},{x=13,y=4,s=47,m="STAY",d="LEFT",opp={14,1},t={k="trainer",range=3,b={"Check out what I fished up!"},e={"I'm all out!"},a={"Party?","The cruise ship's party should be over by now."}}},{x=0,y=14,s=16,m="STAY",d="RIGHT",opp={41,5},t={k="trainer",range=3,b={"Which do you like, a strong or a rare POKÃ©MON?"},e={"I must salute you!"},a={"I prefer strong and rare POKÃ©MON."}}},{x=2,y=11,s=6,m="STAY",d="DOWN",opp={3,12},t={k="trainer",range=2,b={"I never saw you at the party."},e={"Take it easy!"},a={"Oh, I adore your strong POKÃ©MON!"}}},{x=1,y=2,s=16,m="STAY",d="DOWN",t={k="text",p={"In all my travels I've never seen any POKÃ©MON sleep like this one!","It was something like this!"},s=1}},{x=12,y=1,s=61,m="STAY",d="NONE",item=81,story=1},{x=21,y=2,s=16,m="STAY",d="DOWN",t={k="text",p={"Ah yes, I have seen some POKÃ©MON ferry people across the water!"},s=1}},{x=22,y=1,s=37,m="STAY",d="DOWN",t={k="text",p={"POKÃ©MON can CUT down small bushes."},s=1}},{x=0,y=12,s=61,m="STAY",d="NONE",item=40,story=1},{x=12,y=12,s=16,m="STAY",d="DOWN",t={k="text",p={"Have you gone to the SAFARI ZONE in FUCHSIA CITY?","It had many rare kinds of POKÃ©MON!!"},s=1}},{x=11,y=14,s=53,m="STAY",d="NONE",t={k="text",p={"Me and my Daddy think the SAFARI ZONE is awesome!"},s=1}},{x=22,y=12,s=29,m="STAY",d="LEFT",t={k="text",p={"The CAPTAIN looked really sick and pale!"},s=1}},{x=20,y=12,s=15,m="STAY",d="RIGHT",t={k="text",p={"I hear many people get seasick!"},s=1}}},wild=nil,hidden={}}return {id=104,const="SS_ANNE_B1F_ROOMS",w=12,h=8,ts=13,border=12,conns={},warps={{2,5,98,5},{3,5,98,5},{12,5,98,4},{13,5,98,4},{22,5,98,3},{23,5,98,3},{2,15,98,2},{3,15,98,2},{12,15,98,1},{13,15,98,1}},signs={},objs={{x=0,y=13,s=19,m="STAY",d="DOWN",opp={4,3},t={k="trainer",range=2,b={"You know what they say about sailors and fighting!"},e={"Right! Good fight, mate!"},a={"Haha! Want to be a sailor, mate?"}}},{x=2,y=11,s=19,m="STAY",d="DOWN",opp={4,4},t={k="trainer",range=3,b={"My sailor's pride is at stake!"},e={"Your spirit sank me!"},a={"Did you see the FISHING GURU in VERMILION CITY?"}}},{x=12,y=3,s=19,m="STAY",d="LEFT",opp={4,5},t={k="trainer",range=2,b={"Us sailors have POKÃ©MON too!"},e={"OK, you're not bad."},a={"We caught all our POKÃ©MON while out at sea!"}}},{x=22,y=2,s=19,m="STAY",d="DOWN",opp={4,6},t={k="trainer",range=2,b={"I like feisty kids like you!"},e={"Argh! Lost it!"},a={"Sea POKÃ©MON live in deep water. You'll need a ROD!"}}},{x=0,y=2,s=19,m="STAY",d="RIGHT",opp={4,7},t={k="trainer",range=2,b={"Matey, you're walking the plank if you lose!"},e={"Argh! Beaten by a kid!"},a={"Jellyfish some- times drift into the ship."}}},{x=0,y=4,s=47,m="STAY",d="RIGHT",opp={14,2},t={k="trainer",range=3,b={"Hello stranger! Stop and chat!","All my POKÃ©MON are from the sea!"},e={"Darn! I let that one get away!"},a={"I was going to make you my assistant too!"}}},{x=10,y=13,s=12,m="STAY",d="RIGHT",t={k="text",p={"My buddy, MACHOKE, is super strong!","He has enough STRENGTH to move big rocks!"}}},{x=11,y=12,s=5,m="STAY",d="NONE",t={k="text",p={"MACHOKE: Gwoh! Goggoh!"}}},{x=20,y=2,s=61,m="STAY",d="NONE",item=80,story=1},{x=10,y=2,s=61,m="STAY",d="NONE",item=150,story=1},{x=12,y=11,s=61,m="STAY",d="NONE",item=17,story=1}},wild=nil,hidden={{x=3,y=1,f="HiddenItems",item=18}}}return {id=108,const="VICTORY_ROAD_1F",w=10,h=9,ts=17,border=125,conns={},warps={{8,17,255,3},{9,17,255,3},{1,1,194,1}},signs={},objs={{x=7,y=5,s=6,m="STAY",d="RIGHT",opp={32,5},t={k="trainer",range=2,b={"I wonder if you are good enough for me!"},e={"I lost out!"},a={"I never wanted to lose to anybody!"}}},{x=3,y=2,s=7,m="STAY",d="DOWN",opp={31,5},t={k="trainer",range=2,b={"I can see you're good! Let me see exactly how good!"},e={"I had a chance..."},a={"I concede, you're better than me!"}}},{x=11,y=0,s=61,m="STAY",d="NONE",item=149,story=1},{x=9,y=2,s=61,m="STAY",d="NONE",item=40,story=1},{x=5,y=15,s=63,m="STAY",d="BOULDER_MOVEMENT_BYTE_2"},{x=14,y=2,s=63,m="STAY",d="BOULDER_MOVEMENT_BYTE_2"},{x=2,y=10,s=63,m="STAY",d="BOULDER_MOVEMENT_BYTE_2"}},wild={gr=15,g={{24,66},{26,74},{22,41},{36,95},{39,95},{42,95},{41,75},{41,42},{42,67},{43,105}},wr=0,w={}},hidden={}}return {id=113,const="LANCES_ROOM",w=13,h=13,ts=5,border=3,conns={},warps={{24,16,247,3},{5,0,120,1},{6,0,120,1}},signs={},objs={{x=6,y=1,s=30,m="STAY",d="DOWN",opp={47,1},t={k="trainer",range=0,b={"Ah! I heard about you RED!","I lead the ELITE FOUR! You can call me LANCE the dragon trainer!","You know that dragons are mythical POKÃ©MON!","They're hard to catch and raise, but their powers are superior!","They're virtually indestructible!","Well, are you ready to lose?","Your LEAGUE challenge ends with me, RED!"},e={"That's it!","I hate to admit it, but you are a POKÃ©MON master!"},a={"I still can't believe my dragons lost to you, RED!","You are now the POKÃ©MON LEAGUE champion!","...Or, you would have been, but you have one more challenge ahead.","You have to face another trainer! His name is...","BLUE! He beat the ELITE FOUR before you!","He is the real POKÃ©MON LEAGUE champion!"}}}},wild=nil,hidden={}}return {id=118,const="HALL_OF_FAME",w=5,h=4,ts=7,border=3,conns={},warps={{4,7,120,3},{5,7,120,4}},signs={},objs={{x=5,y=2,s=3,m="STAY",d="DOWN",t={k="text",p={"OAK: Er-hem! Congratulations RED!","This floor is the POKÃ©MON HALL OF FAME!","POKÃ©MON LEAGUE champions are honored for their exploits here!","Their POKÃ©MON are also recorded in the HALL OF FAME!","RED! You have endeavored hard to become the new LEAGUE champion!","Congratulations, RED, you and your POKÃ©MON are HALL OF FAMERs!"}}}},wild=nil,hidden={}}return {id=119,const="UNDERGROUND_PATH_NORTH_SOUTH",w=4,h=24,ts=11,border=1,conns={},warps={{5,4,71,3},{2,41,74,3}},signs={},objs={},wild=nil,hidden={{x=3,y=4,f="HiddenItems",item=16},{x=4,y=34,f="HiddenItems",item=68}}}return {id=12,const="ROUTE_1",w=10,h=18,ts=0,border=11,conns={{"north",1,-5},{"south",0,0}},warps={},signs={{x=9,y=27,t={k="text",p={"ROUTE 1 PALLET TOWN - VIRIDIAN CITY"}}}},objs={{x=5,y=24,s=4,m="WALK",d="UP_DOWN",t={k="text",p={"Hi! I work at a POKÃ©MON MART.","It's a convenient shop, so please visit us in VIRIDIAN CITY.","I know, I'll give you a sample! Here you go!"},s=1}},{x=15,y=13,s=4,m="WALK",d="LEFT_RIGHT",t={k="text",p={"See those ledges along the road?","It's a bit scary, but you can jump from them.","You can get back to PALLET TOWN quicker that way."}}}},wild={gr=25,g={{3,16},{3,19},{3,19},{2,19},{2,16},{3,16},{3,16},{4,19},{4,16},{5,16}},wr=0,w={}},hidden={}}return {id=120,const="CHAMPIONS_ROOM",w=4,h=4,ts=7,border=3,conns={},warps={{3,7,113,2},{4,7,113,3},{3,0,118,1},{4,0,118,1}},signs={},objs={{x=4,y=2,s=2,m="STAY",d="DOWN",t={k="text",p={"BLUE: Hey!","I was looking forward to seeing you, RED!","My rival should be strong to keep me sharp!","While working on POKÃ©DEX, I looked all over for powerful POKÃ©MON!","Not only that, I assembled teams that would beat any POKÃ©MON type!","And now!","I'm the POKÃ©MON LEAGUE champion!","RED! Do you know what that means?","I'll tell you!","I am the most powerful trainer in the world!"},s=1}},{x=3,y=7,s=3,m="STAY",d="UP",t={k="text",p={"OAK: RED!"}},hide=1}},wild=nil,hidden={}}return {id=121,const="UNDERGROUND_PATH_WEST_EAST",w=25,h=4,ts=11,border=1,conns={},warps={{2,5,77,3},{47,2,80,3}},signs={},objs={},wild=nil,hidden={{x=12,y=2,f="HiddenItems",item=49},{x=21,y=5,f="HiddenItems",item=82}}}return {id=122,const="CELADON_MART_1F",w=10,h=4,ts=18,border=15,conns={},warps={{2,7,255,1},{3,7,255,1},{16,7,255,2},{17,7,255,2},{12,1,123,1},{1,1,127,1}},signs={{x=11,y=4,t={k="text",p={"1F: SERVICE COUNTER","2F: TRAINER'S MARKET","3F: TV GAME SHOP","4F: WISEMAN GIFTS","5F: DRUG STORE","ROOFTOP SQUARE: VENDING MACHINES"}}},{x=14,y=1,t={k="text",p={"1F: SERVICE COUNTER"}}}},objs={{x=8,y=3,s=42,m="STAY",d="DOWN",t={k="text",p={"Hello! Welcome to CELADON DEPT. STORE.","The board on the right describes the store layout."}}}},wild=nil,hidden={}}return {id=123,const="CELADON_MART_2F",w=10,h=4,ts=18,border=15,conns={},warps={{12,1,122,5},{16,1,124,2},{1,1,127,1}},signs={{x=14,y=1,t={k="text",p={"Top Grade Items for Trainers!","2F: TRAINER'S MARKET"}}}},objs={{x=5,y=3,s=38,m="STAY",d="DOWN",t={k="mart",items={3,19,53,56,11,12,13,14,15}}},{x=6,y=3,s=38,m="STAY",d="DOWN",t={k="mart",items={138,139,108,113,143,107,111,115,123}}},{x=19,y=5,s=10,m="STAY",d="NONE",t={k="text",p={"SUPER REPEL keeps weak POKÃ©MON at bay...","Hmm, it's a more powerful REPEL!"}}},{x=14,y=4,s=13,m="WALK",d="UP_DOWN",t={k="text",p={"For long outings, you should buy REVIVE."}}}},wild=nil,hidden={}}return {id=124,const="CELADON_MART_3F",w=10,h=4,ts=18,border=15,conns={},warps={{12,1,125,1},{16,1,123,2},{1,1,127,1}},signs={{x=2,y=4,t={k="text",p={"It's an SNES!"}}},{x=3,y=4,t={k="text",p={"An RPG! There's no time for that!"}}},{x=5,y=4,t={k="text",p={"It's an SNES!"}}},{x=6,y=4,t={k="text",p={"A sports game! Dad'll like that!"}}},{x=2,y=6,t={k="text",p={"It's an SNES!"}}},{x=3,y=6,t={k="text",p={"A puzzle game! Looks addictive!"}}},{x=5,y=6,t={k="text",p={"It's an SNES!"}}},{x=6,y=6,t={k="text",p={"A fighting game! Looks tough!"}}},{x=14,y=1,t={k="text",p={"3F: TV GAME SHOP"}}},{x=4,y=1,t={k="text",p={"Red and Blue! Both are POKÃ©MON!"}}},{x=6,y=1,t={k="text",p={"Red and Blue! Both are POKÃ©MON!"}}},{x=10,y=1,t={k="text",p={"Red and Blue! Both are POKÃ©MON!"}}}},objs={{x=16,y=5,s=38,m="STAY",d="NONE",t={k="text",p={"Oh, hi! I finally finished POKÃ©MON!","Not done yet? This might be useful!"},s=1}},{x=11,y=6,s=55,m="STAY",d="RIGHT",t={k="text",p={"Captured POKÃ©MON are registered with an ID No. and OT, the name of the Original Trainer that caught it!"}}},{x=7,y=2,s=55,m="STAY",d="DOWN",t={k="text",p={"All right!","My buddy's going to trade me his KANGASKHAN for my GRAVELER!"}}},{x=8,y=2,s=55,m="STAY",d="DOWN",t={k="text",p={"Come on GRAVELER!","I love GRAVELER! I collect them!","Huh?","GRAVELER turned into a different POKÃ©MON!"}}},{x=2,y=5,s=53,m="STAY",d="UP",t={k="text",p={"You can identify POKÃ©MON you got in trades by their ID Numbers!"}}}},wild=nil,hidden={}}return {id=125,const="CELADON_MART_4F",w=10,h=4,ts=18,border=15,conns={},warps={{12,1,124,1},{16,1,136,2},{1,1,127,1}},signs={{x=14,y=1,t={k="text",p={"Express yourself with gifts!","4F: WISEMAN GIFTS","Evolution Special! Element STONEs on sale now!"}}}},objs={{x=5,y=7,s=38,m="STAY",d="NONE",t={k="mart",items={51,32,33,34,47}}},{x=15,y=5,s=12,m="WALK",d="LEFT_RIGHT",t={k="text",p={"I'm getting a POKÃ© DOLL for my girl friend!"}}},{x=5,y=2,s=4,m="WALK",d="LEFT_RIGHT",t={k="text",p={"I heard something useful.","You can run from wild POKÃ©MON by distracting them with a POKÃ© DOLL!"}}}},wild=nil,hidden={}}return {id=126,const="CELADON_MART_ROOF",w=10,h=4,ts=18,border=66,conns={},warps={{15,2,136,1}},signs={{x=10,y=1,t={k="none"}},{x=11,y=1,t={k="none"}},{x=12,y=2,t={k="none"}},{x=13,y=2,t={k="text",p={"ROOFTOP SQUARE: VENDING MACHINES"}}}},objs={{x=10,y=4,s=12,m="STAY",d="LEFT",t={k="text",p={"My sister is a trainer, believe it or not.","But, she's so immature, she drives me nuts!"}}},{x=5,y=5,s=8,m="WALK",d="ANY_DIR",t={k="text",p={"I'm thirsty! I want something to drink!"},s=1}}},wild=nil,hidden={}}return {id=127,const="CELADON_MART_ELEVATOR",w=2,h=2,ts=18,border=15,conns={},warps={{1,3,122,6},{2,3,122,6}},signs={{x=3,y=0,t={k="none"}}},objs={},wild=nil,hidden={}}return {id=128,const="CELADON_MANSION_1F",w=4,h=6,ts=19,border=15,conns={},warps={{4,11,255,3},{5,11,255,3},{4,0,255,5},{7,1,129,2},{2,1,129,3}},signs={{x=4,y=9,t={k="text",p={"CELADON MANSION Manager's Suite"}}}},objs={{x=0,y=5,s=5,m="STAY",d="RIGHT",t={k="text",p={"MEOWTH: Meow!"}}},{x=1,y=5,s=40,m="STAY",d="DOWN",t={k="text",p={"My dear POKÃ©MON keep me company.","MEOWTH even brings money home!"}}},{x=1,y=8,s=56,m="WALK",d="LEFT_RIGHT",t={k="text",p={"CLEFAIRY: Pi pippippi!"}}},{x=4,y=4,s=5,m="WALK",d="UP_DOWN",t={k="text",p={"NIDORAN: Kya kyaoo!"}}}},wild=nil,hidden={}}return {id=129,const="CELADON_MANSION_2F",w=4,h=6,ts=19,border=15,conns={},warps={{6,1,130,1},{7,1,128,4},{2,1,128,5},{4,1,130,4}},signs={{x=4,y=9,t={k="text",p={"GAME FREAK Meeting Room"}}}},objs={},wild=nil,hidden={{x=0,y=5,f="OpenPokemonCenterPC"}}}return {id=13,const="ROUTE_2",w=10,h=36,ts=0,border=15,conns={{"north",2,-5},{"south",1,-5}},warps={{12,9,46,1},{3,11,47,2},{15,19,48,1},{16,35,49,2},{15,39,49,3},{3,43,50,3}},signs={{x=5,y=65,t={k="text",p={"ROUTE 2 VIRIDIAN CITY - PEWTER CITY"}}},{x=11,y=11,t={k="text",p={"DIGLETT's CAVE"}}}},objs={{x=13,y=54,s=61,m="STAY",d="NONE",item=10,story=1},{x=13,y=45,s=61,m="STAY",d="NONE",item=35,story=1}},wild={gr=25,g={{3,19},{3,16},{4,16},{4,19},{5,16},{3,13},{2,19},{5,19},{4,13},{5,13}},wr=0,w={}},hidden={}}return {id=130,const="CELADON_MANSION_3F",w=4,h=6,ts=19,border=15,conns={},warps={{6,1,129,1},{7,1,131,1},{2,1,131,2},{4,1,129,4}},signs={{x=1,y=3,t={k="text",p={"It's the game program! Messing with it could bug out the game!"}}},{x=4,y=3,t={k="text",p={"Someone's playing a game instead of working!"}}},{x=1,y=6,t={k="text",p={"It's the script! Better not look at the ending!"}}},{x=4,y=9,t={k="text",p={"GAME FREAK Development Room"}}}},objs={{x=0,y=4,s=21,m="STAY",d="UP",t={k="text",p={"Me? I'm the programmer!"}}},{x=3,y=4,s=38,m="STAY",d="UP",t={k="text",p={"I'm the graphic artist! I drew you!"}}},{x=0,y=7,s=12,m="STAY",d="UP",t={k="text",p={"I wrote the story! Isn't ERIKA cute?","I like MISTY a lot too!","Oh, and SABRINA, I like her!"}}},{x=2,y=3,s=44,m="STAY",d="NONE",t={k="text",p={"Is that right?","I'm the game designer!","Filling up your POKÃ©DEX is tough, but don't quit!","When you finish, come tell me!"},s=1}}},wild=nil,hidden={}}return {id=131,const="CELADON_MANSION_ROOF",w=4,h=6,ts=19,border=9,conns={},warps={{6,1,130,2},{2,1,130,3},{2,7,132,1}},signs={{x=3,y=7,t={k="text",p={"I KNOW EVERYTHING!"}}}},objs={},wild=nil,hidden={}}return {id=132,const="CELADON_MANSION_ROOF_HOUSE",w=4,h=4,ts=8,border=10,conns={},warps={{2,7,131,3},{3,7,131,3}},signs={},objs={{x=2,y=2,s=14,m="STAY",d="DOWN",t={k="text",p={"I know everything about the world of POKÃ©MON in your GAME BOY!","Get together with your friends and trade POKÃ©MON!"}}},{x=4,y=3,s=61,m="STAY",d="NONE",story=1}},wild=nil,hidden={{x=3,y=0,f="PrintBlackboardLinkCableText"},{x=4,y=0,f="PrintBlackboardLinkCableText"},{x=3,y=4,f="PrintNotebookText"}}}return {id=133,const="CELADON_POKECENTER",w=7,h=4,ts=6,border=0,conns={},warps={{3,7,255,6},{4,7,255,6}},signs={},objs={{x=3,y=1,s=41,m="STAY",d="DOWN",t={k="nurse"}},{x=7,y=3,s=16,m="WALK",d="LEFT_RIGHT",t={k="text",p={"POKÃ© FLUTE awakens POKÃ©MON with a sound that only they can hear!"}}},{x=10,y=5,s=15,m="WALK",d="ANY_DIR",t={k="text",p={"I rode uphill on CYCLING ROAD from FUCHSIA!"}}},{x=11,y=2,s=42,m="STAY",d="DOWN",t={k="cable"}}},wild=nil,hidden={{x=0,y=4,f="PrintBenchGuyText"},{x=13,y=3,f="OpenPokemonCenterPC"}}}return {id=134,const="CELADON_GYM",w=5,h=9,ts=7,border=3,conns={},warps={{4,17,255,7},{5,17,255,7}},signs={},objs={{x=4,y=3,s=27,m="STAY",d="DOWN",opp={37,1},t={k="text",p={"Hello. Lovely weather isn't it? It's so pleasant.","...Oh dear... I must have dozed off. Welcome.","My name is ERIKA. I am the LEADER of CELADON GYM.","I teach the art of flower arranging. My POKÃ©MON are of the grass-type.","Oh, I'm sorry, I had no idea that you wished to challenge me.","Very well, but I shall not lose."},s=1}},{x=2,y=11,s=6,m="STAY",d="RIGHT",opp={3,17},t={k="trainer",range=2,b={"Hey!","You are not allowed in here!"},e={"You're too rough!"},a={"Bleaah! I hope ERIKA wipes you out!"}}},{x=7,y=10,s=15,m="STAY",d="LEFT",opp={18,1},t={k="trainer",range=2,b={"I was getting bored."},e={"My makeup!"},a={"Grass-type POKÃ©MON are tough against the water-type!","They also have an edge on rock and ground POKÃ©MON!"}}},{x=9,y=5,s=6,m="STAY",d="DOWN",opp={6,11},t={k="trainer",range=4,b={"Aren't you the peeping Tom?"},e={"I'm in shock!"},a={"Oh, you weren't peeping? We get a lot of gawkers!"}}},{x=1,y=5,s=15,m="STAY",d="DOWN",opp={18,2},t={k="trainer",range=4,b={"Look at my grass POKÃ©MON!","They're so easy to raise!"},e={"No!"},a={"We only use grass- type POKÃ©MON at our GYM!","We also use them for making flower arrangements!"}}},{x=6,y=3,s=6,m="STAY",d="DOWN",opp={3,18},t={k="trainer",range=2,b={"Don't bring any bugs or fire POKÃ©MON in here!"},e={"Oh! You!"},a={"Our LEADER, ERIKA, might be quiet, but she's also very skilled!"}}},{x=3,y=3,s=15,m="STAY",d="DOWN",opp={18,3},t={k="trainer",range=2,b={"Pleased to meet you. My hobby is POKÃ©MON training."},e={"Oh! Splendid!"},a={"I have a blind date coming up. I have to learn to be polite."}}},{x=5,y=3,s=6,m="STAY",d="DOWN",opp={32,1},t={k="trainer",range=3,b={"Welcome to CELADON GYM!","You better not underestimate girl power!"},e={"Oh! Beaten!"},a={"I didn't bring my best POKÃ©MON!","Wait 'til next time!"}}}},wild=nil,hidden={{x=3,y=15,f="GymStatues"},{x=6,y=15,f="GymStatues"}}}return {id=135,const="GAME_CORNER",w=10,h=9,ts=18,border=15,conns={},warps={{15,17,255,8},{16,17,255,8},{17,4,199,2}},signs={{x=9,y=4,t={k="text",p={"Hey!","A switch behind the poster!? Let's push it!"},s=1}}},objs={{x=2,y=6,s=15,m="STAY",d="DOWN",t={k="text",p={"Welcome!","You can exchange your coins for fabulous prizes next door."}}},{x=5,y=6,s=38,m="STAY",d="DOWN",t={k="text",p={"Welcome to ROCKET GAME CORNER!","Do you need some game coins?","It's Â¥1000 for 50 coins. Would you like some?"},s=1}},{x=2,y=10,s=10,m="STAY",d="LEFT",t={k="text",p={"Keep this quiet.","It's rumored that this place is run by TEAM ROCKET."}}},{x=2,y=13,s=15,m="STAY",d="LEFT",t={k="text",p={"I think these machines have different odds."}}},{x=5,y=11,s=39,m="STAY",d="RIGHT",t={k="text",p={"Kid, do you want to play?"},s=1}},{x=8,y=11,s=28,m="STAY",d="LEFT",t={k="text",p={"I'm having a wonderful time!"}}},{x=8,y=14,s=36,m="STAY",d="LEFT",t={k="text",p={"Hey!","You have better things to do, champ in making!","CELADON GYM's LEADER is ERIKA! She uses grass- type POKÃ©MON!","She might appear docile, but don't be fooled!"},s=1}},{x=11,y=15,s=11,m="STAY",d="RIGHT",t={k="text",p={"Games are scary! It's so easy to get hooked!"}}},{x=14,y=11,s=38,m="STAY",d="LEFT",t={k="text",p={"What's up? Want some coins?"},s=1}},{x=17,y=13,s=16,m="STAY",d="RIGHT",t={k="text",p={"Hey, what? You're throwing me off! Here are some coins, shoo!"},s=1}},{x=9,y=5,s=24,m="STAY",d="UP",opp={30,7},t={k="text",p={"I'm guarding this poster! Go away, or else!"},s=1},story=1}},wild=nil,hidden={{x=18,y=15,f="StartSlotMachine"},{x=18,y=14,f="StartSlotMachine"},{x=18,y=13,f="StartSlotMachine"},{x=18,y=12,f="StartSlotMachine"},{x=18,y=11,f="StartSlotMachine"},{x=18,y=10,f="StartSlotMachine"},{x=13,y=10,f="StartSlotMachine"},{x=13,y=11,f="StartSlotMachine"},{x=13,y=12,f="StartSlotMachine"},{x=13,y=13,f="StartSlotMachine"},{x=13,y=14,f="StartSlotMachine"},{x=13,y=15,f="StartSlotMachine"},{x=12,y=15,f="StartSlotMachine"},{x=12,y=14,f="StartSlotMachine"},{x=12,y=13,f="StartSlotMachine"},{x=12,y=12,f="StartSlotMachine"},{x=12,y=11,f="StartSlotMachine"},{x=12,y=10,f="StartSlotMachine"},{x=7,y=10,f="StartSlotMachine"},{x=7,y=11,f="StartSlotMachine"},{x=7,y=12,f="StartSlotMachine"},{x=7,y=13,f="StartSlotMachine"},{x=7,y=14,f="StartSlotMachine"},{x=7,y=15,f="StartSlotMachine"},{x=6,y=15,f="StartSlotMachine"},{x=6,y=14,f="StartSlotMachine"},{x=6,y=13,f="StartSlotMachine"},{x=6,y=12,f="StartSlotMachine"},{x=6,y=11,f="StartSlotMachine"},{x=6,y=10,f="StartSlotMachine"},{x=1,y=10,f="StartSlotMachine"},{x=1,y=11,f="StartSlotMachine"},{x=1,y=12,f="StartSlotMachine"},{x=1,y=13,f="StartSlotMachine"},{x=1,y=14,f="StartSlotMachine"},{x=1,y=15,f="StartSlotMachine"},{x=0,y=8,f="HiddenCoins"},{x=1,y=16,f="HiddenCoins"},{x=3,y=11,f="HiddenCoins"},{x=3,y=14,f="HiddenCoins"},{x=4,y=12,f="HiddenCoins"},{x=9,y=12,f="HiddenCoins"},{x=9,y=15,f="HiddenCoins"},{x=16,y=14,f="HiddenCoins"},{x=10,y=16,f="HiddenCoins"},{x=11,y=7,f="HiddenCoins"},{x=15,y=8,f="HiddenCoins"},{x=12,y=15,f="HiddenCoins"}}}return {id=136,const="CELADON_MART_5F",w=10,h=4,ts=18,border=15,conns={},warps={{12,1,126,1},{16,1,125,2},{1,1,127,1}},signs={{x=14,y=1,t={k="text",p={"5F: DRUG STORE"}}}},objs={{x=14,y=5,s=16,m="WALK",d="UP_DOWN",t={k="text",p={"POKÃ©MON ability enhancers can be bought only here.","Use CALCIUM to increase SPECIAL abilities.","Use CARBOS to increase SPEED."}}},{x=2,y=6,s=19,m="STAY",d="NONE",t={k="text",p={"I'm here for POKÃ©MON ability enhancers.","PROTEIN increases ATTACK power.","IRON increases DEFENSE!"}}},{x=5,y=3,s=38,m="STAY",d="DOWN",t={k="mart",items={46,55,58,65,66,67,68}}},{x=6,y=3,s=38,m="STAY",d="DOWN",t={k="mart",items={35,36,37,38,39}}}},wild=nil,hidden={}}return {id=137,const="GAME_CORNER_PRIZE_ROOM",w=5,h=4,ts=18,border=15,conns={},warps={{4,7,255,10},{5,7,255,10}},signs={{x=2,y=2,t={k="none"}},{x=4,y=2,t={k="none"}},{x=6,y=2,t={k="none"}}},objs={{x=1,y=4,s=52,m="STAY",d="NONE",t={k="text",p={"I sure do fancy that PORYGON!","But, it's hard to win at slots!"}}},{x=7,y=3,s=11,m="WALK",d="LEFT_RIGHT",t={k="text",p={"I had a major haul today!"}}}},wild=nil,hidden={}}return {id=138,const="CELADON_DINER",w=5,h=4,ts=18,border=15,conns={},warps={{3,7,255,11},{4,7,255,11}},signs={},objs={{x=8,y=5,s=20,m="WALK",d="LEFT_RIGHT",t={k="text",p={"Hi!","We're taking a break now."}}},{x=7,y=2,s=28,m="STAY",d="NONE",t={k="text",p={"My POKÃ©MON are weak, so I often have to go to the DRUG STORE."}}},{x=1,y=4,s=10,m="STAY",d="DOWN",t={k="text",p={"Psst! There's a basement under the GAME CORNER."}}},{x=5,y=3,s=47,m="STAY",d="RIGHT",t={k="text",p={"Munch...","The man at that table lost it all at the slots."}}},{x=0,y=1,s=36,m="STAY",d="DOWN",t={k="text",p={"Go ahead! Laugh!","I'm flat out busted!","No more slots for me! I'm going straight!","Here! I won't be needing this any- more!"},s=1}}},wild=nil,hidden={}}return {id=139,const="CELADON_CHIEF_HOUSE",w=4,h=4,ts=19,border=15,conns={},warps={{2,7,255,12},{3,7,255,12}},signs={},objs={{x=4,y=2,s=37,m="STAY",d="DOWN",t={k="text",p={"Hehehe! The slots just reel in the dough, big time!"}}},{x=1,y=4,s=24,m="WALK",d="ANY_DIR",t={k="text",p={"CHIEF!","We just shipped 2000 POKÃ©MON as slot prizes!"}}},{x=5,y=6,s=19,m="STAY",d="LEFT",t={k="text",p={"Don't touch the poster at the GAME CORNER!","There's no secret switch behind it!"}}}},wild=nil,hidden={}}return {id=14,const="ROUTE_3",w=35,h=9,ts=0,border=44,conns={{"north",15,25},{"west",2,-4}},warps={},signs={{x=59,y=9,t={k="text",p={"ROUTE 3 MT.MOON AHEAD"}}}},objs={{x=57,y=11,s=12,m="STAY",d="NONE",t={k="text",p={"Whew... I better take a rest... Groan...","That tunnel from CERULEAN takes a lot out of you!"}}},{x=10,y=6,s=4,m="STAY",d="RIGHT",opp={2,4},t={k="trainer",range=2,b={"Hey! I met you in VIRIDIAN FOREST!"},e={"You beat me again!"},a={"There are other kinds of POKÃ©MON than those found in the forest!"}}},{x=14,y=4,s=4,m="STAY",d="DOWN",opp={1,1},t={k="trainer",range=3,b={"Hi! I like shorts! They're comfy and easy to wear!"},e={"I don't believe it!"},a={"Are you storing your POKÃ©MON on PC? Each BOX can hold 20 POKÃ©MON!"}}},{x=16,y=9,s=6,m="STAY",d="LEFT",opp={3,1},t={k="trainer",range=2,b={"You looked at me, didn't you?"},e={"You're mean!"},a={"Quit staring if you don't want to fight!"}}},{x=19,y=5,s=4,m="STAY",d="DOWN",opp={2,5},t={k="trainer",range=1,b={"Are you a trainer? Let's fight!"},e={"If I had new POKÃ©MON I would've won!"},a={"If a POKÃ©MON BOX on the PC gets full, just switch to another BOX!"}}},{x=23,y=4,s=6,m="STAY",d="LEFT",opp={3,2},t={k="trainer",range=4,b={"That look you gave me, it's so intriguing!"},e={"Be nice!"},a={"Avoid fights by not letting people see you!"}}},{x=22,y=9,s=4,m="STAY",d="LEFT",opp={1,2},t={k="trainer",range=3,b={"Hey! You're not wearing shorts!"},e={"Lost! Lost! Lost!"},a={"I always wear shorts, even in winter!"}}},{x=24,y=6,s=4,m="STAY",d="RIGHT",opp={2,6},t={k="trainer",range=3,b={"You can fight my new POKÃ©MON!"},e={"Done like dinner!"},a={"Trained POKÃ©MON are stronger than the wild ones!"}}},{x=33,y=10,s=6,m="STAY",d="UP",opp={3,3},t={k="trainer",range=2,b={"Eek! Did you touch me?"},e={"That's it?"},a={"ROUTE 4 is at the foot of MT.MOON."}}}},wild={gr=20,g={{6,16},{5,21},{7,16},{6,21},{7,21},{8,16},{8,21},{3,39},{5,39},{7,39}},wr=0,w={}},hidden={}}return {id=140,const="CELADON_HOTEL",w=7,h=4,ts=6,border=0,conns={},warps={{3,7,255,13},{4,7,255,13}},signs={},objs={{x=3,y=1,s=40,m="STAY",d="DOWN",t={k="text",p={"POKÃ©MON? No, this is a hotel for people.","We're full up."}}},{x=2,y=4,s=15,m="STAY",d="NONE",t={k="text",p={"I'm on vacation with my brother and boy friend.","CELADON is such a pretty city!"}}},{x=8,y=4,s=12,m="WALK",d="LEFT_RIGHT",t={k="text",p={"Why did she bring her brother?"}}}},wild=nil,hidden={{x=13,y=3,f="OpenPokemonCenterPC"},{x=0,y=4,f="PrintBenchGuyText"}}}return {id=141,const="LAVENDER_POKECENTER",w=7,h=4,ts=6,border=0,conns={},warps={{3,7,255,1},{4,7,255,1}},signs={},objs={{x=3,y=1,s=41,m="STAY",d="DOWN",t={k="nurse"}},{x=5,y=3,s=16,m="STAY",d="NONE",t={k="text",p={"TEAM ROCKET will do anything for the sake of gold!"}}},{x=2,y=6,s=8,m="WALK",d="UP_DOWN",t={k="text",p={"I saw CUBONE's mother die trying to escape from TEAM ROCKET!"}}},{x=11,y=2,s=42,m="STAY",d="DOWN",t={k="cable"}}},wild=nil,hidden={{x=0,y=4,f="PrintBenchGuyText"},{x=13,y=3,f="OpenPokemonCenterPC"}}}return {id=142,const="POKEMON_TOWER_1F",w=10,h=9,ts=15,border=1,conns={},warps={{10,17,255,2},{11,17,255,2},{18,9,143,2}},signs={},objs={{x=15,y=13,s=42,m="STAY",d="UP",t={k="text",p={"POKÃ©MON TOWER was erected in the memory of POKÃ©MON that had died."}}},{x=6,y=8,s=28,m="STAY",d="NONE",t={k="text",p={"Did you come to pay respects? Bless you!"}}},{x=8,y=12,s=52,m="STAY",d="NONE",t={k="text",p={"I came to pray for my CLEFAIRY.","Sniff! I can't stop crying..."}}},{x=13,y=7,s=13,m="STAY",d="NONE",t={k="text",p={"My GROWLITHE... Why did you die?"}}},{x=17,y=7,s=25,m="STAY",d="LEFT",t={k="text",p={"I am a CHANNELER! There are spirits up to mischief!"}}}},wild=nil,hidden={}}return {id=143,const="POKEMON_TOWER_2F",w=10,h=9,ts=15,border=1,conns={},warps={{3,9,144,1},{18,9,142,3}},signs={},objs={{x=14,y=5,s=2,m="STAY",d="NONE",t={k="text",p={"BLUE: Hey, RED! What brings you here? Your POKÃ©MON don't look dead!","I can at least make them faint! Let's go, pal!"},s=1},story=1},{x=3,y=7,s=25,m="STAY",d="RIGHT",t={k="text",p={"Even we could not identify the wayward GHOSTs!","A SILPH SCOPE might be able to unmask them."}}}},wild=nil,hidden={}}return {id=144,const="POKEMON_TOWER_3F",w=10,h=9,ts=15,border=1,conns={},warps={{3,9,143,1},{18,9,145,2}},signs={},objs={{x=12,y=3,s=25,m="STAY",d="LEFT",opp={45,5},t={k="trainer",range=2,b={"Urrg...Awaa... Huhu...graa.."},e={"Hwa! I'm saved!"},a={"The GHOSTs can be identified by the SILPH SCOPE."}}},{x=9,y=8,s=25,m="STAY",d="DOWN",opp={45,6},t={k="trainer",range=3,b={"Kekeke.... Kwaaah!"},e={"Hmm? What am I doing?"},a={"Sorry! I was possessed!"}}},{x=10,y=13,s=25,m="STAY",d="DOWN",opp={45,8},t={k="trainer",range=2,b={"Be gone! Evil spirit!"},e={"Whew! The spirit left!"},a={"My friends were possessed too!"}}},{x=12,y=1,s=61,m="STAY",d="NONE",item=29,story=1}},wild={gr=10,g={{20,92},{21,92},{22,92},{23,92},{19,92},{18,92},{24,92},{20,104},{22,104},{25,93}},wr=0,w={}},hidden={}}return {id=145,const="POKEMON_TOWER_4F",w=10,h=9,ts=15,border=1,conns={},warps={{3,9,146,1},{18,9,144,2}},signs={},objs={{x=5,y=10,s=25,m="STAY",d="RIGHT",opp={45,9},t={k="trainer",range=2,b={"GHOST! No! Kwaaah!"},e={"Where is the GHOST?"},a={"I must have been dreaming..."}}},{x=15,y=7,s=25,m="STAY",d="DOWN",opp={45,10},t={k="trainer",range=2,b={"Be cursed with me! Kwaaah!"},e={"What!"},a={"We can't crack the identity of the GHOSTs."}}},{x=14,y=12,s=25,m="STAY",d="LEFT",opp={45,12},t={k="trainer",range=2,b={"Huhuhu... Beat me not!"},e={"Huh? Who? What?"},a={"May the departed souls of POKÃ©MON rest in peace..."}}},{x=12,y=10,s=61,m="STAY",d="NONE",item=82,story=1},{x=9,y=10,s=61,m="STAY",d="NONE",item=14,story=1},{x=12,y=16,s=61,m="STAY",d="NONE",item=35,story=1}},wild={gr=10,g={{20,92},{21,92},{22,92},{23,92},{19,92},{18,92},{25,93},{20,104},{22,104},{24,92}},wr=0,w={}},hidden={}}return {id=146,const="POKEMON_TOWER_5F",w=10,h=9,ts=15,border=1,conns={},warps={{3,9,145,1},{18,9,147,1}},signs={},objs={{x=12,y=8,s=25,m="STAY",d="NONE",t={k="text",p={"Come, child! I sealed this space with white magic!","You can rest here!"}}},{x=17,y=7,s=25,m="STAY",d="LEFT",opp={45,14},t={k="trainer",range=2,b={"Give...me... your...soul..."},e={"Gasp!"},a={"I was under possession!"}}},{x=14,y=3,s=25,m="STAY",d="LEFT",opp={45,16},t={k="trainer",range=3,b={"You...shall... join...us..."},e={"What a nightmare!"},a={"I was possessed!"}}},{x=6,y=10,s=25,m="STAY",d="RIGHT",opp={45,17},t={k="trainer",range=2,b={"Zombies!"},e={"Ha?"},a={"I regained my senses!"}}},{x=9,y=16,s=25,m="STAY",d="RIGHT",opp={45,18},t={k="trainer",range=2,b={"Urgah... Urff...."},e={"Whoo!"},a={"I fell to evil spirits despite my training!"}}},{x=6,y=14,s=61,m="STAY",d="NONE",item=49,story=1}},wild={gr=10,g={{20,92},{21,92},{22,92},{23,92},{19,92},{18,92},{25,93},{20,104},{22,104},{24,92}},wr=0,w={}},hidden={{x=4,y=12,f="HiddenItems",item=82}}}return {id=147,const="POKEMON_TOWER_6F",w=10,h=9,ts=15,border=1,conns={},warps={{18,9,146,2},{9,16,148,1}},signs={},objs={{x=12,y=10,s=25,m="STAY",d="RIGHT",opp={45,19},t={k="trainer",range=3,b={"Give...me... blood..."},e={"Groan!"},a={"I feel anemic and weak..."}}},{x=9,y=5,s=25,m="STAY",d="DOWN",opp={45,20},t={k="trainer",range=3,b={"Urff... Kwaah!"},e={"Some- thing fell out!"},a={"Hair didn't fall out! It was an evil spirit!"}}},{x=16,y=5,s=25,m="STAY",d="LEFT",opp={45,21},t={k="trainer",range=2,b={"Ke..ke...ke... ke..ke...ke!!"},e={"Keee!"},a={"What's going on here?"}}},{x=6,y=8,s=61,m="STAY",d="NONE",item=40,story=1},{x=14,y=14,s=61,m="STAY",d="NONE",item=46,story=1}},wild={gr=15,g={{21,92},{22,92},{23,92},{24,92},{20,92},{19,92},{26,93},{22,104},{24,104},{28,93}},wr=0,w={}},hidden={}}return {id=148,const="POKEMON_TOWER_7F",w=10,h=9,ts=15,border=1,conns={},warps={{9,16,147,2}},signs={},objs={{x=9,y=11,s=24,m="STAY",d="RIGHT",opp={30,19},t={k="trainer",range=3,b={"What do you want? Why are you here?"},e={"I give up!"},a={"I'm not going to forget this!"}},story=1},{x=12,y=9,s=24,m="STAY",d="LEFT",opp={30,20},t={k="trainer",range=3,b={"This old guy came and complained about us harming useless POKÃ©MON!","We're talking it over as adults!"},e={"Please! No more!"},a={"POKÃ©MON are only good for making money!","Stay out of our business!"}},story=1},{x=9,y=7,s=24,m="STAY",d="RIGHT",opp={30,21},t={k="trainer",range=3,b={"You're not saving anyone, kid!"},e={"Don't fight us ROCKETs!"},a={"You're not getting away with this!"}},story=1},{x=10,y=3,s=22,m="STAY",d="DOWN",t={k="text",p={"MR.FUJI: Heh? You came to save me?","Thank you. But, I came here of my own free will.","I came to calm the soul of CUBONE's mother.","I think MAROWAK's spirit has gone to the afterlife.","I must thank you for your kind concern!","Follow me to my home, POKÃ©MON HOUSE at the foot of this tower."},s=1},story=1}},wild={gr=15,g={{21,92},{22,92},{23,92},{24,92},{20,92},{28,93},{22,104},{24,104},{28,93},{30,93}},wr=0,w={}},hidden={}}return {id=149,const="MR_FUJIS_HOUSE",w=4,h=4,ts=8,border=10,conns={},warps={{2,7,255,3},{3,7,255,3}},signs={},objs={{x=3,y=5,s=12,m="STAY",d="NONE",t={k="text",p={"That's odd, MR.FUJI isn't here. Where'd he go?"},s=1}},{x=6,y=3,s=8,m="STAY",d="DOWN",t={k="text",p={"This is really MR.FUJI's house.","He's really kind!","He looks after abandoned and orphaned POKÃ©MON!"},s=1}},{x=6,y=4,s=5,m="STAY",d="UP",t={k="text",p={"PSYDUCK: Gwappa!"}}},{x=1,y=3,s=5,m="STAY",d="NONE",t={k="text",p={"NIDORINO: Gaoo!"}}},{x=3,y=1,s=22,m="STAY",d="NONE",t={k="text",p={"MR.FUJI: RED.","Your POKÃ©DEX quest may fail without love for your POKÃ©MON.","I think this may help your quest."},s=1},hide=1},{x=3,y=3,s=65,m="STAY",d="NONE",t={k="text",p={"POKÃ©MON Monthly Grand Prize Drawing!","The application form is...","Gone! It's been clipped out!"}}}},wild=nil,hidden={{x=0,y=1,f="PrintMagazinesText"},{x=1,y=1,f="PrintMagazinesText"},{x=7,y=1,f="PrintMagazinesText"}}}return {id=15,const="ROUTE_4",w=45,h=9,ts=0,border=44,conns={{"south",14,-25},{"east",3,-4}},warps={{11,5,68,1},{18,5,59,1},{24,5,60,8}},signs={{x=12,y=5,t={k="none"}},{x=17,y=7,t={k="text",p={"MT.MOON Tunnel Entrance"}}},{x=27,y=7,t={k="text",p={"ROUTE 4 MT.MOON - CERULEAN CITY"}}}},objs={{x=9,y=8,s=6,m="WALK",d="ANY_DIR",t={k="text",p={"Ouch! I tripped over a rocky POKÃ©MON, GEODUDE!"}}},{x=63,y=3,s=6,m="STAY",d="RIGHT",opp={3,4},t={k="trainer",range=3,b={"I came to get my mushroom POKÃ©MON!"},e={"Oh! My cute mushroom POKÃ©MON!"},a={"There might not be any more mushrooms here.","I think I got them all."}}},{x=57,y=3,s=61,m="STAY",d="NONE",item=110,story=1}},wild={gr=20,g={{10,19},{10,21},{8,19},{6,23},{8,21},{10,23},{12,19},{12,21},{8,23},{12,23}},wr=0,w={}},hidden={{x=40,y=3,f="HiddenItems",item=3}}}return {id=150,const="LAVENDER_MART",w=4,h=4,ts=2,border=0,conns={},warps={{3,7,255,4},{4,7,255,4}},signs={},objs={{x=0,y=5,s=38,m="STAY",d="RIGHT",t={k="mart",items={3,19,53,29,56,11,12,13,15}}},{x=3,y=4,s=52,m="STAY",d="NONE",t={k="text",p={"I'm searching for items that raise the abilities of POKÃ©MON during a single battle.","X ATTACK, X DEFEND, X SPEED and X SPECIAL are what I'm after.","Do you know where I can get them?"}}},{x=7,y=2,s=7,m="STAY",d="NONE",t={k="text",p={"You know REVIVE? It revives any fainted POKÃ©MON!"},s=1}}},wild=nil,hidden={}}return {id=151,const="LAVENDER_CUBONE_HOUSE",w=4,h=4,ts=8,border=10,conns={},warps={{2,7,255,5},{3,7,255,5}},signs={},objs={{x=3,y=5,s=5,m="STAY",d="UP",t={k="text",p={"CUBONE: Kyarugoo!"}}},{x=2,y=4,s=29,m="STAY",d="RIGHT",t={k="text",p={"I hate those horrible ROCKETs!","That poor CUBONE's mother...","It was killed trying to escape from TEAM ROCKET!"},s=1}}},wild=nil,hidden={}}return {id=152,const="FUCHSIA_MART",w=4,h=4,ts=2,border=0,conns={},warps={{3,7,255,1},{4,7,255,1}},signs={},objs={{x=0,y=5,s=38,m="STAY",d="RIGHT",t={k="mart",items={2,3,19,53,52,56}}},{x=4,y=2,s=10,m="STAY",d="NONE",t={k="text",p={"Do you have a SAFARI ZONE flag?","What about cards or calendars?"}}},{x=6,y=5,s=6,m="WALK",d="UP_DOWN",t={k="text",p={"Did you try X SPEED? It speeds up a POKÃ©MON in battle!"}}}},wild=nil,hidden={}}return {id=153,const="FUCHSIA_BILLS_GRANDPAS_HOUSE",w=4,h=4,ts=8,border=10,conns={},warps={{2,7,255,2},{3,7,255,2}},signs={},objs={{x=2,y=3,s=28,m="STAY",d="RIGHT",t={k="text",p={"SAFARI ZONE's WARDEN is old, but still active!","All his teeth are false, though."}}},{x=7,y=2,s=11,m="STAY",d="UP",t={k="text",p={"Hmm? You've met BILL?","He's my grandson!","He always liked collecting things even as a child!"}}},{x=5,y=5,s=4,m="STAY",d="NONE",t={k="text",p={"BILL files his own POKÃ©MON data on his PC!","Did he show you?"}}}},wild=nil,hidden={}}return {id=154,const="FUCHSIA_POKECENTER",w=7,h=4,ts=6,border=0,conns={},warps={{3,7,255,3},{4,7,255,3}},signs={},objs={{x=3,y=1,s=41,m="STAY",d="DOWN",t={k="nurse"}},{x=2,y=3,s=33,m="STAY",d="NONE",t={k="text",p={"You can't win with just one strong POKÃ©MON.","It's tough, but you have to raise them evenly."}}},{x=6,y=5,s=6,m="WALK",d="LEFT_RIGHT",t={k="text",p={"There's a narrow trail west of VIRIDIAN CITY.","It goes to POKÃ©MON LEAGUE HQ. The HQ governs all trainers."}}},{x=11,y=2,s=42,m="STAY",d="DOWN",t={k="cable"}}},wild=nil,hidden={{x=13,y=3,f="OpenPokemonCenterPC"},{x=0,y=4,f="PrintBenchGuyText"}}}return {id=155,const="WARDENS_HOUSE",w=5,h=4,ts=20,border=23,conns={},warps={{4,7,255,4},{5,7,255,4}},signs={{x=4,y=3,t={k="text",p={"POKÃ©MON photos and fossils."},s=1}},{x=5,y=3,t={k="text",p={"POKÃ©MON photos and fossils."},s=1}}},objs={{x=2,y=3,s=45,m="STAY",d="NONE",t={k="text",p={"WARDEN: Hif fuff hefifoo!","Ha lof ha feef ee hafahi ho. Heff hee fwee!"},s=1}},{x=8,y=3,s=61,m="STAY",d="NONE",item=40,story=1},{x=8,y=4,s=63,m="STAY",d="BOULDER_MOVEMENT_BYTE_2"}},wild=nil,hidden={}}return {id=156,const="SAFARI_ZONE_GATE",w=4,h=3,ts=12,border=10,conns={},warps={{3,5,255,5},{4,5,255,5},{3,0,220,1},{4,0,220,2}},signs={},objs={{x=6,y=2,s=35,m="STAY",d="LEFT",t={k="text",p={"Welcome to the SAFARI ZONE!"}}},{x=1,y=4,s=35,m="STAY",d="RIGHT",t={k="text",p={"Hi! Is it your first time here?"},s=1}}},wild=nil,hidden={{x=10,y=1,f="HiddenItems",item=49}}}return {id=157,const="FUCHSIA_GYM",w=5,h=9,ts=7,border=3,conns={},warps={{4,17,255,6},{5,17,255,6}},signs={},objs={{x=4,y=10,s=48,m="STAY",d="DOWN",opp={38,1},t={k="text",p={"KOGA: Fwahahaha!","A mere child like you dares to challenge me?","Very well, I shall show you true terror as a ninja master!","You shall feel the despair of poison and sleep techniques!"},s=1}},{x=8,y=13,s=33,m="STAY",d="DOWN",opp={21,7},t={k="trainer",range=2,b={"Strength isn't the key for POKÃ©MON!","It's strategy!","I'll show you how strategy can beat brute strength!"},e={"What? Extraordinary!"},a={"So, you mix brawn with brains? Good strategy!"}}},{x=7,y=8,s=33,m="STAY",d="RIGHT",opp={21,3},t={k="trainer",range=2,b={"I wanted to become a ninja, so I joined this GYM!"},e={"I'm done for!"},a={"I will keep on training under KOGA, my ninja master!"}}},{x=1,y=12,s=33,m="STAY",d="DOWN",opp={21,8},t={k="trainer",range=4,b={"Let's see you beat my special techniques!"},e={"You had me fooled!"},a={"I like poison and sleep techniques, as they linger after battle!"}}},{x=3,y=5,s=33,m="STAY",d="UP",opp={22,1},t={k="trainer",range=2,b={"Stop right there!","Our invisible walls have you frustrated?"},e={"Whoa! He's got it!"},a={"You impressed me! Here's a hint!","Look very closely for gaps in the invisible walls!"}}},{x=8,y=2,s=33,m="STAY",d="DOWN",opp={22,2},t={k="trainer",range=2,b={"I also study the way of the ninja with master KOGA!","Ninja have a long history of using animals!"},e={"Awoo!"},a={"I still have much to learn!"}}},{x=2,y=7,s=33,m="STAY",d="LEFT",opp={21,4},t={k="trainer",range=2,b={"Master KOGA comes from a long line of ninjas!","What did you descend from?"},e={"Dropped my balls!"},a={"Where there is light, there is shadow!","Light and shadow! Which do you choose?"}}},{x=7,y=15,s=36,m="STAY",d="DOWN",t={k="text",p={"Yo! Champ in making!","FUCHSIA GYM is riddled with invisible walls!","KOGA might appear close, but he's blocked off!","You have to find gaps in the walls to reach him!"},s=1}}},wild=nil,hidden={{x=3,y=15,f="GymStatues"},{x=6,y=15,f="GymStatues"}}}return {id=158,const="FUCHSIA_MEETING_ROOM",w=7,h=4,ts=20,border=23,conns={},warps={{4,7,255,7},{5,7,255,7}},signs={},objs={{x=4,y=1,s=35,m="STAY",d="DOWN",t={k="text",p={"We nicknamed the WARDEN SLOWPOKE.","He and SLOWPOKE both look vacant!"}}},{x=0,y=2,s=35,m="STAY",d="UP",t={k="text",p={"SLOWPOKE is very knowledgeable about POKÃ©MON!","He even has some fossils of rare, extinct POKÃ©MON!"}}},{x=10,y=1,s=35,m="STAY",d="DOWN",t={k="text",p={"SLOWPOKE came in, but I couldn't understand him.","I think he's got a speech problem!"}}}},wild=nil,hidden={}}return {id=159,const="SEAFOAM_ISLANDS_B1F",w=15,h=9,ts=17,border=125,conns={},warps={{4,2,160,1},{7,5,192,5},{13,7,160,3},{19,15,160,4},{23,15,192,7},{25,11,160,6},{25,3,192,6}},signs={},objs={{x=17,y=6,s=63,m="STAY",d="BOULDER_MOVEMENT_BYTE_2",hide=1},{x=22,y=6,s=63,m="STAY",d="BOULDER_MOVEMENT_BYTE_2",hide=1}},wild={gr=10,g={{30,120},{30,116},{32,90},{32,116},{28,79},{30,86},{30,79},{28,86},{38,87},{37,117}},wr=0,w={}},hidden={}}return {id=16,const="ROUTE_5",w=10,h=18,ts=0,border=10,conns={{"north",3,-5},{"south",10,-5}},warps={{10,29,70,4},{9,29,70,3},{10,33,70,1},{17,27,71,1},{10,21,7
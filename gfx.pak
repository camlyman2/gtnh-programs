ward offered! Contact: WARDEN"}}},{x=26,y=4,t={k="text",p={"TRAINER TIPS","Zone Exploration Campaign!","The Search for the SECRET HOUSE!"}}},{x=24,y=22,t={k="text",p={"AREA 3 EAST: CENTER AREA"}}}},objs={{x=8,y=20,s=61,m="STAY",d="NONE",item=17,story=1},{x=9,y=7,s=61,m="STAY",d="NONE",item=138,story=1},{x=18,y=18,s=61,m="STAY",d="NONE",item=54,story=1},{x=19,y=7,s=61,m="STAY",d="NONE",item=64,story=1}},wild={gr=30,g={{25,32},{26,84},{23,48},{24,102},{33,33},{26,102},{25,29},{31,49},{26,128},{28,115}},wr=0,w={}},hidden={{x=6,y=5,f="HiddenItems",item=53}}}return {id=22,const="ROUTE_11",w=30,h=9,ts=0,border=15,conns={{"west",5,-4},{"east",23,-27}},warps={{49,8,84,1},{49,9,84,2},{58,8,84,3},{58,9,84,4},{4,5,85,1}},signs={{x=1,y=5,t={k="text",p={"DIGLETT's CAVE"}}}},objs={{x=10,y=14,s=11,m="STAY",d="DOWN",opp={17,1},t={k="trainer",range=3,b={"Win, lose or draw!"},e={"Atcha! Didn't go my way!"},a={"POKÃ©MON is life! And to live is to gamble!"}}},{x=26,y=9,s=11,m="STAY",d="DOWN",opp={17,2},t={k="trainer",range=2,b={"Competition! I can't get enough!"},e={"I had a chance!"},a={"You can't be a coward in the world of POKÃ©MON!"}}},{x=13,y=5,s=4,m="STAY",d="LEFT",opp={1,9},t={k="trainer",range=3,b={"Let's go, but don't cheat!"},e={"Huh? That's not right!"},a={"I did my best! I have no regrets!"}}},{x=36,y=11,s=12,m="STAY",d="DOWN",opp={12,2},t={k="trainer",range=3,b={"Careful! I'm laying down some cables!"},e={"That was electric!"},a={"Spread the word to save energy!"}}},{x=22,y=4,s=4,m="STAY",d="UP",opp={1,10},t={k="trainer",range=4,b={"I just became a trainer! But, I think I can win!"},e={"My POKÃ©MON couldn't!"},a={"What do you want? Leave me alone!"}}},{x=45,y=7,s=11,m="STAY",d="DOWN",opp={17,3},t={k="trainer",range=3,b={"Fwahaha! I have never lost!"},e={"My first loss!"},a={"Luck of the draw! Just luck!"}}},{x=33,y=3,s=11,m="STAY",d="UP",opp={17,4},t={k="trainer",range=3,b={"I have never won before..."},e={"I saw this coming..."},a={"It's just luck. Luck of the draw."}}},{x=43,y=5,s=4,m="STAY",d="RIGHT",opp={1,11},t={k="trainer",range=4,b={"I'm the best in my class!"},e={"Darn! I need to make my POKÃ©MON stronger!"},a={"There's a fat POKÃ©MON that comes down from the mountains.","It's strong if you can get it."}}},{x=45,y=16,s=12,m="STAY",d="LEFT",opp={12,3},t={k="trainer",range=3,b={"Watch out for live wires!"},e={"Whoa! You spark plug!"},a={"Well, better get back to work."}}},{x=22,y=12,s=4,m="STAY",d="UP",opp={1,12},t={k="trainer",range=4,b={"My POKÃ©MON should be ready by now!"},e={"Too much, too young!"},a={"I better go find stronger ones!"}}}},wild={gr=15,g={{14,23},{15,21},{12,23},{9,96},{13,21},{13,96},{15,23},{17,21},{11,96},{15,96}},wr=0,w={}},hidden={{x=48,y=5,f="HiddenItems",item=29}}}return {id=220,const="SAFARI_ZONE_CENTER",w=15,h=13,ts=3,border=0,conns={},warps={{14,25,156,3},{15,25,156,4},{0,10,219,5},{0,11,219,6},{14,0,218,5},{15,0,218,6},{29,10,217,3},{29,11,217,4},{17,19,221,1}},signs={{x=18,y=20,t={k="text",p={"REST HOUSE"}}},{x=14,y=22,t={k="text",p={"TRAINER TIPS","Press the START Button to check remaining time!"}}}},objs={{x=14,y=10,s=61,m="STAY",d="NONE",item=49,story=1}},wild={gr=30,g={{22,32},{25,111},{22,48},{24,102},{31,33},{25,102},{31,30},{30,47},{23,123},{23,113}},wr=0,w={}},hidden={}}return {id=221,const="SAFARI_ZONE_CENTER_REST_HOUSE",w=4,h=4,ts=12,border=10,conns={},warps={{2,7,220,9},{3,7,220,9}},signs={},objs={{x=3,y=2,s=13,m="STAY",d="DOWN",t={k="text",p={"SARA: Where did my boy friend, ERIK, go?"}}},{x=1,y=4,s=32,m="WALK",d="UP_DOWN",t={k="text",p={"I'm catching POKÃ©MON to take home as gifts!"}}}},wild=nil,hidden={}}return {id=222,const="SAFARI_ZONE_SECRET_HOUSE",w=4,h=4,ts=20,border=23,conns={},warps={{2,7,219,7},{3,7,219,7}},signs={},objs={{x=3,y=3,s=39,m="STAY",d="DOWN",t={k="text",p={"Ah! Finally!","You're the first person to reach the SECRET HOUSE!","I was getting worried that no one would win our campaign prize.","Congratulations! You have won!"},s=1}}},wild=nil,hidden={}}return {id=223,const="SAFARI_ZONE_WEST_REST_HOUSE",w=4,h=4,ts=12,border=10,conns={},warps={{2,7,219,8},{3,7,219,8}},signs={},objs={{x=4,y=4,s=32,m="WALK",d="ANY_DIR",t={k="text",p={"Tossing ROCKs at POKÃ©MON might make them run, but they'll be easier to catch."}}},{x=0,y=2,s=7,m="STAY",d="RIGHT",t={k="text",p={"Using BAIT will make POKÃ©MON easier to catch."}}},{x=6,y=2,s=27,m="STAY",d="DOWN",t={k="text",p={"I hiked a lot, but I didn't see any POKÃ©MON I wanted."}}}},wild=nil,hidden={{x=0,y=4,f="PrintBenchGuyText"},{x=13,y=3,f="OpenPokemonCenterPC"}}}return {id=224,const="SAFARI_ZONE_EAST_REST_HOUSE",w=4,h=4,ts=12,border=10,conns={},warps={{2,7,217,5},{3,7,217,5}},signs={},objs={{x=1,y=3,s=32,m="WALK",d="UP_DOWN",t={k="text",p={"How many did you catch? I'm bushed from the work!"}}},{x=4,y=2,s=33,m="STAY",d="NONE",t={k="text",p={"I caught a CHANSEY!","That makes this all worthwhile!"}}},{x=5,y=2,s=44,m="STAY",d="NONE",t={k="text",p={"Whew! I'm tired from all the fun!"}}}},wild=nil,hidden={{x=0,y=4,f="PrintBenchGuyText"},{x=13,y=3,f="OpenPokemonCenterPC"}}}return {id=225,const="SAFARI_ZONE_NORTH_REST_HOUSE",w=4,h=4,ts=12,border=10,conns={},warps={{2,7,218,9},{3,7,218,9}},signs={},objs={{x=6,y=3,s=32,m="WALK",d="LEFT_RIGHT",t={k="text",p={"You can keep any item you find on the ground here.","But, you'll run out of time if you try for all of them at once!"}}},{x=3,y=4,s=35,m="STAY",d="NONE",t={k="text",p={"Go to the deepest part of the SAFARI ZONE. You will win a prize!"}}},{x=1,y=5,s=16,m="WALK",d="UP_DOWN",t={k="text",p={"My EEVEE evolved into FLAREON!","But, a friend's EEVEE turned into a VAPOREON! I wonder why?"}}}},wild=nil,hidden={{x=0,y=4,f="PrintBenchGuyText"},{x=13,y=3,f="OpenPokemonCenterPC"}}}return {id=226,const="CERULEAN_CAVE_2F",w=15,h=9,ts=17,border=125,conns={},warps={{29,1,228,3},{22,6,228,4},{19,7,228,5},{9,1,228,6},{1,3,228,7},{3,11,228,8}},signs={},objs={{x=29,y=9,s=61,m="STAY",d="NONE",item=79,story=1},{x=4,y=15,s=61,m="STAY",d="NONE",item=2,story=1},{x=13,y=6,s=61,
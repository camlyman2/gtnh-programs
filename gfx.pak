(G,'(0.1<23((((.::.S?<<2323(.,<,23<,23HHHHJJJJ+)+);*;*HHHHJJJJHHHHJJJJ2323%&2356%&5623%&56^^8888^^^^8888^^ ! !23232387878787787823787888^^	2388^^	23	23^^88	23^^887887788778877887HH+)JJ;*%&56defgtuvw„…†‡”•–—hijkxyz{ˆ‰Š‹˜™š›hijkxyz{ˆ‰Š‹˜™š›`abcpqrs€‚ƒ‘’“defgtuvw„…†‡”•–—hijkxyz{ˆ‰Š‹˜™š›lmno|}~ŒœŸ ¡¢£°±²³ÀÁÂÃĞÑÒÓ¤¥¦§´µ¶·ÄÅÆÇÔÕÖ×¨©ª«¸¹º»ÈÉÊËØÙÚÛ¬­®¯¼½¾¿ÌÍÎÏÜİŞßreturn {[112]={kind="DRILL",ft=6,in=3,wt=2650,p={"Protected by an armor-like hide, it is capable of","living in molten lava of 3,600 degrees."}},[115]={kind="PARENT",ft=7,in=3,wt=1760,p={"The infant rarely ventures out of its mother's","protective pouch until it is 3 years old."}},[32]={kind="POISON PIN",ft=1,in=8,wt=200,p={"Stiffens its ears to sense danger. The larger its","horns, the more powerful its secreted venom."}},[35]={kind="FAIRY",ft=2,in=0,wt=170,p={"Its magical and cute appeal has many admirers.","It is rare and found only in certain areas."}},[21]={kind="TINY BIRD",ft=1,in=0,wt=40,p={"Eats bugs in grassy areas. It has to flap its","short wings at high speed to stay airborne."}},[100]={kind="BALL",ft=1,in=8,wt=230,p={"Usually found in power plants. Easily mistaken","for a POKÃ© BALL, they have zapped many people."}},[34]={kind="DRILL",ft=4,in=7,wt=1370,p={"It uses its powerful tail in battle to smash,","constrict, then break the prey's bones."}},[80]={kind="HERMITCRAB",ft=5,in=3,wt=1730,p={"The SHELLDER that is latched onto SLOWPOKE's tail","is said to feed on the host's left over scraps."}},[2]={kind="SEED",ft=3,in=3,wt=290,p={"When the bulb on its back grows large, it appears","to lose the ability to stand on its hind legs."}},[103]={kind="COCONUT",ft=6,in=7,wt=2650,p={"Legend has it that on rare occasions, one of its heads","will drop off and continue on as an EXEGGCUTE."}},[108]={kind="LICKING",ft=3,in=11,wt=1440,p={"Its tongue can be extended like a chameleon's. It","leaves a tingling sensation when it licks enemies."}},[102]={kind="EGG",ft=1,in=4,wt=60,p={"Often mistaken for eggs. When disturbed,","they quickly gather and attack in swarms."}},[88]={kind="SLUDGE",ft=2,in=11,wt=660,p={"Appears in filthy areas. Thrives by sucking up","polluted sludge that is pumped out of factories."}},[94]={kind="SHADOW",ft=4,in=11,wt=890,p={"Under a full moon, this POKÃ©MON likes to mimic","the shadows of people and laugh at their fright."}},[29]={kind="POISON PIN",ft=1,in=4,wt=150,p={"Although small, its venomous barbs render this","POKÃ©MON dangerous. The female has smaller horns."}},[31]={kind="DRILL",ft=4,in=3,wt=1320,p={"Its hard scales provide strong protection. It","uses its hefty bulk to execute powerful moves."}},[104]={kind="LONELY",ft=1,in=4,wt=140,p={"Because it never removes its skull helmet, no one","has ever seen this POKÃ©MON's real face."}},[111]={kind="SPIKES",ft=3,in=3,wt=2540,p={"Its massive bones are 1000 times harder than human","bones. It can easily knock a trailer flying."}},[131]={kind="TRANSPORT",ft=8,in=2,wt=4850,p={"A POKÃ©MON that has been over- hunted almost to","extinction. It can ferry people across the water."}},[59]={kind="LEGENDARY",ft=6,in=3,wt=3420,p={"A POKÃ©MON that has been admired since the past","for its beauty. It runs agilely as if on wings."}},[151]={kind="NEW SPECIE",ft=1,in=4,wt=90,p={"So rare that it is still said to be a mirage by","many experts. Only a few people have seen it worldwide."}},[130]={kind="ATROCIOUS",ft=21,in=4,wt=5180,p={"Rarely seen in the wild. Huge and vicious, it","is capable of destroying entire cities in a rage."}},[90]={kind="BIVALVE",ft=1,in=0,wt=90,p={"Its hard shell repels any kind of attack.","It is vulnerable only when its shell is open."}},[72]={kind="JELLYFISH",ft=2,in=11,wt=1000,p={"Drifts in shallow seas. Anglers who hook them by","accident are often punished by its stinging acid."}},[92]={kind="GAS",ft=4,in=3,wt=2,p={"Almost invisible, this gaseous POKÃ©MON cloaks","the target and puts it to sleep without notice."}},[123]={kind="MANTIS",ft=4,in=11,wt=1230,p={"With ninja-like agility and speed, it can create the","illusion that there is more than one."}},[120]={kind="STARSHAPE",ft=2,in=7,wt=760,p={"An enigmatic POKÃ©MON that can effortlessly","regenerate any appendage it loses in battle."}},[9]={kind="SHELLFISH",ft=5,in=3,wt=1890,p={"A brutal POKÃ©MON with pressurized water jets on its","shell. They are used for high speed tackles."}},[127]={kind="STAGBEETLE",ft=4,in=11,wt=1210,p={"If it fails to crush the victim in its pincers,","it will swing it around and toss it hard."}},[114]={kind="VINE",ft=3,in=3,wt=770,p={"The whole body is swathed with wide vines that are","similar to sea- weed. Its vines shake as it walks."}},[58]={kind="PUPPY",ft=2,in=4,wt=420,p={"Very protective of its territory. It will bark and","bite to repel intruders from its space."}},[95]={kind="ROCK SNAKE",ft=28,in=10,wt=4630,p={"As it grows, the stone portions of its body harden","to become similar to a diamond, but colored black."}},[22]={kind="BEAK",ft=3,in=11,wt=840,p={"With its huge and magnificent wings, it can keep aloft","without ever having to land for rest."}},[16]={kind="TINY BIRD",ft=1,in=0,wt=40,p={"A common sight in forests and woods. It flaps its","wings at ground level to kick up blinding sand."}},[79]={kind="DOPEY",ft=3,in=11,wt=790,p={"Incredibly slow and dopey. It takes 5 seconds","for it to feel pain when under attack."}},[64]={kind="PSI",ft=4,in=3,wt=1250,p={"It emits special alpha waves from its body that","induce headaches just by being close by."}},[75]={kind="ROCK",ft=3,in=3,wt=2320,p={"Rolls down slopes to move. It rolls over any obstacle","without slowing or changing its direction."}},[113]={kind="EGG",ft=3,in=7,wt=760,p={"A rare and elusive POKÃ©MON that is said to bring","happiness to those who manage to get it."}},[67]={kind="SUPERPOWER",ft=4,in=11,wt=1550,p={"Its muscular body is so powerful, it must wear a power","save belt to be able to regulate its motions."}},[122]={kind="BARRIER",ft=4,in=3,wt=1200,p={"If interrupted while it is miming, it will","slap around the offender with its broad hands."}},[106]={kind="KICKING",ft=4,in=11,wt=1100,p={"When in a hurry, its legs lengthen progressively.","It runs smoothly with extra long, loping strides."}},[107]={kind="PUNCHING",ft=4,in=7,wt=1110,p={"While apparently doing nothing, it fires punches in","lightning fast volleys that are impossible to see."}},[24]={kind="COBRA",ft=11,in=6,wt=1430,p={"It is rumored that the ferocious warning markings","on its belly differ from area to area."}},[47]={kind="MUSHROOM",ft=3,in=3,wt=650,p={"A host-parasite pair in which the parasite mushroom","has taken over the host bug. Prefers damp places."}},[54]={kind="DUCK",ft=2,in=7,wt=430,p={"While lulling its enemies with its vacant look, this","wily POKÃ©MON will use psychokinetic powers."}},[96]={kind="HYPNOSIS",ft=3,in=3,wt=710,p={"Puts enemies to sleep then eats their dreams.","Occasionally gets sick from eating bad dreams."}},[76]={kind="MEGATON",ft=4,in=7,wt=6620,p={"Its boulder-like body is extremely hard. It can","easily withstand dynamite blasts without damage."}},[126]={kind="SPITFIRE",ft=4,in=3,wt=980,p={"Its body always burns with an orange glow that","enables it to hide perfectly among flames."}},[125]={kind="ELECTRIC",ft=3,in=7,wt=660,p={"Normally found near power plants, they can wander","away and cause major blackouts in cities."}},[82]={kind="MAGNET",ft=3,in=3,wt=1320,p={"Formed by several MAGNEMITEs linked together. They","frequently appear when sunspots flare up."}},[109]={kind="POISON GAS",ft=2,in=0,wt=20,p={"Because it stores several kinds of toxic gases in","its body, it is prone to exploding without warning."}},[56]={kind="PIG MONKEY",ft=1,in=8,wt=620,p={"Extremely quick to anger. It could be docile one","moment then thrashing away the next instant."}},[86]={kind="SEA LION",ft=3,in=7,wt=1980,p={"The protruding horn on its head is very hard.","It is used for bashing through thick ice."}},[50]={kind="MOLE",ft=0,in=8,wt=20,p={"Lives about one yard underground where it feeds on","plant roots. It sometimes appears above ground."}},[128]={kind="WILD BULL",ft=4,in=7,wt=1950,p={"When it targets an enemy, it charges furiously","while whipping its body with its long tails."}},[83]={kind="WILD DUCK",ft=2,in=7,wt=330,p={"The sprig of green onions it holds is its","weapon. It is used much like a metal sword."}},[48]={kind="INSECT",ft=3,in=3,wt=660,p={"Lives in the shadows of tall trees where it","eats insects. It is attracted by light at night."}},[149]={kind="DRAGON",ft=7,in=3,wt=4630,p={"An extremely rarely seen marine POKÃ©MON.","Its intelligence is said to match that of humans."}},[84]={kind="TWIN BIRD",ft=4,in=7,wt=860,p={"A bird that makes up for its poor flying with its","fast foot speed. Leaves giant footprints."}},[60]={kind="TADPOLE",ft=2,in=0,wt=270,p={"Its newly grown legs prevent it from running. It","appears to prefer swimming than trying to stand."}},[124]={kind="HUMANSHAPE",ft=4,in=7,wt=900,p={"It seductively wiggles its hips as it walks. It","can cause people to dance in unison with it."}},[146]={kind="FLAME",ft=6,in=7,wt=1320,p={"Known as the legendary bird of fire. Every flap","of its wings creates a dazzling flash of flames."}},[144]={kind="FREEZE",ft=5,in=7,wt=1220,p={"A legendary bird POKÃ©MON that is said to appear to","doomed people who are lost in icy mountains."}},[145]={kind="ELECTRIC",ft=5,in=3,wt=1160,p={"A legendary bird POKÃ©MON that is said to appear","from clouds while dropping enormous lightning bolts."}},[132]={kind="TRANSFORM",ft=1,in=0,wt=90,p={"Capable of copying an enemy's genetic code to instantly","transform itself into a duplicate of the enemy."}},[52]={kind="SCRATCHCAT",ft=1,in=4,wt=90,p={"Adores circular objects. Wanders the streets on a","nightly basis to look for dropped loose change."}},[98]={kind="RIVER CRAB",ft=1,in=4,wt=140,p={"Its pincers are not only powerful weapons, they are","used for balance when walking sideways."}},[37]={kind="FOX",ft=2,in=0,wt=220,p={"At the time of birth, it has just one tail.","The tail splits from its tip as it grows older."}},[38]={kind="FOX",ft=3,in=7,wt=440,p={"Very smart and very vengeful. Grabbing one of","its many tails could result in a 1000-year curse."}},[25]={kind="MOUSE",ft=1,in=4,wt=130,p={"When several of these POKÃ©MON gather, their","electricity could build and cause lightning storms."}},[26]={kind="MOUSE",ft=2,in=7,wt=660,p={"Its long tail serves as a ground to protect","itself from its own high voltage power."}},[147]={kind="DRAGON",ft=5,in=11,wt=70,p={"Long considered a mythical POKÃ©MON until recently","when a small colony was found living underwater."}},[148]={kind="DRAGON",ft=13,in=1,wt=360,p={"A mystical POKÃ©MON that exudes a gentle aura.","Has the ability to change climate conditions."}},[140]={kind="SHELLFISH",ft=1,in=8,wt=250,p={"A POKÃ©MON that was resurrected from a fossil","found in what was once the ocean floor eons ago."}},[141]={kind="SHELLFISH",ft=4,in=3,wt=890,p={"Its sleek shape is perfect for swim- ming. It slashes","prey with its claws and drains the body fluids."}},[116]={kind="DRAGON",ft=1,in=4,wt=180,p={"Known to shoot down flying bugs with precision","blasts of ink from the surface of the water."}},[117]={kind="DRAGON",ft=3,in=11,wt=550,p={"Capable of swim- ming backwards by rapidly flapping","its wing-like pectoral fins and stout tail."}},[27]={kind="MOUSE",ft=2,in=0,wt=260,p={"Burrows deep underground in arid locations","far from water. It only emerges to hunt for food."}},[28]={kind="MOUSE",ft=3,in=3,wt=650,p={"Curls up into a spiny ball when threatened. It","can roll while curled up to attack or escape."}},[138]={kind="SPIRAL",ft=1,in=4,wt=170,p={"Although long extinct, in rare cases, it can be","genetically resurrected from fossils."}},[139]={kind="SPIRAL",ft=3,in=3,wt=770,p={"A prehistoric POKÃ©MON that died out when its","heavy shell made it impossible to catch prey."}},[39]={kind="BALLOON",ft=1,in=8,wt=120,p={"When its huge eyes light up, it sings a mysteriously","soothing melody that lulls its enemies to sleep."}},[40]={kind="BALLOON",ft=3,in=3,wt=260,p={"The body is soft and rubbery. When angered, it will","suck in air and inflate itself to an enormous size."}},[133]={kind="EVOLUTION",ft=1,in=0,wt=140,p={"Its genetic code is irregular. It may mutate if","it is exposed to radiation from element STONEs."}},[136]={kind="FLAME",ft=2,in=11,wt=550,p={"When storing thermal energy in its body, its","temperature could soar to over 1600 degrees."}},[135]={kind="LIGHTNING",ft=2,in=7,wt=540,p={"It accumulates negative ions in the atmosphere to","blast out 10000- volt lightning bolts."}},[134]={kind="BUBBLE JET",ft=3,in=3,wt=640,p={"Lives close to water. Its long tail is ridged","with a fin which is often mistaken for a mermaid's."}},[66]={kind="SUPERPOWER",ft=2,in=7,wt=430,p={"Loves to build its muscles. It trains in all","styles of martial arts to become even stronger."}},[41]={kind="BAT",ft=2,in=7,wt=170,p={"Forms colonies in perpetually dark places. Uses","ultrasonic waves to identify and approach targets."}},[23]={kind="SNAKE",ft=6,in=7,wt=150,p={"Moves silently and stealthily. Eats the eggs of","birds, such as PIDGEY and SPEAROW, whole."}},[46]={kind="MUSHROOM",ft=1,in=0,wt=120,p={"Burrows to suck tree roots. The mushrooms on its","back grow by draw- ing nutrients from the bug host."}},[61]={kind="TADPOLE",ft=3,in=3,wt=440,p={"Capable of living in or out of water. When out","of water, it sweats to keep its body slimy."}},[62]={kind="TADPOLE",ft=4,in=3,wt=1190,p={"An adept swimmer at both the front crawl and breast","stroke. Easily overtakes the best human swimmers."}},[13]={kind="HAIRY BUG",ft=1,in=0,wt=70,p={"Often found in forests, eating leaves.","It has a sharp venomous stinger on its head."}},[14]={kind="COCOON",ft=2,in=0,wt=220,p={"Almost incapable of moving, this POKÃ©MON can only","harden its shell to protect itself from predators."}},[15]={kind="POISON BEE",ft=3,in=3,wt=650,p={"Flies at high speed and attacks using its large","venomous stingers on its forelegs and tail."}},[85]={kind="TRIPLEBIRD",ft=5,in=11,wt=1880,p={"Uses its three brains to execute complex plans.","While two heads sleep, one head stays awake."}},[57]={kind="PIG MONKEY",ft=3,in=3,wt=710,p={"Always furious and tenacious to boot. It will not","abandon chasing its quarry until it is caught."}},[51]={kind="MOLE",ft=2,in=4,wt=730,p={"A team of DIGLETT triplets. It triggers huge","earthquakes by burrowing 60 miles underground."}},[49]={kind="POISONMOTH",ft=4,in=11,wt=280,p={"The dust-like scales covering its wings are","color coded to indicate the kinds of poison it has."}},[87]={kind="SEA LION",ft=5,in=7,wt=2650,p={"Stores thermal energy in its body. Swims at a","steady 8 knots even in intensely cold waters."}},[10]={kind="WORM",ft=1,in=0,wt=60,p={"Its short feet are tipped with suction pads that","enable it to tirelessly climb slopes and walls."}},[11]={kind="COCOON",ft=2,in=4,wt=220,p={"This POKÃ©MON is vulnerable to attack while its","shell is soft, exposing its weak and tender body."}},[12]={kind="BUTTERFLY",ft=3,in=7,wt=710,p={"In battle, it flaps its wings at high speed to","release highly toxic dust into the air."}},[68]={kind="SUPERPOWER",ft=5,in=3,wt=2870,p={"Using its heavy muscles, it throws powerful punches","that can send the victim clear over the horizon."}},[55]={kind="DUCK",ft=5,in=7,wt=1690,p={"Often seen swim- ming elegantly by lake shores. It","is often mistaken for the Japanese monster, Kappa."}},[97]={kind="HYPNOSIS",ft=5,in=3,wt=1670,p={"When it locks eyes with an enemy, it will use a mix of","PSI moves such as HYPNOSIS and CONFUSION."}},[42]={kind="BAT",ft=5,in=3,wt=1210,p={"Once it strikes, it will not stop draining energy","from the victim even if it gets too heavy to fly."}},[150]={kind="GENETIC",ft=6,in=7,wt=2690,p={"It was created by a scientist after years of horrific","gene splicing and DNA engineering experiments."}},[143]={kind="SLEEPING",ft=6,in=11,wt=10140,p={"Very lazy. Just eats and sleeps. As its rotund","bulk builds, it becomes steadily more slothful."}},[129]={kind="FISH",ft=2,in=11,wt=220,p={"In the distant past, it was somewhat stronger","than the horribly weak descendants that exist today."}},[89]={kind="SLUDGE",ft=3,in=11,wt=660,p={"Thickly covered with a filthy, vile sludge. It","is so toxic, even its footprints contain poison."}},[99]={kind="PINCER",ft=4,in=3,wt=1320,p={"The large pincer has 10000 hp of crushing power.","However, its huge size makes it unwieldy to use."}},[91]={kind="BIVALVE",ft=4,in=11,wt=2920,p={"When attacked, it launches its horns in quick","volleys. Its innards have never been seen."}},[101]={kind="BALL",ft=3,in=11,wt=1470,p={"It stores electric energy under very high pressure.","It often explodes with little or no provocation."}},[36]={kind="FAIRY",ft=4,in=3,wt=880,p={"A timid fairy POKÃ©MON that is rarely seen. It","will run and hide the moment it senses people."}},[110]={kind="POISON GAS",ft=3,in=11,wt=210,p={"Where two kinds of poison gases meet, 2 KOFFINGs","can fuse into a WEEZING over many years."}},[53]={kind="CLASSY CAT",ft=3,in=3,wt=710,p={"Although its fur has many admirers, it is tough to","raise as a pet because of its fickle meanness."}},[105]={kind="BONEKEEPER",ft=3,in=3,wt=990,p={"The bone it holds is its key weapon. It throws the","bone skillfully like a boomerang to KO targets."}},[93]={kind="GAS",ft=5,in=3,wt=2,p={"Because of its ability to slip through block","walls, it is said to be from an- other dimension."}},[63]={kind="PSI",ft=2,in=11,wt=430,p={"Using its ability to read minds, it will identify","impending danger and TELEPORT to safety."}},[65]={kind="PSI",ft=4,in=11,wt=1060,p={"Its brain can out- perform a super- computer.","Its intelligence quotient is said to be 5,000."}},[17]={kind="BIRD",ft=3,in=7,wt=660,p={"Very protective of its sprawling territorial area,","this POKÃ©MON will fiercely peck at any intruder."}},[18]={kind="BIRD",ft=4,in=11,wt=870,p={"When hunting, it skims the surface of water at high","speed to pick off unwary prey such as MAGIKARP."}},[121]={kind="MYSTERIOUS",ft=3,in=7,wt=1760,p={"Its central core glows with the seven colors of","the rainbow. Some people value the core as a gem."}},[1]={kind="SEED",ft=2,in=4,wt=150,p={"A strange seed was planted on its back at birth.","The plant sprouts and grows with this POKÃ©MON."}},[3]={kind="SEED",ft=6,in=7,wt=2210,p={"The plant blooms when it is absorbing solar","energy. It stays on the move to seek sunlight."}},[73]={kind="JELLYFISH",ft=5,in=3,wt=1210,p={"The tentacles are normally kept short. On hunts,","they are extended to ensnare and immobilize prey."}},[118]={kind="GOLDFISH",ft=2,in=0,wt=330,p={"Its tail fin billows like an elegant ballroom","dress, giving it the nickname of the Water Queen."}},[119]={kind="GOLDFISH",ft=4,in=3,wt=860,p={"In the autumn spawning season, they can be seen","swimming power- fully up rivers and creeks."}},[77]={kind="FIRE HORSE",ft=3,in=3,wt=660,p={"Its hooves are 10 times harder than diamonds. It can","trample anything completely flat in little time."}},[78]={kind="FIRE HORSE",ft=5,in=7,wt=2090,p={"Very competitive, this POKÃ©MON will chase anything","that moves fast in the hopes of racing it."}},[19]={kind="RAT",ft=1,in=0,wt=80,p={"Bites anything when it attacks. Small and very","quick, it is a common sight in many places."}},[20]={kind="RAT",ft=2,in=4,wt=410,p={"It uses its whis- kers to maintain its balance.","It apparently slows down if they are cut off."}},[33]={kind="POISON PIN",ft=2,in=11,wt=430,p={"An aggressive POKÃ©MON that is quick to attack.","The horn on its head secretes a powerful venom."}},[30]={kind="POISON PIN",ft=2,in=7,wt=440,p={"The female's horn develops slowly. Prefers physical","attacks such as clawing and biting."}},[74]={kind="ROCK",ft=1,in=4,wt=440,p={"Found in fields and mountains. Mistaking them","for boulders, people often step or trip on them."}},[137]={kind="VIRTUAL",ft=2,in=7,wt=800,p={"A POKÃ©MON that consists entirely of programming","code. Capable of moving freely in cyberspace."}},[142]={kind="FOSSIL",ft=5,in=11,wt=1300,p={"A ferocious, pre- historic POKÃ©MON that goes for the","enemy's throat with its serrated saw-like fangs."}},[81]={kind="MAGNET",ft=1,in=0,wt=130,p={"Uses anti-gravity to stay suspended. Appears without","warning and uses THUNDER WAVE and similar moves."}},[4]={kind="LIZARD",ft=2,in=0,wt=190,p={"Obviously prefers hot places. When it rains, steam","is said to spout from the tip of its tail."}},[7]={kind="TINYTURTLE",ft=1,in=8,wt=200,p={"After birth, its back swells and hardens into a","shell. Powerfully sprays foam from its mouth."}},[5]={kind="FLAME",ft=3,in=7,wt=420,p={"When it swings its burning tail, it elevates the","temperature to unbearably high levels."}},[8]={kind="TURTLE",ft=3,in=3,wt=500,p={"Often hides in water to stalk unwary prey. For","swimming fast, it moves its ears to maintain balance."}},[6]={kind="FLAME",ft=5,in=7,wt=2000,p={"Spits fire that is hot enough to melt boulders.","Known to cause forest fires unintentionally."}},[43]={kind="WEED",ft=1,in=8,wt=120,p={"During the day, it keeps its face buried in the","ground. At night, it wanders around sowing its seeds."}},[44]={kind="WEED",ft=2,in=7,wt=190,p={"The fluid that oozes from its mouth isn't drool.","It is a nectar that is used to attract prey."}},[45]={kind="FLOWER",ft=3,in=11,wt=410,p={"The larger its petals, the more toxic pollen it","contains. Its big head is heavy and hard to hold up."}},[69]={kind="FLOWER",ft=2,in=4,wt=90,p={"A carnivorous POKÃ©MON that traps and eats bugs.","It uses its root feet to soak up needed moisture."}},[70]={kind="FLYCATCHER",ft=3,in=3,wt=140,p={"It spits out POISONPOWDER to immobilize the","enemy and then finishes it with a spray of ACID."}},[71]={kind="FLYCATCHER",ft=5,in=7,wt=340,p={"Said to live in huge colonies deep in jungles,","although no one has ever returned from there."}}}((␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀€␀␀␀␀␀␀␀␀0à␀␀␀␀␀␀␀/Âp␀␀␀␀␀␀Íp␀␀␀␀␀ğ4p␀␀␀␀␀@^p␀␀␀␀␀0Ğnl␀␀␀␀␀ç@V­␀␀␀␀®ê¹À␀␀Ã®°z¹°␀␀1sÿÁn¹°␀␀0}UÕ®äÜ␀␀0␀Uv»¤Ü␀␀␀}j¯ZÜ␀␀0õº«åjÌ␀␀ÃVúºú«Œ␀␀ÌÕ[¾®®␀␀÷Õ[×ª«øh␀3UWÃªºå°␀UUU¿ªúêÀ␀»ÿşÀêúÿ␀␀ÿÿ␀zª¼␀␀<•W␀[¯¬␀␀␀ÿÿZª«␀␀p␀ÅjµªÀ␀␀å¬m®áZÀ␀␀ûUWúĞVğ␀␀␀µZ«€°␀␀␀ê«@°␀␀␀¿ÿ°␀␀␀j³äZ°␀␀␀␀µªìúªÀ␀␀␀␀ş¬êÀ␀␀␀␀␀°«␀␀␀␀␀␀À␀ü␀␀((␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ÿÀ␀␀␀␀␀␀␀õU|␀␀␀␀␀␀óıW␀␀␀␀␀␀Ì•À␀␀␀␀␀ÍL°5°␀␀␀␀␀3s‡É°␀␀␀␀␀üÍÏÎ¼␀␀␀␀␀÷yÏÎ¼␀␀␀␀␀ûıp:û␀␀␀␀␀.«Ÿêë␀␀␀␀␀4Vê««␀␀␀␀␀3şº¶¬␀␀␀␀␀«¿Õ¬À␀␀␀«ÿÕp`␀␀␀üëõÀp␀␀␀␀?Öÿ°p␀␀␀␀Ó°p␀␀␀␀×^°`␀␀␀␀>ºìÀ␀␀␀␀ªë¬À␀␀␀␀ş¬:À␀␀␀␀1Ìu»:À␀␀␀␀5íuÚï␀␀␀␀␀?ÃW¬␀␀␀␀␀␀ü|␀␀␀␀␀␀␀óÀ␀␀((␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀/ş␀␀␀␀␀␀␀ÕUà␀␀␀␀␀␀-mj®␀␀␀␀␀␀Ñ`[êÀ␀␀␀␀µ°}j°␀␀␀␀^·Ôì␀␀␀␀7®p¾␀␀␀␀42ªğ.ï␀␀␀␀7>ªª»¿€␀␀␀ªªÿê®ÿÀ␀␀␀ê½@ûÿÀ␀␀␀ïP␀_ÿÀ␀␀␀ş␀␀UÀ␀␀␀Ğ␀␀UU[À␀␀␀À␀UUVÀ␀␀␀€␀UUU€␀␀␀ ␀UUV␀␀␀␀0␀UUV␀␀␀␀␀UU\␀␀␀␀␀UUX␀␀␀␀␀

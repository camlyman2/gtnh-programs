re POKÃ©MON!"},s=1}},{x=11,y=14,s=12,m="STAY",d="DOWN",opp={8,11},t={k="text",p={"I know why BLAINE became a trainer!"},s=1}},{x=3,y=14,s=12,m="STAY",d="DOWN",opp={11,6},t={k="text",p={"I've been to many GYMs, but this is my favorite!"},s=1}},{x=3,y=8,s=12,m="STAY",d="DOWN",opp={8,12},t={k="text",p={"Fire is weak against H2O!"},s=1}},{x=16,y=13,s=36,m="STAY",d="DOWN",t={k="text",p={"Yo! Champ in making!","The hot-headed BLAINE is a fire POKÃ©MON pro!","Douse his spirits with water!","You better take some BURN HEALs!"},s=1}}},wild=nil,hidden={{x=17,y=13,f="GymStatues"}}}return {id=167,const="CINNABAR_LAB",w=9,h=4,ts=20,border=23,conns={},warps={{2,7,255,3},{3,7,255,3},{8,4,168,1},{12,4,169,1},{16,4,170,1}},signs={{x=3,y=2,t={k="text",p={"A photo of the LAB's founder, DR.FUJI!"}}},{x=9,y=4,t={k="text",p={"POKÃ©MON LAB Meeting Room"}}},{x=13,y=4,t={k="text",p={"POKÃ©MON LAB R-and-D Room"}}},{x=17,y=4,t={k="text",p={"POKÃ©MON LAB Testing Room"}}}},objs={{x=1,y=3,s=39,m="STAY",d="NONE",t={k="text",p={"We study POKÃ©MON extensively here.","People often bring us rare POKÃ©MON for examination."}}}},wild=nil,hidden={}}return {id=168,const="CINNABAR_LAB_TRADE_ROOM",w=4,h=4,ts=20,border=23,conns={},warps={{2,7,167,3},{3,7,167,3}},signs={},objs={{x=3,y=2,s=12,m="STAY",d="DOWN",t={k="text",p={"I found this very strange fossil in MT.MOON!","I think it's a rare, prehistoric POKÃ©MON!"}}},{x=1,y=4,s=37,m="STAY",d="NONE"},{x=5,y=5,s=15,m="STAY",d="UP"}},wild=nil,hidden={}}return {id=169,const="CINNABAR_LAB_METRONOME_ROOM",w=4,h=4,ts=20,border=23,conns={},warps={{2,7,167,4},{3,7,167,4}},signs={{x=0,y=4,t={k="text",p={"There's an e-mail message!","...","The 3 legendary bird POKÃ©MON are ARTICUNO, ZAPDOS and MOLTRES.","Their whereabouts are unknown.","We plan to explore the cavern close to CERULEAN.","From: POKÃ©MON RESEARCH TEAM","..."}}},{x=1,y=4,t={k="text",p={"There's an e-mail message!","...","The 3 legendary bird POKÃ©MON are ARTICUNO, ZAPDOS and MOLTRES.","Their whereabouts are unknown.","We plan to explore the cavern close to CERULEAN.","From: POKÃ©MON RESEARCH TEAM","..."}}},{x=2,y=1,t={k="text",p={"An amber pipe!"}}}},objs={{x=7,y=2,s=32,m="STAY",d="DOWN",t={k="text",p={"Tch-tch-tch! I made a cool TM!","It can cause all kinds of fun!"},s=1}},{x=2,y=3,s=32,m="WALK",d="LEFT_RIGHT",t={k="text",p={"EEVEE can evolve into 1 of 3 kinds of POKÃ©MON."}}}},wild=nil,hidden={}}return {id=17,const="ROUTE_6",w=10,h=18,ts=0,border=15,conns={{"north",10,-5},{"south",5,-5}},warps={{9,1,73,3},{10,1,73,3},{10,7,73,1},{17,13,74,1}},signs={{x=19,y=15,t={k="text",p={"UNDERGROUND PATH CERULEAN CITY - VERMILION CITY"}}}},objs={{x=10,y=21,s=7,m="STAY",d="RIGHT",opp={5,4},t={k="trainer",range=0,b={"Who's there? Quit listening in on us!"},e={"I just can't win!"},a={"Whisper... whisper..."}}},{x=11,y=21,s=6,m="STAY",d="LEFT",opp={6,2},t={k="trainer",range=0,b={"Excuse me! This is a private conversation!"},e={"Ugh! I hate losing!"},a={"Whisper... whisper..."}}},{x=0,y=15,s=4,m="STAY",d="RIGHT",opp={2,10},t={k="trainer",range=4,b={"There aren't many bugs out here."},e={"No! You're kidding!"},a={"I like bugs, so I'm going back to VIRIDIAN FOREST."}}},{x=11,y=31,s=7,m="STAY",d="LEFT",opp={5,5},t={k="trainer",range=3,b={"Huh? You want to talk to me?"},e={"I didn't start it!"},a={"I should carry more POKÃ©MON with me for safety."}}},{x=11,y=30,s=6,m="STAY",d="LEFT",opp={6,3},t={k="trainer",range=3,b={"Me? Well, OK. I'll play!"},e={"Just didn't work!"},a={"I want to get stronger! What's your secret?"}}},{x=19,y=26,s=4,m="STAY",d="LEFT",opp={2,11},t={k="trainer",range=3,b={"I've never seen you around! Are you good?"},e={"You are too good!"},a={"Are my POKÃ©MON weak? Or, am I just bad?"}}}},wild={gr=15,g={{13,43},{13,16},{15,16},{10,56},{12,56},{15,43},{16,43},{16,16},{14,56},{16,56}},wr=0,w={}},hidden={}}return {id=170,const="CINNABAR_LAB_FOSSIL_ROOM",w=4,h=4,ts=20,border=23,conns={},warps={{2,7,167,5},{3,7,167,5}},signs={},objs={{x=5,y=2,s=32,m="WALK",d="LEFT_RIGHT",t={k="text",p={"Hiya!","I am important doctor!","I study here rare POKÃ©MON fossils!","You! Have you a fossil for me?"},s=1}},{x=7,y=6,s=32,m="STAY",d="UP",t={k="trade",nick="SAILOR"}}},wild=nil,hidden={{x=0,y=4,f="OpenPokemonCenterPC"},{x=2,y=4,f="OpenPokemonCenterPC"}}}return {id=171,const="CINNABAR_POKECENTER",w=7,h=4,ts=6,border=0,conns={},warps={{3,7,255,4},{4,7,255,4}},signs={},objs={{x=3,y=1,s=41,m="STAY",d="DOWN",t={k="nurse"}},{x=9,y=4,s=6,m="WALK",d="ANY_DIR",t={k="text",p={"You can cancel evolution.","When a POKÃ©MON is evolving, you can stop it and leave it the way it is."}}},{x=2,y=6,s=16,m="STAY",d="NONE",t={k="text",p={"Do you have any friends?","POKÃ©MON you get in trades grow very quickly.","I think it's worth a try!"}}},{x=11,y=2,s=42,m="STAY",d="DOWN",t={k="cable"}}},wild=nil,hidden={{x=0,y=4,f="PrintBenchGuyText"},{x=13,y=3,f="OpenPokemonCenterPC"}}}return {id=172,const="CINNABAR_MART",w=4,h=4,ts=2,border=0,conns={},warps={{3,7,255,5},{4,7,255,5}},signs={},objs={{x=0,y=5,s=38,m="STAY",d="RIGHT",t={k="mart",items={2,3,18,57,29,52,53}}},{x=6,y=2,s=27,m="STAY",d="NONE",t={k="text",p={"Don't they have X ATTACK? It's good for battles!"}}},{x=3,y=4,s=32,m="STAY",d="NONE",t={k="text",p={"It never hurts to have extra items!"}}}},wild=nil,hidden={}}return {id=174,const="INDIGO_PLATEAU_LOBBY",w=8,h=6,ts=2,border=0,conns={},warps={{7,11,255,1},{8,11,255,2},{8,0,245,1}},signs={},objs={{x=7,y=5,s=41,m="STAY",d="DOWN",t={k="nurse"}},{x=4,y=9,s=36,m="STAY",d="RIGHT",t={k="text",p={"Yo! Champ in making!","At POKÃ©MON LEAGUE, you have to face the ELITE FOUR in succession.","If you lose, you have to start all over again! This is it! Go for it!"}}},{x=5,y=1,s=6,m="STAY",d="DOWN",t={k="text",p={"From here on, you face the ELITE FOUR one by one!","If you win, a door opens to the next trainer! Good luck!"}}},{x=0,y=5,s=38,m="STAY",d="RIGHT",t={k="mart",items={2,3,16,17,52,53,57}}},{x=13,y=6,s=42,m="STAY",d="DOWN",t={k="cable"}}},wild=nil,hidden={{x=15,y=7,f="OpenPokemonCenterPC"}}}return {id=175,const="COPYCATS_HOUSE_1F",w=4,h=4,ts=1,border=10,conns={},warps={{2,7,255,1},{3,7,255,1},{7,1,176,1}},signs={},objs={{x=2,y=2,s=28,m="STAY",d="DOWN",t={k="text",p={"My daughter is so self-centered. She only has a few friends."}}},{x=5,y=4,s=10,m="STAY",d="LEFT",t={k="text",p={"My daughter likes to mimic people.","Her mimicry has earned her the nickname COPYCAT around here!"}}},{x=1,y=4,s=56,m="WALK",d="UP_DOWN",t={k="text",p={"CHANSEY: Chaan! Sii!"}}}},wild=nil,hidden={}}return {id=176,const="COPYCATS_HOUSE_2F",w=4,h=4,ts=4,border=10,conns={},warps={{7,1,175,3}},signs={{x=3,y=5,t={k="text",p={"A game with MARIO wearing a bucket on his head!"}}},{x=0,y=1,t={k="text",p={"...","My Secrets!","Skill: Mimicry! Hobby: Collecting dolls! Favorite POKÃ©MON: CLEFAIRY!"},s=1}}},objs={{x=4,y=3,s=29,m="WALK",d="ANY_DIR",t={k="text",p={"RED: Hi! Do you like POKÃ©MON?","RED: Uh no, I just asked you.","RED: Huh? You're strange!","COPYCAT: Hmm? Quit mimicking?","But, that's my favorite hobby!"},s=1}},{x=4,y=6,s=9,m="WALK",d="LEFT_RIGHT",t={k="text",p={"DODUO: Giiih!","MIRROR MIRROR ON THE WALL, WHO IS THE FAIREST ONE OF ALL?"}}},{x=5,y=1,s=5,m="STAY",d="DOWN",t={k="text",p={"This is a rare POKÃ©MON! Huh? It's only a doll!"}}},{x=2,y=0,s=9,m="STAY",d="DOWN",t={k="text",p={"This is a rare POKÃ©MON! Huh? It's only a doll!"}}},{x=1,y=6,s=56,m="STAY",d="RIGHT",t={k="text",p={"This is a rare POKÃ©MON! Huh? It's only a doll!"}}}},wild=nil,hidden={{x=1,y=1,f="HiddenItems",item=49}}}return {id=177,const="FIGHTING_DOJO",w=5,h=6,ts=5,border=3,conns={},warps={{4,11,255,2},{5,11,255,2}},signs={},objs={{x=5,y=3,s=14,m="STAY",d="DOWN",opp={24,1},t={k="text",p={"Grunt!","I am the KARATE MASTER! I am the LEADER here!","You wish to challenge us? Expect no mercy!","Fwaaa!"},s=1}},{x=3,y=4,s=14,m="STAY",d="RIGHT",opp={24,2},t={k="trainer",range=4,b={"Hoargh! Take your shoes off!"},e={"I give up!"},a={"You wait 'til you see our Master!","I'm a small fry compared to him!"}}},{x=3,y=6,s=14,m="STAY",d="RIGHT",opp={24,3},t={k="trainer",range=4,b={"I hear you're good! Show me!"},e={"Judge! 1 point!"},a={"Our Master is a pro fighter!"}}},{x=5,y=5,s=14,m="STAY",d="LEFT",opp={24,4},t={k="trainer",range=3,b={"Nothing tough frightens me!","I break boulders for training!"},e={"Yow! Stubbed fingers!"},a={"The only thing that frightens us is psychic power!"}}},{x=5,y=7,s=14,m="STAY",d="LEFT",opp={24,5},t={k="trainer",range=3,b={"Hoohah!","You're trespassing in our FIGHTING DOJO!"},e={"Oof! I give up!"},a={"The prime fighters across the land train here."}}},{x=4,y=1,s=61,m="STAY",d="NONE",t={k="text",p={"You want the hard kicking HITMONLEE?"},s=1},story=1},{x=5,y=1,s=61,m="STAY",d="NONE",t={k="text",p={"You want the piston punching HITMONCHAN?"},s=1},story=1}},wild=nil,hidden={{x=3,y=9,f="PrintFightingDojoText"},{x=6,y=9,f="PrintFightingDojoText"},{x=4,y=0,f="PrintFightingDojoText2"},{x=5,y=0,f="PrintFightingDojoText3"}}}return {id=178,const="SAFFRON_GYM",w=10,h=9,ts=22,border=46,conns={},warps={{8,17,255,3},{9,17,255,3},{1,3,178,23},{5,3,178,16},{1,5,178,19},{5,5,178,9},{1,9,178,28},{5,9,178,17},{1,11,178,6},{5,11,178,14},{1,15,178,24},{5,15,178,31},{1,17,178,18},{5,17,178,10},{9,3,178,27},{11,3,178,4},{9,5,178,8},{11,5,178,13},{11,11,178,5},{11,15,178,32},{15,3,178,25},{19,3,178,29},{15,5,178,3},{19,5,178,11},{15,9,178,21},{19,9,178,30},{15,11,178,15},{19,11,178,7},{15,15,178,22},{19,15,178,26},{15,17,178,12},{19,17,178,20}},signs={},objs={{x=9,y=8,s=13,m="STAY",d="DOWN",opp={40,1},t={k="text",p={"I had a vision of your arrival!","I have had psychic powers since I was a child.","I first learned to bend spoons with my mind.","I dislike fight- ing, but if you wish, I will show you my powers!"},s=1}},{x=10,y=1,s=25,m="STAY",d="DOWN",opp={45,22},t={k="trainer",range=3,b={"SABRINA is younger than I, but I respect her!"},e={"Not good enough!"},a={"In a battle of equals, the one with the stronger will wins!","If you wish to beat SABRINA, focus on winning!"}}},{x=17,y=1,s=4,m="STAY",d="DOWN",opp={19,1},t={k="trainer",range=3,b={"Does our unseen power scare you?"},e={"I never foresaw this!"},a={"Psychic POKÃ©MON fear only ghosts and bugs!"}}},{x=3,y=7,s=25,m="STAY",d="DOWN",opp={45,23},t={k="trainer",range=3,b={"POKÃ©MON take on the appearance of their trainers.","Your POKÃ©MON must be tough, then!"},e={"I knew it!"},a={"I must teach better techniques to my POKÃ©MON!"}}},{x=17,y=7,s=4,m="STAY",d="DOWN",opp={19,2},t={k="trainer",range=3,b={"You know that power alone isn't enough!"},e={"I don't believe this!"},a={"SABRINA just wiped out the KARATE MASTER next door!"}}},{x=3,y=13,s=25,m="STAY",d="DOWN",opp={45,24},t={k="trainer",range=3,b={"You and I, our POKÃ©MON shall fight!"},e={"I lost after all!"},a={"I knew that this was going to take place."}}},{x=17,y=13,s=4,m="STAY",d="DOWN",opp={19,3},t={k="trainer",range=3,b={"SABRINA is young, but she's also our LEADER!","You won't reach her easily!"},e={"I lost my concentration!"},a={"There used to be 2 POKÃ©MON GYMs in SAFFRON.","The FIGHTING DOJO next door lost its GYM status when we went and creamed them!"}}},{x=3,y=1,s=4,m="STAY",d="DOWN",opp={19,4},t={k="trainer",range=3,b={"SAFFRON POKÃ©MON GYM is famous for its psychics!","You want to see SABRINA! I can tell!"},e={"Arrrgh!"},a={"That's right! I used telepathy to read your mind!"}}},{x=10,y=15,s=36,m="STAY",d="DOWN",t={k="text",p={"Yo! Champ in making!","SABRINA's POKÃ©MON use psychic power instead of force!","Fighting POKÃ©MON are weak against psychic POKÃ©MON!","They get creamed before they can even aim a punch!"},s=1}}},wild=nil,hidden={{x=9,y=15,f="GymStatues"}}}return {id=179,const="SAFFRON_PIDGEY_HOUSE",w=4,h=4,ts=8,border=10,conns={},warps={{2,7,255,4},{3,7,255,4}},signs={},objs={{x=2,y=3,s=29,m="STAY",d="RIGHT",t={k="text",p={"Thank you for writing. I hope to see you soon!","Hey! Don't look at my letter!"}}},{x=0,y=4,s=9,m="WALK",d="UP_DOWN",t={k="text",p={"PIDGEY: Kurukkoo!"}}},{x=4,y=1,s=4,m="STAY",d="DOWN",t={k="text",p={"The COPYCAT is cute! I'm getting her a POKÃ© DOLL!"}}},{x=3,y=3,s=64,m="STAY",d="NONE",t={k="text",p={"I was given a PP UP as a gift.","It's used for increasing the PP of techniques!"}}}},wild=nil,hidden={}}return {id=18,const="ROUTE_7",w=10,h=9,ts=0,border=15,conns={{"west",6,-4},{"east",10,-4}},warps={{18,9,76,3},{18,10,76,4},{11,9,76,1},{11,10,76,2},{5,13,77,1}},signs={{x=3,y=13,t={k="text",p={"UNDERGROUND PATH CELADON CITY - LAVENDER TOWN"}}}},objs={},wild={gr=15,g={{19,16},{19,43},{17,56},{22,43},{22,16},{18,56},{18,58},{20,58},{19,56},{20,56}},wr=0,w={}},hidden={}}return {id=180,const="SAFFRON_MART",w=4,h=4,ts=2,border=0,conns={},warps={{3,7,255,5},{4,7,255,5}},signs={},objs={{x=0,y=5,s=38,m="STAY",d="RIGHT",t={k="mart",items={3,18,57,29,52,53}}},{x=4,y=2,s=12,m="STAY",d="NONE",t={k="text",p={"MAX REPEL lasts longer than SUPER REPEL for keeping weaker POKÃ©MON away!"}}},{x=6,y=5,s=6,m="WALK",d="ANY_DIR",t={k="text",p={"REVIVE is costly, but it revives fainted POKÃ©MON!"}}}},wild=nil,hidden={}}return {id=181,const="SILPH_CO_1F",w=15,h=9,ts=22,border=46,conns={},warps={{10,17,255,6},{11,17,255,6},{26,0,207,1},{20,0,236,1},{16,10,208,7}},signs={},objs={{x=4,y=2,s=42,m="STAY",d="DOWN",t={k="text",p={"Welcome!","The PRESIDENT is in the boardroom on 11F!"}},hide=1}},wild=nil,hidden={}}return {id=182,const="SAFFRON_POKECENTER",w=7,h=4,ts=6,border=0,conns={},warps={{3,7,255,7},{4,7,255,7}},signs={},objs={{x=3,y=1,s=41,m="STAY",d="DOWN",t={k="nurse"}},{x=5,y=5,s=15,m="STAY",d="NONE",t={k="text",p={"POKÃ©MON growth rates differ from specie to specie."}}},{x=8,y=3,s=16,m="STAY",d="DOWN",t={k="text",p={"SILPH CO. is very famous. That's why it attracted TEAM ROCKET!"}}},{x=11,y=2,s=42,m="STAY",d="DOWN",t={k="cable"}}},wild=nil,hidden={{x=0,y=4,f="PrintBenchGuyText"},{x=13,y=3,f="OpenPokemonCenterPC"}}}return {id=183,const="MR_PSYCHICS_HOUSE",w=4,h=4,ts=8,border=10,conns={},warps={{2,7,255,8},{3,7,255,8}},signs={},objs={{x=5,y=3,s=39,m="STAY",d="LEFT",t={k="text",p={"...Wait! Don't say a word!","You wanted this!"},s=1}}},wild=nil,hidden={}}return {id=184,const="ROUTE_15_GATE_1F",w=4,h=5,ts=12,border=10,conns={},warps={{0,4,255,1},{0,5,255,2},{7,4,255,3},{7,5,255,4},{6,8,185,1}},signs={},objs={{x=4,y=1,s=49,m="STAY",d="NONE",t={k="text",p={"Are you working on a POKÃ©DEX?","PROF.OAK's AIDE came by here."}}}},wild=nil,hidden={}}return {id=185,const="ROUTE_15_GATE_2F",w=4,h=4,ts=12,border=10,conns={},warps={{7,7,184,5}},signs={{x=6,y=2,t={k="text",p={"Looked into the binoculars.","It looks like a small island!"},s=1}}},objs={{x=4,y=2,s=32,m="STAY",d="DOWN",t={k="text",p={"EXP.ALL gives EXP points to all the POKÃ©MON with you, even if they don't fight.","It does, however, reduce the amount of EXP for each POKÃ©MON.","If you don't need it, you should store it via PC."},s=1}}},wild=nil,hidden={{x=1,y=2,f="Route15GateLeftBinoculars"}}}return {id=186,const="ROUTE_16_GATE_1F",w=4,h=7,ts=12,border=10,conns={},warps={{0,8,255,1},{0,9,255,2},{7,8,255,3},{7,9,255,3},{0,2,255,5},{0,3,255,6},{7,2,255,7},{7,3,255,8},{6,12,187,1}},signs={},objs={{x=4,y=5,s=49,m="STAY",d="DOWN",t={k="text",p={"No pedestrians are allowed on CYCLING ROAD!"},s=1}},{x=4,y=3,s=11,m="STAY",d="NONE",t={k="text",p={"How'd you get in? Good effort!"}}}},wild=nil,hidden={}}return {id=187,const="ROUTE_16_GATE_2F",w=4,h=4,ts=12,border=10,conns={},warps={{7,7,186,9}},signs={{x=1,y=2,t={k="text",p={"Looked into the binoculars.","It's CELADON DEPT. STORE!"},s=1}},{x=6,y=2,t={k="text",p={"Looked into the binoculars.","There's a long path over water!"},s=1}}},objs={{x=4,y=2,s=53,m="STAY",d="NONE",t={k="text",p={"I'm going for a ride with my girl friend!"},s=1}},{x=2,y=5,s=8,m="WALK",d="LEFT_RIGHT",t={k="text",p={"We're going riding together!"},s=1}}},wild=nil,hidden={}}return {id=188,const="ROUTE_16_FLY_HOUSE",w=4,h=4,ts=8,border=10,conns={},warps={{2,7,255,9},{3,7,255,9}},signs={},objs={{x=2,y=3,s=29,m="STAY",d="RIGHT",t={k="text",p={"Oh, you found my secret retreat!","Please don't tell anyone I'm here. I'll make it up to you with this!"},s=1}},{x=6,y=4,s=9,m="WALK",d="ANY_DIR",t={k="text",p={"FEAROW: Kyueen!"},s=1}}},wild=nil,hidden={}}return {id=189,const="ROUTE_12_SUPER_ROD_HOUSE",w=4,h=4,ts=8,border=10,conns={},warps={{2,7,255,4},{3,7,255,4}},signs={},objs={{x=2,y=4,s=39,m="STAY",d="RIGHT",t={k="text",p={"I'm the FISHING GURU's brother!","I simply Looove fishing!","Do you like to fish?"},s=1}}},wild=nil,hidden={}}return {id=19,const="ROUTE_8",w=30,h=9,ts=0,border=44,conns={{"west",10,-4},{"east",4,0}},warps={{1,9,79,1},{1,10,79,2},{8,9,79,3},{8,10,79,4},{13,3,80,1}},signs={{x=17,y=3,t={k="text",p={"UNDERGROUND PATH CELADON CITY - LAVENDER TOWN"}}}},objs={{x=8,y=5,s=12,m="STAY",d="RIGHT",opp={8,3},t={k="trainer",range=4,b={"You look good at POKÃ©MON, but how's your chem?"},e={"Ow! Meltdown!"},a={"I am better at school than this!"}}},{x=13,y=9,s=11,m="STAY",d="UP",opp={17,5},t={k="trainer",range=4,b={"All right! Let's roll the dice!"},e={"Drat! Came up short!"},a={"Lady Luck's not with me today!"}}},{x=42,y=6,s=12,m="STAY",d="UP",opp={8,4},t={k="trainer",range=4,b={"You need strategy to win at this!"},e={"It's not logical!"},a={"Go with GRIMER first...and... ...and...then..."}}},{x=26,y=3,s=6,m="STAY",d="LEFT",opp={3,13},t={k="trainer",range=2,b={"I like NIDORAN, so I collect them!"},e={"Why? Why??"},a={"When POKÃ©MON grow up they get ugly! They shouldn't evolve!"}}},{x=26,y=4,s=12,m="STAY",d="RIGHT",opp={8,5},t={k="trainer",range=3,b={"School is fun, but so are POKÃ©MON."},e={"I'll stay with school."},a={"We're stuck here because of the gates at SAFFRON."}}},{x=26,y=5,s=6,m="STAY",d="LEFT",opp={3,14},t={k="trainer",range=3,b={"MEOWTH is so cute, meow, meow, meow!"},e={"Meow!"},a={"I think PIDGEY and RATTATA are cute too!"}}},{x=26,y=6,s=6,m="STAY",d="RIGHT",opp={3,15},t={k="trainer",range=2,b={"We must look silly standing here like this!"},e={"Look what you did!"},a={"SAFFRON's gate keeper won't let us through. He's so mean!"}}},{x=46,y=13,s=11,m="STAY",d="DOWN",opp={17,7},t={k="trainer",range=2,b={"I'm a rambling, gambling dude!"},e={"Missed the big score!"},a={"Gambling and POKÃ©MON are like eating peanuts! Just can't stop!"}}},{x=51,y=12,s=6,m="STAY",d="LEFT",opp={3,16},t={k="trainer",range=4,b={"What's a cute, round and fluffy POKÃ©MON?"},e={"Stop!","Don't be so mean to my CLEFAIRY!"},a={"I heard that CLEFAIRY evolves when it's exposed to a MOON STONE."}}}},wild={gr=15,g={{18,16},{18,56},{17,23},{16,58},{20,16},{20,56},{19,23},{17,58},{15,58},{18,58}},wr=0,w={}},hidden={}}return {id=190,const="ROUTE_18_GATE_1F",w=4,h=5,ts=12,border=10,conns={},warps={{0,4,255,1},{0,5,255,2},{7,4,255,3},{7,5,255,4},{6,8,191,1}},signs={},objs={{x=4,y=1,s=49,m="STAY",d="DOWN",t={k="text",p={"You need a BICYCLE for CYCLING ROAD!"},s=1}}},wild=nil,hidden={}}return {id=191,const="ROUTE_18_GATE_2F",w=4,h=4,ts=12,border=10,conns={},warps={{7,7,190,5}},signs={{x=1,y=2,t={k="text",p={"Looked into the binoculars.","PALLET TOWN is in the west!"},s=1}},{x=6,y=2,t={k="text",p={"Looked into the binoculars.","There are people swimming!"},s=1}}},objs={{x=4,y=2,s=4,m="WALK",d="LEFT_RIGHT",t={k="trade",nick="MARC"}}},wild=nil,hidden={}}return {id=192,const="SEAFOAM_ISLANDS_1F",w=15,h=9,ts=17,border=125,conns={},warps={{4,17,255,1},{5,17,255,1},{26,17,255,2},{27,17,255,2},{7,5,159,2},{25,3,159,7},{23,15,159,5}},signs={},objs={{x=18,y=10,s=63,m="STAY",d="BOULDER_MOVEMENT_BYTE_2",story=1},{x=26,y=7,s=63,m="STAY",d="BOULDER_MOVEMENT_BYTE_2",story=1}},wild={gr=15,g={{30,86},{30,79},{30,90},{30,116},{28,116},{21,41},{29,42},{28,54},{28,90},{38,55}},wr=0,w={}},hidden={}}return {id=193,const="ROUTE_22_GATE",w=5,h=4,ts=12,border=10,conns={},warps={{4,7,255,1},{5,7,255,1},{4,0,255,1},{5,0,255,2}},signs={},objs={{x=6,y=2,s=49,m="STAY",d="LEFT",t={k="text",p={"Only truly skilled trainers are allowed through.","You don't have the BOULDERBADGE yet!"},s=1}}},wild=nil,hidden={}}return {id=194,const="VICTORY_ROAD_2F",w=15,h=9,ts=17,border=125,conns={},warps={{0,8,108,3},{29,7,255,4},{29,8,255,4},{23,7,198,1},{25,14,198,3},{27,7,198,2},{1,1,198,4}},signs={},objs={{x=12,y=9,s=14,m="STAY",d="LEFT",opp={24,9},t={k="trainer",range=4,b={"VICTORY ROAD is the final test for trainers!"},e={"Aiyah!"},a={"If you get stuck, try moving some boulders around!"}}},{x=21,y=13,s=12,m="STAY",d="LEFT",opp={21,2},t={k="trainer",range=3,b={"Ah, so you wish to challenge the ELITE FOUR?"},e={"You got me!"},a={"BLUE also came through here!"}}},{x=19,y=8,s=7,m="STAY",d="DOWN",opp={22,5},t={k="trainer",range=3,b={"Come on! I'll whip you!"},e={"I got whipped!"},a={"You earned the right to be on VICTORY ROAD!"}}},{x=4,y=2,s=12,m="STAY",d="DOWN",opp={7,6},t={k="trainer",range=1,b={"If you can get through here, you can go meet the ELITE FOUR!"},e={"No! Unbelievable!"},a={"I can beat you when it comes to knowledge about POKÃ©MON!"}}},{x=26,y=3,s=12,m="STAY",d="LEFT",opp={21,5},t={k="trainer",range=3,b={"Is VICTORY ROAD too tough?"},e={"Well done!"},a={"Many trainers give up the challenge here."}}},{x=11,y=5,s=9,m="STAY",d="UP",mon={146,50},t={k="trainer",range=0,b={"Gyaoo!"},e={"Gyaoo!"},a={"Gyaoo!"}},story=1},{x=27,y=5,s=61,m="STAY",d="NONE",item=123,story=1},{x=18,y=9,s=61,m="STAY",d="NONE",item=52,story=1},{x=9,y=11,s=61,m="STAY",d="NONE",item=111,story=1},{x=11,y=0,s=61,m="STAY",d="NONE",item=55,story=1},{x=4,y=14,s=63,m="STAY",d="BOULDER_MOVEMENT_BYTE_2"},{x=5,y=5,s=63,m="STAY",d="BOULDER_MOVEMENT_BYTE_2"},{x=23,y=16,s=63,m="STAY",d="BOULDER_MOVEMENT_BYTE_2",story=1}},wild={gr=10,g={{22,66},{24,74},{26,41},{36,95},{39,95},{42,95},{41,67},{40,42},{40,105},{43,75}},wr=0,w={}},hidden={{x=5,y=2,f="HiddenItems",item=2},{x=26,y=7,f="HiddenItems",item=16}}}return {id=195,const="ROUTE_12_GATE_2F",w=4,h=4,ts=12,border=10,conns={},warps={{7,7,87,5}},signs={{x=1,y=2,t={k="text",p={"Looked into the binoculars.","A man fishing!"},s=1}},{x=6,y=2,t={k="text",p={"Looked into the binoculars.","It's POKÃ©MON TOWER!"},s=1}}},objs={{x=3,y=4,s=29,m="
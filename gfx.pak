onns={},warps={{23,2,200,1},{21,2,135,3},{24,19,203,1},{21,24,200,4},{25,19,203,2}},signs={},objs={{x=26,y=8,s=24,m="STAY",d="LEFT",opp={30,8},t={k="trainer",range=3,b={"Who are you? How did you get here?"},e={"Oww! Beaten!"},a={"Are you dissing TEAM ROCKET?"}}},{x=12,y=6,s=24,m="STAY",d="RIGHT",opp={30,9},t={k="trainer",range=2,b={"You broke into our operation?"},e={"Burnt!"},a={"You're not going to get away with this, brat!"}}},{x=18,y=17,s=24,m="STAY",d="DOWN",opp={30,10},t={k="trainer",range=2,b={"Intruder alert!"},e={"I can't do it!"},a={"SILPH SCOPE? I don't know where it is!"}}},{x=15,y=25,s=24,m="STAY",d="RIGHT",opp={30,11},t={k="trainer",range=3,b={"Why did you come here?"},e={"This won't do!"},a={"OK, I'll talk! Take the elevator to see my BOSS!"}}},{x=28,y=18,s=24,m="STAY",d="LEFT",opp={30,12},t={k="trainer",range=3,b={"Are you lost, you little rat?"},e={"Why...?"},a={"Uh-oh, that fight opened the door!"}}},{x=11,y=14,s=61,m="STAY",d="NONE",item=29,story=1},{x=9,y=17,s=61,m="STAY",d="NONE",item=18,story=1}},wild=nil,hidden={{x=21,y=15,f="HiddenItems",item=79}}}return {id=2,const="PEWTER_CITY",w=20,h=18,ts=0,border=10,conns={{"south",13,5},{"east",14,4}},warps={{14,7,52,1},{19,5,52,3},{16,17,54,1},{29,13,55,1},{23,17,56,1},{7,29,57,1},{13,25,58,1}},signs={{x=19,y=29,t={k="text",p={"TRAINER TIPS","Any POKÃ©MON that takes part in battle, however short, earns EXP!"}}},{x=33,y=19,t={k="text",p={"NOTICE!","Thieves have been stealing POKÃ©MON fossils at MT. MOON! Please call PEWTER POLICE with any info!"}}},{x=24,y=17,t={k="none"}},{x=14,y=25,t={k="none"}},{x=15,y=9,t={k="text",p={"PEWTER MUSEUM OF SCIENCE"}}},{x=11,y=17,t={k="text",p={"PEWTER CITY POKÃ©MON GYM LEADER: BROCK","The Rock Solid POKÃ©MON Trainer!"}}},{x=25,y=23,t={k="text",p={"PEWTER CITY A Stone Gray City"}}}},objs={{x=8,y=15,s=6,m="STAY",d="NONE",t={k="text",p={"It's rumored that CLEFAIRYs came from the moon!","They appeared after MOON STONE fell on MT.MOON."}}},{x=17,y=25,s=7,m="STAY",d="NONE",t={k="text",p={"There aren't many serious POKÃ©MON trainers here!","They're all like BUG CATCHERs, but PEWTER GYM's BROCK is totally into it!"}}},{x=27,y=17,s=12,m="STAY",d="NONE",t={k="text",p={"Did you check out the MUSEUM?"},s=1},story=1},{x=26,y=25,s=12,m="WALK",d="LEFT_RIGHT",t={k="text",p={"Psssst! Do you know what I'm doing?"},s=1}},{x=35,y=16,s=4,m="STAY",d="DOWN",t={k="text",p={"You're a trainer right? BROCK's looking for new challengers! Follow me!"},s=1},story=1}},wild=nil,hidden={}}return {id=20,const="ROUTE_9",w=30,h=9,ts=0,border=44,conns={{"west",3,-4},{"east",21,0}},warps={},signs={{x=25,y=7,t={k="text",p={"ROUTE 9 CERULEAN CITY- ROCK TUNNEL"}}}},objs={{x=13,y=10,s=6,m="STAY",d="LEFT",opp={6,5},t={k="trainer",range=3,b={"You have POKÃ©MON with you! You're mine!"},e={"You deceived me!"},a={"You need light to get through that dark tunnel ahead."}}},{x=24,y=7,s=7,m="STAY",d="LEFT",opp={5,7},t={k="trainer",range=2,b={"Who's that walking with those good looking POKÃ©MON?"},e={"Out like a light!"},a={"Keep walking!"}}},{x=31,y=7,s=7,m="STAY",d="RIGHT",opp={5,8},t={k="trainer",range=4,b={"I'm taking ROCK TUNNEL to go to LAVENDER..."},e={"Can't measure up!"},a={"Are you off to ROCK TUNNEL too?"}}},{x=48,y=8,s=6,m="STAY",d="RIGHT",opp={6,6},t={k="trainer",range=2,b={"Don't you dare condescend me!"},e={"No! You're too much!"},a={"You're obviously talented! Good luck to you!"}}},{x=16,y=15,s=14,m="STAY",d="LEFT",opp={9,11},t={k="trainer",range=2,b={"Bwahaha! Great! I was bored, eh!"},e={"Keep it coming, eh!","Oh wait. I'm out of POKÃ©MON!"},a={"You sure had guts standing up to me there, eh?"}}},{x=43,y=3,s=14,m="STAY",d="LEFT",opp={9,6},t={k="trainer",range=3,b={"Hahaha! Aren't you a little toughie!"},e={"What's that?"},a={"Hahaha! Kids should be tough!"}}},{x=22,y=2,s=4,m="STAY",d="DOWN",opp={2,13},t={k="trainer",range=4,b={"I got up early every day to raise my POKÃ©MON from cocoons!"},e={"WHAT?","What a total waste of time!"},a={"I have to collect more than bugs to get stronger..."}}},{x=45,y=15,s=14,m="STAY",d="RIGHT",opp={9,5},t={k="trainer",range=2,b={"Hahahaha! Come on, dude!"},e={"Hahahaha! You beat me fair!"},a={"Hahahaha! Us hearty guys always laugh!"}}},{x=40,y=8,s=4,m="STAY",d="RIGHT",opp={2,14}},{x=10,y=15,s=61,m="STAY",d="NONE",item=136,story=1}},wild={gr=15,g={{16,19},{16,21},{14,19},{11,23},{13,21},{15,23},{17,19},{17,21},{13,23},{17,23}},wr=0,w={}},hidden={{x=14,y=7,f="HiddenItems",item=80}}}return {id=200,const="ROCKET_HIDEOUT_B2F",w=15,h=14,ts=22,border=46,conns={},warps={{27,8,199,1},{21,8,201,1},{24,19,203,1},{21,22,199,4},{25,19,203,2}},signs={},objs={{x=20,y=12,s=24,m="STAY",d="DOWN",opp={30,13},t={k="trainer",range=4,b={"BOSS said you can see GHOSTs with the SILPH SCOPE!"},e={"I surrender!"},a={"The TEAM ROCKET HQ has 4 basement floors. Can you reach the BOSS?"}}},{x=1,y=11,s=61,m="STAY",d="NONE",item=10,story=1},{x=16,y=8,s=61,m="STAY",d="NONE",item=49,story=1},{x=6,y=12,s=61,m="STAY",d="NONE",item=113,story=1},{x=3,y=21,s=61,m="STAY",d="NONE",item=19,story=1}},wild=nil,hidden={}}return {id=201,const="ROCKET_HIDEOUT_B3F",w=15,h=14,ts=22,border=46,conns={},warps={{25,6,200,2},{19,18,202,1}},signs={},objs={{x=10,y=22,s=24,m="STAY",d="RIGHT",opp={30,14},t={k="trainer",range=2,b={"Stop meddling in TEAM ROCKET's affairs!"},e={"Oof! Taken down!"},a={"SILPH SCOPE? The machine the BOSS stole. It's here somewhere."}}},{x=26,y=12,s=24,m="STAY",d="UP",opp={30,15},t={k="trainer",range=4,b={"We got word from upstairs that you were coming!"},e={"What? I lost? No!"},a={"Go ahead and go! But, you need the LIFT KEY to run the elevator!"}}},{x=26,y=17,s=61,m="STAY",d="NONE",item=116,story=1},{x=20,y=14,s=61,m="STAY",d="NONE",item=40,story=1}},wild=nil,hidden={{x=27,y=17,f="HiddenItems",item=49}}}return {id=202,const="ROCKET_HIDEOUT_B4F",w=15,h=12,ts=22,border=46,conns={},warps={{19,10,201,2},{24,15,203,1},{25,15,203,2}},signs={},objs={{x=25,y=3,s=23,m="STAY",d="DOWN",opp={29,1},t={k="text",p={"So! I must say, I am impressed you got here!"},s=1},story=1},{x=23,y=12,s=24,m="STAY",d="DOWN",opp={30,16},t={k="trainer",range=0,b={"I know you! You ruined our plans at MT.MOON!"},e={"Burned again!"},a={"Do you have something against TEAM ROCKET?"}}},{x=26,y=12,s=24,m="STAY",d="DOWN",opp={30,17},t={k="trainer",range=0,b={"How can you not see the beauty of our evil?"},e={"Ayaya!"},a={"BOSS! I'm sorry I failed you!"}}},{x=11,y=2,s=24,m="STAY",d="DOWN",opp={30,18},t={k="trainer",range=1,b={"The elevator doesn't work? Who has the LIFT KEY?"},e={"No!"},a={"Oh no! I dropped the LIFT KEY!"}}},{x=10,y=12,s=61,m="STAY",d="NONE",item=35,story=1},{x=9,y=4,s=61,m="STAY",d="NONE",item=108,story=1},{x=12,y=20,s=61,m="STAY",d="NONE",item=37,story=1},{x=25,y=2,s=61,m="STAY",d="NONE",item=72,hide=1},{x=10,y=2,s=61,m="STAY",d="NONE",item=74,hide=1}},wild=nil,hidden={{x=25,y=1,f="HiddenItems",item=19}}}return {id=203,const="ROCKET_HIDEOUT_ELEVATOR",w=3,h=4,ts=18,border=15,conns={},warps={{2,1,199,3},{3,1,199,5}},signs={{x=1,y=1,t={k="text",p={"It appears to need a key."},s=1}}},objs={},wild=nil,hidden={}}return {id=207,const="SILPH_CO_2F",w=15,h=9,ts=22,border=46,conns={},warps={{24,0,181,3},{26,0,208,1},{20,0,236,1},{3,3,208,7},{13,3,213,5},{27,15,213,6},{9,15,211,5}},signs={},objs={{x=10,y=1,s=27,m="STAY",d="UP",t={k="text",p={"Eeek! No! Stop! Help!","Oh, you're not with TEAM ROCKET. I thought... I'm sorry. Here, please take this!"},s=1},story=1},{x=5,y=12,s=32,m="STAY",d="DOWN",opp={28,2},t={k="trainer",range=3,b={"Help! I'm a SILPH employee."},e={"How did you know I was a ROCKET?"},a={"I work for both SILPH and TEAM ROCKET!"}},story=1},{x=24,y=13,s=32,m="STAY",d="LEFT",opp={28,3},t={k="trainer",range=4,b={"It's off limits here! Go home!"},e={"You're good."},a={"Can you solve the maze in here?"}},story=1},{x=16,y=11,s=24,m="STAY",d="UP",opp={30,23},t={k="trainer",range=3,b={"No kids are allowed in here!"},e={"Tough!"},a={"Diamond shaped tiles are teleport blocks!","They're hi-tech transporters!"}},story=1},{x=24,y=7,s=24,m="STAY",d="UP",opp={30,24},t={k="trainer",range=3,b={"Hey kid! What are you doing here?"},e={"I goofed!"},a={"SILPH CO. will be merged with TEAM ROCKET!"}},story=1}},wild=nil,hidden={}}return {id=208,const="SILPH_CO_3F",w=15,h=9,ts=22,border=46,conns={},warps={{26,0,207,2},{24,0,209,1},{20,0,236,1},{23,11,208,10},{3,3,210,6},{3,15,210,7},{27,3,207,4},{3,11,233,4},{11,11,212,5},{27,15,208,4}},signs={},objs={{x=24,y=8,s=44,m="STAY",d="NONE",t={k="text",p={"I work for SILPH. What should I do?"},s=1}},{x=20,y=7,s=24,m="STAY",d="LEFT",opp={30,25},t={k="trainer",range=2,b={"Quit messing with us, kid!"},e={"I give up!"},a={"A hint? You can open doors with a CARD KEY!"}},story=1},{x=7,y=9,s=32,m="STAY",d="DOWN",opp={28,4},t={k="trainer",range=3,b={"I support TEAM ROCKET more than I support SILPH!"},e={"You really got me!"},a={"Humph...","TEAM ROCKET said that if I helped them, they'd let me study POKÃ©MON!"}},story=1},{x=8,y=5,s=61,m="STAY",d="NONE",item=18,story=1}},wild=nil,hidden={}}return {id=209,const="SILPH_CO_4F",w=15,h=9,ts=22,border=46,conns={},warps={{24,0,208,2},{26,0,210,2},{20,0,236,1},{11,7,234,4},{17,3,211,4},{3,15,234,5},{17,11,234,6}},signs={},objs={{x=6,y=2,s=44,m="STAY",d="NONE",t={k="text",p={"Sssh! Can't you see I'm hiding?"},s=1}},{x=9,y=14,s=24,m="STAY",d="RIGHT",opp={30,26},t={k="trainer",range=4,b={"TEAM ROCKET has taken command of SILPH CO.!"},e={"Arrgh!"},a={"Fwahahaha! My BOSS has been after this place!"}},story=1},{x=14,y=6,s=32,m="STAY",d="LEFT",opp={28,5},t={k="trainer",range=3,b={"My POKÃ©MON are my loyal soldiers!"},e={"Darn! You weak POKÃ©MON!"},a={"The doors are electronically locked! A CARD KEY opens them!"}},story=1},{x=26,y=10,s=24,m="STAY",d="UP",opp={30,27},t={k="trainer",range=4,b={"Intruder spotted!"},e={"Who are you?"},a={"I better tell the BOSS on 11F!"}},story=1},{x=3,y=9,s=61,m="STAY",d="NONE",item=52,story=1},{x=4,y=7,s=61,m="STAY",d="NONE",item=54,story=1},{x=5,y=8,s=61,m="STAY",d="NONE",item=29,story=1}},wi
=44,m="STAY",d="UP",t={k="text",p={"They must have targeted SILPH for our POKÃ©MON products."},s=1}},{x=17,y=3,s=24,m="STAY",d="RIGHT",opp={30,30},t={k="trainer",range=2,b={"I am one of the 4 ROCKET BROTHERS!"},e={"Flame out!"},a={"No matter! My brothers will avenge me!"}},story=1},{x=7,y=8,s=32,m="STAY",d="DOWN",opp={28,7},t={k="trainer",range=3,b={"That rotten PRESIDENT!","He shouldn't have sent me to the TIKSI BRANCH!"},e={"Shoot!"},a={"TIKSI BRANCH? It's in Russian no man's land!"}},story=1},{x=14,y=15,s=24,m="STAY",d="LEFT",opp={30,31},t={k="trainer",range=2,b={"You dare betray TEAM ROCKET?"},e={"You traitor!"},a={"If you stand for justice, you betray evil!"}},story=1},{x=3,y=12,s=61,m="STAY",d="NONE",item=35,story=1},{x=2,y=15,s=61,m="STAY",d="NONE",item=46,story=1}},wild=nil,hidden={}}return {id=212,const="SILPH_CO_7F",w=13,h=9,ts=22,border=46,conns={},warps={{16,0,213,2},{22,0,211,1},{18,0,236,1},{5,7,235,4},{5,3,208,9},{21,15,210,4}},signs={},objs={{x=1,y=5,s=44,m="STAY",d="NONE",t={k="text",p={"Oh! Hi! You're not a ROCKET! You came to save us? Why, thank you!","I want you to have this POKÃ©MON for saving us."},s=1}},{x=13,y=13,s=44,m="STAY",d="UP",t={k="text",p={"TEAM ROCKET was after the MASTER BALL which will catch any POKÃ©MON!"},s=1}},{x=7,y=10,s=44,m="STAY",d="NONE",t={k="text",p={"It would be bad if TEAM ROCKET took over SILPH or our POKÃ©MON!"},s=1}},{x=10,y=8,s=27,m="STAY",d="NONE",t={k="text",p={"You! It's really dangerous here! You came to save me? You can't!"},s=1}},{x=13,y=1,s=24,m="STAY",d="DOWN",opp={30,32},t={k="trainer",range=2,b={"Oh ho! I smell a little rat!"},e={"Lights out!"},a={"You won't find my BOSS by just scurrying around!"}},story=1},{x=2,y=13,s=32,m="STAY",d="DOWN",opp={28,8},t={k="trainer",range=3,b={"Heheh!","You mistook me for a SILPH worker?"},e={"I'm done!"},a={"Despite your age, you are a skilled trainer!"}},story=1},{x=20,y=2,s=24,m="STAY",d="LEFT",opp={30,33},t={k="trainer",range=3,b={"I am one of the 4 ROCKET BROTHERS!"},e={"Aack! Brothers, I lost!"},a={"Doesn't matter. My brothers will repay the favor!"}},story=1},{x=19,y=14,s=24,m="STAY",d="RIGHT",opp={30,34},t={k="trainer",range=4,b={"A child intruder? That must be you!"},e={"Fine! I lost!"},a={"Go on home before my BOSS gets ticked off!"}},story=1},{x=3,y=7,s=2,m="STAY",d="UP",t={k="text",p={"BLUE: What kept you RED?"},s=1},story=1},{x=1,y=9,s=61,m="STAY",d="NONE",item=39,story=1},{x=24,y=11,s=61,m="STAY",d="NONE",item=109,story=1}},wild=nil,hidden={}}return {id=213,const="SILPH_CO_8F",w=13,h=9,ts=22,border=46,conns={},warps={{16,0,233,2},{14,0,212,1},{18,0,236,1},{3,11,213,7},{3,15,207,5},{11,5,207,6},{11,9,213,4}},signs={},objs={{x=4,y=2,s=44,m="STAY",d="NONE",t={k="text",p={"I wonder if SILPH is finished..."},s=1}},{x=19,y=2,s=24,m="STAY",d="LEFT",opp={30,35},t={k="trainer",range=4,b={"That's as far as you'll go!"},e={"Not enough grit!"},a={"If you don't turn back, I'll call for backup!"}},story=1},{x=10,y=2,s=32,m="STAY",d="DOWN",opp={28,9},t={k="trainer",range=4,b={"You're causing us problems!"},e={"Huh? I lost?"},a={"So, what do you think of SILPH BUILDING's maze?"}},story=1},{x=12,y=15,s=24,m="STAY",d="RIGHT",opp={30,36},t={k="trainer",range=4,b={"I am one of the 4 ROCKET BROTHERS!"},e={"Whoo! Oh brothers!"},a={"I'll leave you up to my brothers!"}},story=1}},wild=nil,hidden={}}return {id=214,const="POKEMON_MANSION_2F",w=15,h=14,ts=22,border=1,conns={},warps={{5,10,165,5},{7,10,215,1},{25,14,215,3},{6,1,215,2}},signs={},objs={{x=3,y=17,s=12,m="WALK",d="LEFT_RIGHT",opp={11,7},t={k="trainer",range=0,b={"I can't get out! This old place is one big puzzle!"},e={"Oh no! My bag of loot!"},a={"Switches open and close alternating sets of doors!"}}},{x=28,y=7,s=61,m="STAY",d="NONE",item=39,story=1},{x=18,y=2,s=65,m="STAY",d="NONE",t={k="text",p={"Diary: July 5 Guyana, South America","A new POKÃ©MON was discovered deep in the jungle."}}},{x=3,y=22,s=65,m="STAY",d="NONE",t={k="text",p={"Diary: July 10 We christened the newly discovered POKÃ©MON, MEW."}}}},wild={gr=10,g={{32,58},{34,109},{34,109},{30,77},{30,109},{32,77},{30,88},{28,77},{39,110},{37,89}},wr=0,w={}},hidden={{x=2,y=11,f="Mansion2Script_Switches"}}}return {id=215,const="POKEMON_MANSION_3F",w=15,h=9,ts=22,border=1,conns={},warps={{7,10,214,2},{6,1,214,4},{25,14,214,3}},signs={},objs={{x=5,y=11,s=12,m="WALK",d="LEFT_RIGHT",opp={11,8},t={k="trainer",range=0,b={"This place is like, huge!"},e={"Ayah!"},a={"I wonder where my partner went."}}},{x=20,y=11,s=32,m="STAY",d="LEFT",opp={28,12},t={k="trainer",range=2,b={"My mentor once lived here."},e={"Whew! Overwhelming!"},a={"So, you're stuck? Try jumping off over there!"}}},{x=1,y=16,s=61,m="STAY",d="NONE",item=17,story=1},{x=25,y=5,s=61,m="STAY",d="NONE",item=37,story=1},{x=6,y=12,s=65,m="STAY",d="NONE",t={k="text",p={"Diary: Feb. 6 MEW gave birth.","We named the newborn MEWTWO."}}}},wild={gr=10,g={{31,109},{33,58},{35,109},{32,77},{34,77},{40,110},{34,88},{38,110},{36,77},{42,89}},wr=0,w={}},hidden={{x=1,y=9,f="HiddenItems",item=54},{x=10,y=5,f="Mansion3Script_Switches"}}}return {id=216,const="POKEMON_MANSION_B1F",w=15,h=14,ts=22,border=1,conns={},warps={{23,22,165,6}},signs={},objs={{x=16,y=23,s=12,m="STAY",d="NONE",opp={11,9},t={k="trainer",range=0,b={"Uh-oh. Where am I now?"},e={"Awooh!"},a={"You can find stuff lying around."}}},{x=27,y=11,s=32,m="STAY",d="DOWN",opp={28,13},t={k="trainer",range=3,b={"This place is ideal for a lab."},e={"What was that for?"},a={"I like it here! It's conducive to my studies!"}}},{x=10,y=2,s=61,m="STAY",d="NONE",item=40,story=1},{x=1,y=22,s=61,m="STAY",d="NONE",item=16,story=1},{x=19,y=25,s=61,m="STAY",d="NONE",item=120,story=1},{x=5,y=4,s=61,m="STAY",d="NONE",item=128,story=1},{x=16,y=20,s=65,m="STAY",d="NONE",t={k="text",p={"Diary; Sept. 1 MEWTWO is far too powerful.","We have failed to curb its vicious tendencies..."}}},{x=5,y=13,s=61,m="STAY",d="NONE",item=43,story=1}},wild={gr=10,g={{33,109},{31,109},{35,58},{32,77},{31,109},{40,110},{34,77},{35,88},